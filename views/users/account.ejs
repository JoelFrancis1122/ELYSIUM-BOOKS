<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>My Account — BOOKSAW</title>
    <meta name="description" content="Manage your BOOKSAW profile, orders, wallet, and addresses.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
/* ── BOOKSAW ACCOUNT — WARM LITERARY SYSTEM ──────────────── */
:root{
  --canvas:#f5f0e8; --bg:#faf8f4; --fg:#2d2820;
  --hi:#b8542a; --hi2:#d4673a; --muted:#7a6f60;
  --border:#ddd8ce; --sec:#edeae2; --card:#fff;
  --green:#2d6a4f; --red:#b91c1c;
  --r-sm:8px; --r-md:14px; --r-lg:20px;
  --sh-sm:0 2px 8px rgba(45,40,32,.06);
  --sh-md:0 8px 24px rgba(45,40,32,.09);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'IBM Plex Sans',sans-serif;background:var(--canvas);color:var(--fg)}

/* ── BREADCRUMB */
.bk-crumb{background:var(--bg);border-bottom:1px solid var(--border);padding:14px 0}
.bk-crumb-inner{max-width:1200px;margin:0 auto;padding:0 40px;display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--muted)}
.bk-crumb-inner a{color:var(--muted);text-decoration:none;transition:color .2s}
.bk-crumb-inner a:hover{color:var(--hi)}
.bk-crumb-sep{color:var(--border);font-size:.68rem}
.bk-crumb-cur{color:var(--fg);font-weight:600}

/* ── LAYOUT */
.bk-account{max-width:1200px;margin:0 auto;padding:36px 40px 80px;display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:start}

/* ── HERO CARD */
.bk-hero{background:var(--fg);border-radius:var(--r-lg);padding:28px;margin-bottom:28px;grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.bk-hero-left{display:flex;align-items:center;gap:18px}
.bk-avatar{width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-family:'Libre Baskerville',serif;font-size:1.5rem;font-weight:700;color:#fff;flex-shrink:0}
.bk-hero-name{font-family:'Libre Baskerville',serif;font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:4px}
.bk-hero-email{font-size:.82rem;color:rgba(255,255,255,.5)}
.bk-hero-stats{display:flex;gap:12px;flex-wrap:wrap}
.bk-stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:12px 20px;text-align:center;min-width:90px;cursor:default;transition:background .2s}
.bk-stat:hover{background:rgba(255,255,255,.12)}
.bk-stat-n{display:block;font-family:'Libre Baskerville',serif;font-size:1.2rem;font-weight:700;color:#fff}
.bk-stat-l{display:block;font-size:.68rem;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-top:2px}

/* ── SIDEBAR NAV */
.bk-sidebar{position:sticky;top:90px}
.bk-sidebar-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden}
.bk-nav-item{display:block;width:100%;text-align:left;border:none;background:none;cursor:pointer;display:flex;align-items:center;gap:11px;padding:12px 18px;font-family:'IBM Plex Sans',sans-serif;font-size:.875rem;font-weight:500;color:var(--muted);text-decoration:none;transition:background .15s,color .15s;border-radius:0;position:relative}
.bk-nav-item:hover{background:rgba(184,84,42,.06);color:var(--fg)}
.bk-nav-item.active{background:rgba(184,84,42,.08);color:var(--hi);font-weight:600}
.bk-nav-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--hi);border-radius:0 2px 2px 0}
.bk-nav-item i{width:17px;text-align:center;font-size:.82rem;color:var(--muted);transition:color .15s;flex-shrink:0}
.bk-nav-item:hover i,.bk-nav-item.active i{color:var(--hi)}
.bk-nav-divider{height:1px;background:var(--border);margin:6px 0}
.bk-nav-logout{color:var(--red) !important}
.bk-nav-logout i{color:var(--red) !important}
.bk-nav-logout:hover{background:rgba(185,28,28,.06) !important}

/* ── MAIN PANELS */
.bk-main{}
.bk-panel{display:none}
.bk-panel.active{display:block}

.bk-panel-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;margin-bottom:20px}
.bk-panel-head{padding:18px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.bk-panel-title{font-family:'Libre Baskerville',serif;font-size:1.05rem;font-weight:700;color:var(--fg);display:flex;align-items:center;gap:10px}
.bk-panel-title i{font-size:.9rem;color:var(--hi)}
.bk-panel-body{padding:24px}

/* ── FORM ELEMENTS */
.bk-field-group{margin-bottom:18px}
.bk-label{display:block;font-size:.78rem;font-weight:600;letter-spacing:.4px;color:var(--muted);margin-bottom:6px;text-transform:uppercase}
.bk-input{width:100%;background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:10px 14px;font-family:'IBM Plex Sans',sans-serif;font-size:.88rem;color:var(--fg);outline:none;transition:border-color .2s,box-shadow .2s}
.bk-input:focus{border-color:var(--hi);box-shadow:0 0 0 3px rgba(184,84,42,.08)}
.bk-input[readonly]{background:var(--sec);color:var(--muted);cursor:not-allowed}
.bk-input::placeholder{color:var(--muted)}

/* ── BUTTONS */
.bk-btn{display:inline-flex;align-items:center;gap:7px;padding:9px 20px;font-family:'IBM Plex Sans',sans-serif;font-size:.84rem;font-weight:600;border-radius:var(--r-sm);text-decoration:none;cursor:pointer;transition:all .18s;border:1.5px solid transparent;white-space:nowrap}
.bk-btn-dark{background:var(--fg);color:#fff;border-color:var(--fg)}
.bk-btn-dark:hover{background:var(--hi);border-color:var(--hi)}
.bk-btn-outline{background:none;color:var(--fg);border-color:var(--border)}
.bk-btn-outline:hover{border-color:var(--hi);color:var(--hi)}
.bk-btn-danger{background:none;color:var(--red);border-color:rgba(185,28,28,.25)}
.bk-btn-danger:hover{background:rgba(185,28,28,.06);border-color:var(--red)}
.bk-btn-sm{padding:6px 14px;font-size:.78rem}
.bk-btn-full{width:100%;justify-content:center}

/* ── GRID HELPERS */
.bk-row{display:grid;gap:16px}
.bk-row-2{grid-template-columns:repeat(2,1fr)}
.bk-row-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:640px){.bk-row-2,.bk-row-3{grid-template-columns:1fr}}

/* ── INFO DISPLAY ROW */
.bk-info-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}

/* ── REFERRAL BOX */
.bk-referral{background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-md);padding:22px;margin-top:20px}
.bk-referral-head{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.bk-referral-title{font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg)}
.bk-referral-sub{font-size:.82rem;color:var(--muted);margin-bottom:16px;line-height:1.5}
.bk-referral-code-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.bk-code-box{display:flex;align-items:center;gap:10px;background:var(--bg);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 16px}
.bk-code-text{font-family:'IBM Plex Sans',sans-serif;font-size:1rem;font-weight:700;letter-spacing:1.5px;color:var(--fg)}
.bk-apply-row{display:flex;gap:10px;margin-top:14px;max-width:360px}
.bk-apply-row .bk-input{flex:1}

/* ── ORDERS TABLE */
.bk-table-wrap{overflow-x:auto;border-radius:var(--r-md);border:1px solid var(--border)}
.bk-table{width:100%;border-collapse:collapse;font-size:.84rem}
.bk-table th{background:var(--sec);color:var(--muted);font-weight:600;font-size:.73rem;letter-spacing:.8px;text-transform:uppercase;padding:11px 14px;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap}
.bk-table td{padding:13px 14px;border-bottom:1px solid var(--border);color:var(--fg);vertical-align:middle}
.bk-table tbody tr:last-child td{border-bottom:none}
.bk-table tbody tr:hover{background:rgba(245,240,232,.5)}
.bk-oid{font-family:'IBM Plex Sans',sans-serif;font-weight:700;font-size:.82rem;color:var(--fg)}

/* Status pills */
.bk-pill{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:.71rem;font-weight:700;letter-spacing:.4px;text-transform:uppercase}
.bk-pill::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}
.bk-pill-pend{background:rgba(180,135,20,.1);color:#b48714}
.bk-pill-ship{background:rgba(37,99,235,.1);color:#2563eb}
.bk-pill-del{background:rgba(22,163,74,.1);color:#16a34a}
.bk-pill-can{background:rgba(185,28,28,.1);color:#b91c1c}
.bk-pill-ret{background:rgba(107,114,128,.1);color:#6b7280}
.bk-pill-recv{background:rgba(22,163,74,.1);color:#16a34a}
.bk-pill-fail{background:rgba(185,28,28,.1);color:#b91c1c}
.bk-pill-ref{background:rgba(37,99,235,.1);color:#2563eb}
.bk-pill-pend-pay{background:rgba(180,135,20,.1);color:#b48714}

/* Pagination */
.bk-pagination{display:flex;align-items:center;gap:6px;margin-top:20px;justify-content:center}
.bk-page-btn{min-width:36px;height:36px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg);color:var(--fg);font-family:'IBM Plex Sans',sans-serif;font-size:.82rem;font-weight:500;display:flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer;padding:0 10px;transition:all .18s}
.bk-page-btn:hover{border-color:var(--hi);color:var(--hi)}
.bk-page-btn.active{background:var(--fg);color:#fff;border-color:var(--fg)}
.bk-page-btn.disabled{opacity:.4;pointer-events:none}

/* ── ADDRESS CARDS */
.bk-address-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.bk-address-card{background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-md);padding:18px;transition:border-color .2s,box-shadow .2s;position:relative}
.bk-address-card:hover{border-color:var(--hi);box-shadow:0 4px 16px rgba(184,84,42,.08)}
.bk-address-num{font-size:.65rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--hi);margin-bottom:8px;display:block}
.bk-address-name{font-family:'Libre Baskerville',serif;font-size:.92rem;font-weight:700;color:var(--fg);margin-bottom:4px}
.bk-address-phone{font-size:.8rem;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:5px}
.bk-address-text{font-size:.82rem;color:var(--fg);line-height:1.6}
.bk-address-actions{display:flex;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border)}

/* Inline address form */
.bk-addr-form{background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-md);padding:22px;margin-bottom:24px;display:none}
.bk-addr-form-title{font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg);margin-bottom:18px;display:flex;align-items:center;gap:8px}

/* ── WALLET */
.bk-wallet-card{background:var(--fg);border-radius:var(--r-lg);padding:28px;margin-bottom:20px}
.bk-wallet-label{font-size:.72rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:8px}
.bk-wallet-amount{font-family:'Libre Baskerville',serif;font-size:2.5rem;font-weight:700;color:#fff;margin-bottom:4px}
.bk-wallet-sub{font-size:.8rem;color:rgba(255,255,255,.45)}
.bk-wallet-topup{background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-md);padding:20px}
.bk-wallet-topup-title{font-family:'Libre Baskerville',serif;font-size:.92rem;font-weight:700;color:var(--fg);margin-bottom:14px;display:flex;align-items:center;gap:8px}

/* Transaction list */
.bk-tx-list{border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;max-height:360px;overflow-y:auto}
.bk-tx-item{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--border);font-size:.84rem;gap:12px}
.bk-tx-item:last-child{border-bottom:none}
.bk-tx-item:hover{background:rgba(245,240,232,.5)}
.bk-tx-date{color:var(--muted);font-size:.78rem;min-width:80px}
.bk-tx-desc{flex:1;color:var(--fg)}
.bk-tx-amt{font-weight:700;white-space:nowrap}
.bk-tx-credit{color:var(--green)}
.bk-tx-debit{color:var(--red)}
.bk-tx-type{display:inline-flex;align-items:center;font-size:.66rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:2px 8px;border-radius:999px}
.bk-tx-type.credit{background:rgba(22,163,74,.1);color:#16a34a}
.bk-tx-type.debit{background:rgba(185,28,28,.1);color:#b91c1c}

/* ── COUPONS */
.bk-coupon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
.bk-coupon-card{background:var(--bg);border:1.5px solid var(--border);border-radius:var(--r-md);overflow:hidden;position:relative}
.bk-coupon-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--hi)}
.bk-coupon-top{padding:16px 18px 12px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.bk-coupon-discount{font-family:'Libre Baskerville',serif;font-size:1.5rem;font-weight:700;color:var(--hi)}
.bk-coupon-discount span{font-size:.75rem;color:var(--muted);margin-left:3px}
.bk-coupon-expiry{font-size:.72rem;color:var(--muted);text-align:right}
.bk-coupon-body{padding:12px 18px}
.bk-coupon-name{font-weight:700;font-size:.9rem;color:var(--fg);margin-bottom:4px}
.bk-coupon-desc{font-size:.78rem;color:var(--muted);margin-bottom:12px}
.bk-coupon-code-row{display:flex;align-items:center;justify-content:space-between;background:var(--canvas);border:1px solid var(--border);border-radius:var(--r-sm);padding:8px 12px}
.bk-coupon-code{font-family:'IBM Plex Sans',sans-serif;font-weight:700;font-size:.9rem;letter-spacing:1.5px;color:var(--fg)}

/* ── EMPTY STATES */
.bk-empty{text-align:center;padding:60px 20px}
.bk-empty-icon{font-size:2.8rem;opacity:.25;margin-bottom:14px}
.bk-empty-title{font-family:'Libre Baskerville',serif;font-size:1.1rem;color:var(--fg);margin-bottom:6px}
.bk-empty-sub{font-size:.84rem;color:var(--muted);margin-bottom:20px}

/* ── SECTION DIVIDER */
.bk-section-title{font-family:'Libre Baskerville',serif;font-size:.92rem;font-weight:700;color:var(--fg);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.bk-section-title::after{content:'';flex:1;height:1px;background:var(--border)}

/* ── RESPONSIVE */
@media(max-width:900px){
  .bk-account{grid-template-columns:1fr;gap:20px;padding:24px 20px 60px}
  .bk-sidebar{position:static}
  .bk-sidebar-card{display:grid;grid-template-columns:repeat(3,1fr)}
  .bk-nav-item::before{display:none}
  .bk-hero{flex-direction:column;align-items:flex-start}
  .bk-hero-stats{width:100%;justify-content:flex-start}
}
@media(max-width:600px){
  .bk-crumb-inner{padding:0 16px}
  .bk-sidebar-card{grid-template-columns:repeat(2,1fr)}
  .bk-hero-stats .bk-stat{flex:1}
  .bk-info-row{grid-template-columns:1fr}
}
</style>
</head>

<body>
<%
  const safeName       = (typeof name !== 'undefined' && name) ? name : 'Reader';
  const safeEmail      = (typeof email !== 'undefined' && email) ? email : '';
  const safeOrders     = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [];
  const safeAddresses  = (typeof addresses !== 'undefined' && Array.isArray(addresses)) ? addresses : [];
  const safeWallet     = (typeof wallet !== 'undefined' && wallet) ? wallet : { balance: 0, history: [] };
  const safeCoupons    = (typeof coupons !== 'undefined' && Array.isArray(coupons)) ? coupons : [];
  const safeUserData   = (typeof userData !== 'undefined' && userData) ? userData : {};
  const safePage       = (typeof page !== 'undefined') ? page : 1;
  const safeTotalPages = (typeof totalPages !== 'undefined') ? totalPages : 1;
%>

<%- include('../partials/userHeader') %>

<!-- Breadcrumb -->
<div class="bk-crumb">
  <div class="bk-crumb-inner">
    <a href="/home">Home</a>
    <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:.65rem"></i></span>
    <span class="bk-crumb-cur">My Account</span>
  </div>
</div>

<div class="bk-account">

  <!-- ── HERO ───────────────────────── -->
  <div class="bk-hero">
    <div class="bk-hero-left">
      <div class="bk-avatar"><%= safeName.charAt(0).toUpperCase() %></div>
      <div>
        <div class="bk-hero-name"><%= safeName %></div>
        <div class="bk-hero-email"><%= safeEmail %></div>
      </div>
    </div>
    <div class="bk-hero-stats">
      <div class="bk-stat"><span class="bk-stat-n"><%= safeOrders.length %></span><span class="bk-stat-l">Orders</span></div>
      <div class="bk-stat"><span class="bk-stat-n">&#8377;<%= (safeWallet && typeof safeWallet.balance === 'number') ? safeWallet.balance.toFixed(0) : '0' %></span><span class="bk-stat-l">Wallet</span></div>
      <div class="bk-stat"><span class="bk-stat-n"><%= safeAddresses.length %></span><span class="bk-stat-l">Addresses</span></div>
      <div class="bk-stat"><span class="bk-stat-n"><%= safeCoupons.length %></span><span class="bk-stat-l">Coupons</span></div>
    </div>
  </div>

  <!-- ── SIDEBAR ────────────────────── -->
  <aside class="bk-sidebar">
    <div class="bk-sidebar-card">
      <button class="bk-nav-item active" onclick="showTab('dashboard',this)" id="tab-btn-dashboard">
        <i class="fas fa-th-large"></i> Dashboard
      </button>
      <button class="bk-nav-item" onclick="showTab('orders',this)" id="tab-btn-orders">
        <i class="fas fa-shopping-bag"></i> My Orders
      </button>
      <button class="bk-nav-item" onclick="showTab('address',this)" id="tab-btn-address">
        <i class="fas fa-map-marker-alt"></i> Addresses
      </button>
      <button class="bk-nav-item" onclick="showTab('wallet',this)" id="tab-btn-wallet">
        <i class="fas fa-wallet"></i> Wallet
      </button>
      <button class="bk-nav-item" onclick="showTab('coupons',this)" id="tab-btn-coupons">
        <i class="fas fa-tags"></i> Coupons
      </button>
      <button class="bk-nav-item" onclick="showTab('settings',this)" id="tab-btn-settings">
        <i class="fas fa-user-cog"></i> Settings
      </button>
      <div class="bk-nav-divider"></div>
      <a href="/logout" class="bk-nav-item bk-nav-logout">
        <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
      </a>
    </div>
  </aside>

  <!-- ── MAIN PANELS ────────────────── -->
  <div class="bk-main">

    <!-- ─── 1. DASHBOARD ─── -->
    <div class="bk-panel active" id="panel-dashboard">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-th-large"></i> Welcome back, <%= safeName %>!</div>
        </div>
        <div class="bk-panel-body">
          <p style="font-size:.88rem;color:var(--muted);margin-bottom:22px;line-height:1.6">
            From your personal BOOKSAW account hub, track active shipments, manage saved addresses, top up your wallet, and view reader discounts.
          </p>

          <div class="bk-info-row">
            <div class="bk-field-group">
              <label class="bk-label">Account Name</label>
              <input type="text" class="bk-input" value="<%= safeName %>" readonly>
            </div>
            <div class="bk-field-group">
              <label class="bk-label">Email Address</label>
              <input type="email" class="bk-input" value="<%= safeEmail %>" readonly>
            </div>
          </div>

          <!-- Referral -->
          <div class="bk-referral">
            <div class="bk-referral-head">
              <i class="fas fa-gift" style="color:var(--hi);font-size:1rem"></i>
              <span class="bk-referral-title">Invite Friends &amp; Earn Rewards</span>
            </div>
            <p class="bk-referral-sub">Share your referral code with fellow book lovers. They get discount perks and you earn wallet cashback!</p>
            <div class="bk-referral-code-row">
              <div class="bk-code-box">
                <span class="bk-code-text" id="myReferralCode"><%= safeUserData.referralCode || 'BOOKSAW100' %></span>
                <button class="bk-btn bk-btn-dark bk-btn-sm" onclick="copyReferralCode('<%= safeUserData.referralCode || 'BOOKSAW100' %>')">
                  <i class="fas fa-copy"></i> Copy
                </button>
              </div>
            </div>
            <% if (!safeUserData.alreadyReffered) { %>
              <div class="bk-apply-row">
                <input type="text" class="bk-input" id="inputReferralCode" placeholder="Have a friend's code?">
                <button class="bk-btn bk-btn-dark" onclick="applyReferralCode()">Apply</button>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── 2. ORDERS ─── -->
    <div class="bk-panel" id="panel-orders">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-box-open"></i> Order History</div>
          <a href="/loadShop" class="bk-btn bk-btn-outline bk-btn-sm"><i class="fas fa-shop"></i> Browse Shop</a>
        </div>
        <div class="bk-panel-body" style="padding:0">
          <% if (safeOrders && safeOrders.length > 0) { %>
            <div class="bk-table-wrap">
              <table class="bk-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Action</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% safeOrders.forEach(order => { %>
                    <tr>
                      <td><span class="bk-oid">#<%= order.orderId %></span></td>
                      <td style="font-size:.82rem;color:var(--muted)"><%= order.paymentMethod %></td>
                      <td>
                        <%
                          let sPill = 'bk-pill-pend';
                          if(order.orderStatus==='Cancelled') sPill='bk-pill-can';
                          else if(order.orderStatus==='Returned') sPill='bk-pill-ret';
                          else if(order.orderStatus==='Delivered') sPill='bk-pill-del';
                          else if(order.orderStatus==='Shipped') sPill='bk-pill-ship';
                        %>
                        <span class="bk-pill <%= sPill %>"><%= order.orderStatus %></span>
                      </td>
                      <td>
                        <%
                          let pPill = 'bk-pill-pend-pay';
                          if(order.paymentStatus==='Received') pPill='bk-pill-recv';
                          else if(order.paymentStatus==='Failed') pPill='bk-pill-fail';
                          else if(order.paymentStatus==='Refund') pPill='bk-pill-ref';
                        %>
                        <span class="bk-pill <%= pPill %>"><%= order.paymentStatus %></span>
                      </td>
                      <td style="font-size:.8rem;color:var(--muted);white-space:nowrap">
                        <%= order.orderDate ? new Date(order.orderDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : 'N/A' %>
                      </td>
                      <td style="font-weight:700">&#8377;<%= order.totalAmount %></td>
                      <td>
                        <% if(order.orderStatus!=='Cancelled' && order.orderStatus!=='Returned' && order.orderStatus!=='Delivered') { %>
                          <a class="bk-btn bk-btn-danger bk-btn-sm cancel-order" href="/orderCancel?id=<%= order._id %>" data-order-id="<%= order._id %>">
                            <i class="fas fa-times"></i> Cancel
                          </a>
                        <% } else if(order.orderStatus==='Delivered') { %>
                          <a class="bk-btn bk-btn-outline bk-btn-sm return-order" href="/orderReturn?id=<%= order._id %>" data-order-id="<%= order._id %>">
                            <i class="fas fa-undo"></i> Return
                          </a>
                        <% } else { %>
                          <span style="font-size:.78rem;color:var(--muted)">—</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/loadOrderDetails?id=<%= order._id %>" class="bk-btn bk-btn-outline bk-btn-sm">
                          <i class="fas fa-eye"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (safeTotalPages > 1) { %>
              <div class="bk-pagination" style="padding:16px">
                <% if(safePage > 1) { %><a href="/loadProfile?page=<%= safePage-1 %>" class="bk-page-btn"><i class="fas fa-chevron-left" style="font-size:.75rem"></i></a><% } else { %><span class="bk-page-btn disabled"><i class="fas fa-chevron-left" style="font-size:.75rem"></i></span><% } %>
                <% for(let p=1;p<=safeTotalPages;p++) { %>
                  <a href="/loadProfile?page=<%= p %>" class="bk-page-btn <%= safePage===p?'active':'' %>"><%= p %></a>
                <% } %>
                <% if(safePage < safeTotalPages) { %><a href="/loadProfile?page=<%= safePage+1 %>" class="bk-page-btn"><i class="fas fa-chevron-right" style="font-size:.75rem"></i></a><% } else { %><span class="bk-page-btn disabled"><i class="fas fa-chevron-right" style="font-size:.75rem"></i></span><% } %>
              </div>
            <% } %>
          <% } else { %>
            <div class="bk-empty">
              <div class="bk-empty-icon">📦</div>
              <div class="bk-empty-title">No orders yet</div>
              <p class="bk-empty-sub">You haven't placed any book orders yet.</p>
              <a href="/loadShop" class="bk-btn bk-btn-dark"><i class="fas fa-compass"></i> Explore Books</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ─── 3. ADDRESSES ─── -->
    <div class="bk-panel" id="panel-address">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-map-marker-alt"></i> Saved Addresses</div>
          <button class="bk-btn bk-btn-dark bk-btn-sm" id="toggleAddressForm">
            <i class="fas fa-plus"></i> Add Address
          </button>
        </div>
        <div class="bk-panel-body">

          <!-- Inline add form -->
          <div class="bk-addr-form" id="addressFormContainer">
            <div class="bk-addr-form-title"><i class="fas fa-map-pin" style="color:var(--hi)"></i> New Delivery Address</div>
            <form id="addressForm" action="/addAddress" method="post">
              <div class="bk-row bk-row-2" style="margin-bottom:14px">
                <div class="bk-field-group" style="margin:0">
                  <label class="bk-label">Recipient Name</label>
                  <input type="text" class="bk-input" name="name" id="inputAddress" required placeholder="Full Name">
                </div>
                <div class="bk-field-group" style="margin:0">
                  <label class="bk-label">Mobile Number</label>
                  <input type="tel" pattern="[0-9]{10}" class="bk-input" name="mobile" id="inputCity" required placeholder="10-digit number">
                </div>
              </div>
              <div class="bk-field-group">
                <label class="bk-label">House / Building / Street</label>
                <input type="text" class="bk-input" name="houseName" id="inputHouse" required placeholder="Flat, House no., Apartment">
              </div>
              <div class="bk-row bk-row-3" style="margin-bottom:18px">
                <div class="bk-field-group" style="margin:0">
                  <label class="bk-label">City / Town</label>
                  <input type="text" class="bk-input" name="city" id="inputCityName" required placeholder="City">
                </div>
                <div class="bk-field-group" style="margin:0">
                  <label class="bk-label">State</label>
                  <input type="text" class="bk-input" name="state" id="inputState" required placeholder="State">
                </div>
                <div class="bk-field-group" style="margin:0">
                  <label class="bk-label">PIN Code</label>
                  <input type="text" pattern="[0-9]{6}" class="bk-input" name="pinCode" id="inputZip" required placeholder="6-digit PIN">
                </div>
              </div>
              <div style="display:flex;gap:10px">
                <button type="submit" class="bk-btn bk-btn-dark"><i class="fas fa-check"></i> Save Address</button>
                <button type="button" class="bk-btn bk-btn-outline" id="cancelAddressBtn">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Address cards -->
          <% if (safeAddresses && safeAddresses.length > 0) { %>
            <div class="bk-address-grid">
              <% safeAddresses.forEach((address, index) => { %>
                <div class="bk-address-card" id="address_<%= address._id %>">
                  <span class="bk-address-num">Address #<%= index+1 %></span>
                  <div class="bk-address-name"><%= address.name %></div>
                  <div class="bk-address-phone"><i class="fas fa-phone-alt" style="font-size:.72rem"></i> <%= address.mobile %></div>
                  <div class="bk-address-text">
                    <%= address.houseName %><br>
                    <%= address.city %>, <%= address.state %><br>
                    <strong>PIN <%= address.pinCode %></strong>
                  </div>
                  <div class="bk-address-actions">
                    <a href="/loadEditAddress1?id=<%= address._id %>" class="bk-btn bk-btn-outline bk-btn-sm">
                      <i class="fas fa-edit"></i> Edit
                    </a>
                    <button class="bk-btn bk-btn-danger bk-btn-sm" onclick="removeAddress('<%= address._id %>')">
                      <i class="fas fa-trash"></i> Delete
                    </button>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="bk-empty">
              <div class="bk-empty-icon">📍</div>
              <div class="bk-empty-title">No addresses saved</div>
              <p class="bk-empty-sub">Save delivery locations for faster checkout.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ─── 4. WALLET ─── -->
    <div class="bk-panel" id="panel-wallet">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-wallet"></i> Digital Wallet</div>
        </div>
        <div class="bk-panel-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start">
            <div>
              <!-- Balance card -->
              <div class="bk-wallet-card">
                <div class="bk-wallet-label">BOOKSAW Pay Balance</div>
                <div class="bk-wallet-amount">&#8377;<%= (safeWallet && typeof safeWallet.balance === 'number') ? safeWallet.balance.toFixed(2) : '0.00' %></div>
                <div class="bk-wallet-sub">Available for instant checkout</div>
              </div>
              <!-- Top-up -->
              <div class="bk-wallet-topup">
                <div class="bk-wallet-topup-title"><i class="fas fa-plus-circle" style="color:var(--hi)"></i> Top Up Balance</div>
                <form onsubmit="event.preventDefault(); submitForm();">
                  <div class="bk-field-group">
                    <label class="bk-label">Amount (&#8377;)</label>
                    <input type="number" min="1" step="any" class="bk-input" id="amountInput" placeholder="e.g. 500" required>
                  </div>
                  <button type="button" onclick="submitForm()" class="bk-btn bk-btn-dark bk-btn-full">
                    <i class="fas fa-bolt"></i> Add via Razorpay
                  </button>
                </form>
              </div>
            </div>

            <!-- Transaction history -->
            <div>
              <div class="bk-section-title" style="margin-bottom:12px"><i class="fas fa-clock" style="color:var(--hi);font-size:.85rem"></i> Transaction History</div>
              <% if (safeWallet && safeWallet.history && safeWallet.history.length > 0) { %>
                <div class="bk-tx-list">
                  <% for(let i = safeWallet.history.length - 1; i >= 0; i--) { %>
                    <div class="bk-tx-item">
                      <span class="bk-tx-date"><%= safeWallet.history[i].createdAt ? new Date(safeWallet.history[i].createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : 'N/A' %></span>
                      <span class="bk-tx-amt <%= safeWallet.history[i].type === 'credit' ? 'bk-tx-credit' : 'bk-tx-debit' %>">
                        <%= safeWallet.history[i].type === 'credit' ? '+' : '−' %> &#8377;<%= safeWallet.history[i].amount %>
                      </span>
                      <span class="bk-tx-type <%= safeWallet.history[i].type %>"><%= safeWallet.history[i].type %></span>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <div class="bk-empty" style="padding:40px 20px">
                  <div class="bk-empty-icon" style="font-size:2rem">💳</div>
                  <div class="bk-empty-title" style="font-size:.95rem">No transactions yet</div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── 5. COUPONS ─── -->
    <div class="bk-panel" id="panel-coupons">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-tags"></i> Available Coupons</div>
        </div>
        <div class="bk-panel-body">
          <% if (safeCoupons && safeCoupons.length > 0) { %>
            <div class="bk-coupon-grid">
              <% safeCoupons.forEach((coupon, idx) => { %>
                <div class="bk-coupon-card">
                  <div class="bk-coupon-top">
                    <div class="bk-coupon-discount"><%= coupon.discountAmount %><span>% OFF</span></div>
                    <div class="bk-coupon-expiry">
                      Expires<br>
                      <strong><%= coupon.expirationDate ? new Date(coupon.expirationDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : 'No Expiry' %></strong>
                    </div>
                  </div>
                  <div class="bk-coupon-body">
                    <div class="bk-coupon-name"><%= coupon.couponName %></div>
                    <div class="bk-coupon-desc">Apply at checkout to enjoy <%= coupon.discountAmount %>% off your order.</div>
                    <div class="bk-coupon-code-row">
                      <span class="bk-coupon-code"><%= coupon.couponCode %></span>
                      <button class="bk-btn bk-btn-dark bk-btn-sm" onclick="copyCoupon('<%= coupon.couponCode %>', this)" id="coupon-btn-<%= idx %>">
                        <i class="fas fa-copy"></i> <span>Copy</span>
                      </button>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="bk-empty">
              <div class="bk-empty-icon">🎟️</div>
              <div class="bk-empty-title">No coupons available</div>
              <p class="bk-empty-sub">Stay tuned for seasonal discounts and promotional offers!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ─── 6. SETTINGS ─── -->
    <div class="bk-panel" id="panel-settings">
      <div class="bk-panel-card">
        <div class="bk-panel-head">
          <div class="bk-panel-title"><i class="fas fa-user-cog"></i> Account Settings</div>
        </div>
        <div class="bk-panel-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start">
            <div>
              <div class="bk-section-title">Update Username</div>
              <form onsubmit="event.preventDefault(); updateUsername();">
                <div class="bk-field-group">
                  <label class="bk-label">New Username</label>
                  <input type="text" class="bk-input" id="newUsername" required placeholder="Letters only (e.g. John)" pattern="^[a-zA-Z]+$">
                  <small style="font-size:.75rem;color:var(--muted);margin-top:4px;display:block">Username must contain only alphabets.</small>
                </div>
                <div class="bk-field-group">
                  <label class="bk-label">Confirm Current Password</label>
                  <input type="password" class="bk-input" id="currentPassword" required placeholder="Enter your current password">
                </div>
                <button type="submit" class="bk-btn bk-btn-dark"><i class="fas fa-check"></i> Save Username</button>
              </form>
            </div>
            <div>
              <div class="bk-section-title">Security</div>
              <p style="font-size:.84rem;color:var(--muted);margin-bottom:16px;line-height:1.6">Keep your account safe by updating your password regularly.</p>
              <a href="/profileEdit" class="bk-btn bk-btn-outline bk-btn-full"><i class="fas fa-key"></i> Change Password</a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /bk-main -->
</div><!-- /bk-account -->

<%- include('../partials/userFooter') %>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="/public/assets/js/vendor/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
/* ── TAB SWITCHING ────────────────────────── */
function showTab(id, btn) {
  document.querySelectorAll('.bk-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.bk-nav-item').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('panel-' + id);
  if (panel) panel.classList.add('active');
  if (btn) btn.classList.add('active');
}

// Open from URL hash (#orders etc.)
document.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#','');
  const valid = ['dashboard','orders','address','wallet','coupons','settings'];
  if (hash && valid.includes(hash)) {
    const btn = document.getElementById('tab-btn-' + hash);
    showTab(hash, btn);
  }

  // Address form toggle
  const toggleBtn = document.getElementById('toggleAddressForm');
  const formCont  = document.getElementById('addressFormContainer');
  const cancelBtn = document.getElementById('cancelAddressBtn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      formCont.style.display = formCont.style.display === 'block' ? 'none' : 'block';
      if (formCont.style.display === 'block') formCont.scrollIntoView({ behavior: 'smooth' });
    });
  }
  if (cancelBtn) cancelBtn.addEventListener('click', () => { formCont.style.display = 'none'; });

  // Cancel order
  document.querySelectorAll('.cancel-order').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const id = btn.getAttribute('data-order-id');
      Swal.fire({ title:'Cancel Order?', text:'This cannot be undone.', icon:'warning',
        showCancelButton:true, confirmButtonColor:'#b91c1c', cancelButtonColor:'#7a6f60',
        confirmButtonText:'Yes, cancel', cancelButtonText:'Keep it'
      }).then(r => { if(r.isConfirmed) window.location.href = '/orderCancel?id='+id; });
    });
  });

  // Return order
  document.querySelectorAll('.return-order').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const id = btn.getAttribute('data-order-id');
      Swal.fire({ title:'Return Order?', text:'Request a return for this delivered order?', icon:'question',
        showCancelButton:true, confirmButtonColor:'#2d2820', cancelButtonColor:'#7a6f60',
        confirmButtonText:'Yes, return', cancelButtonText:'No'
      }).then(r => { if(r.isConfirmed) window.location.href = '/orderReturn?id='+id; });
    });
  });
});

/* ── REFERRAL ─────────────────────────────── */
function copyReferralCode(text) {
  navigator.clipboard.writeText(text).then(() => toastr.success('Referral code copied!'));
}
function applyReferralCode() {
  const code = document.getElementById('inputReferralCode').value.trim();
  if (!code) { toastr.warning('Please enter a referral code.'); return; }
  fetch('/applyReferral', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({referralCode:code}) })
    .then(r => r.json()).then(d => {
      if (d.success) { toastr.success('Referral code applied!'); setTimeout(() => location.reload(), 1200); }
      else toastr.error(d.error || 'Invalid referral code');
    }).catch(e => toastr.error('Error: ' + e.message));
}

/* ── COUPON COPY ──────────────────────────── */
function copyCoupon(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const sp = btn.querySelector('span');
    if (sp) sp.textContent = 'Copied!';
    btn.classList.add('btn-success');
    setTimeout(() => { if(sp) sp.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
  });
}

/* ── REMOVE ADDRESS ───────────────────────── */
function removeAddress(addressId) {
  Swal.fire({ title:'Delete Address?', text:'Are you sure?', icon:'warning',
    showCancelButton:true, confirmButtonColor:'#b91c1c', cancelButtonColor:'#7a6f60',
    confirmButtonText:'Yes, delete'
  }).then(r => {
    if (r.isConfirmed) {
      fetch('/removeAddress', { method:'DELETE', headers:{'Content-Type':'application/json'}, body:JSON.stringify({addressId}) })
        .then(res => {
          if (res.ok) { const el = document.getElementById('address_'+addressId); if(el) el.remove(); toastr.success('Address deleted.'); }
          else toastr.error('Failed to remove address.');
        }).catch(e => toastr.error('Error: '+e.message));
    }
  });
}

/* ── WALLET TOP-UP ────────────────────────── */
function submitForm() {
  const amt = parseFloat(document.getElementById('amountInput').value);
  if (!amt || amt <= 0) { toastr.warning('Enter a valid amount.'); return; }
  fetch('/addToWallet', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({amount:amt}) })
    .then(r => r.json()).then(data => {
      if (!data || !data.order) { toastr.error(data.message || 'Payment init failed'); return; }
      const opts = {
        key: 'rzp_test_bdVGrcCwlFiIwl', amount: data.order.amount, currency: data.order.currency,
        name:'BOOKSAW Wallet', description:'Add Funds', order_id: data.order.id,
        handler: function(resp) {
          fetch('/addToWallet', { method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ amount:amt, razorpay_payment_id:resp.razorpay_payment_id, razorpay_order_id:resp.razorpay_order_id, razorpay_signature:resp.razorpay_signature })
          }).then(r => r.json()).then(res => {
            if(res.success) Swal.fire({icon:'success',title:'Payment Successful!',text:'Wallet updated!'}).then(() => location.reload());
            else toastr.error(res.message || 'Verification failed');
          });
        },
        theme: { color: '#2d2820' }
      };
      new Razorpay(opts).open();
    }).catch(e => toastr.error('Payment error: '+e.message));
}

/* ── UPDATE USERNAME ──────────────────────── */
function updateUsername() {
  const u = document.getElementById('newUsername').value.trim();
  const p = document.getElementById('currentPassword').value;
  if (!/^[a-zA-Z]+$/.test(u)) { toastr.error('Username should contain only alphabets'); return; }
  fetch('/editUsername', { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({newUsername:u,currentPassword:p}) })
    .then(r => r.json()).then(d => {
      if (d.message === 'Username updated successfully') { toastr.success(d.message); setTimeout(() => location.reload(), 1200); }
      else toastr.error(d.message || 'Error updating username');
    }).catch(() => toastr.error('Error updating username'));
}

/* ── TOASTR ───────────────────────────────── */
toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 1400, extendedTimeOut: 400, showDuration: 150, hideDuration: 180, preventDuplicates: true, newestOnTop: true };
</script>
</body>
</html>