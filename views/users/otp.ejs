<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP | BOOKSAW</title>
    <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
    :root {
        --canvas:    #f5f0e8;
        --bg:        #faf8f4;
        --fg:        #2d2820;
        --highlight: #b8542a;
        --hi-light:  #d4673a;
        --muted-fg:  #7a6f60;
        --border:    #ddd8ce;
        --secondary: #edeae2;
        --card:      #ffffff;
        --danger:    #b91c1c;
        --success:   #166534;
        --shadow-md: 0 8px 32px rgba(45,40,32,0.11);
        --r-sm: 8px; --r-md: 14px; --r-lg: 20px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
        font-family: 'IBM Plex Sans', sans-serif;
        background: var(--canvas);
        color: var(--fg);
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        letter-spacing: 0;
    }
    .auth-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-md);
        width: 100%;
        max-width: 460px;
        overflow: hidden;
        position: relative;
    }
    .auth-card-top {
        background: var(--fg);
        padding: 32px 36px 28px;
        position: relative;
        overflow: hidden;
    }
    .auth-card-top::before {
        content: '';
        position: absolute;
        top: -40%;
        right: -15%;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(184,84,42,0.12);
        pointer-events: none;
    }
    .auth-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }
    .auth-logo img { height: 28px; filter: brightness(0) invert(1); opacity: 0.9; }
    .auth-logo-text {
        font-family: 'Libre Baskerville', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: rgba(255,255,255,0.9);
        letter-spacing: 0.5px;
    }
    .auth-title {
        font-family: 'Libre Baskerville', serif;
        font-size: 1.65rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
    }
    .auth-subtitle {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
        line-height: 1.5;
    }
    .auth-body { padding: 32px 36px 36px; }
    .form-group { margin-bottom: 20px; }
    .form-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--muted-fg);
        margin-bottom: 7px;
    }
    .form-input {
        display: block;
        width: 100%;
        padding: 12px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-sm);
        background: var(--card);
        color: var(--fg);
        font-family: 'IBM Plex Sans', sans-serif;
        font-size: 0.95rem;
        transition: border-color 0.18s, box-shadow 0.18s;
        outline: none;
    }
    .form-input:focus {
        border-color: var(--highlight);
        box-shadow: 0 0 0 3px rgba(184,84,42,0.10);
    }
    .form-hint {
        font-size: 0.72rem;
        color: var(--muted-fg);
        margin-top: 5px;
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .btn-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px 20px;
        background: var(--fg);
        color: #fff;
        font-family: 'IBM Plex Sans', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        border: none;
        border-radius: var(--r-sm);
        cursor: pointer;
        transition: background 0.2s ease;
        margin-top: 8px;
    }
    .btn-submit:hover { background: var(--highlight); }
    .auth-footer {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        margin-top: 24px;
        font-size: 0.85rem;
        color: var(--muted-fg);
    }
    .auth-footer a { color: var(--highlight); font-weight: 600; text-decoration: none; }
    .auth-footer a:hover { text-decoration: underline; }
    .alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 14px;
        border-radius: var(--r-sm);
        font-size: 0.83rem;
        font-weight: 500;
        margin-bottom: 20px;
        line-height: 1.5;
    }
    .alert i { flex-shrink: 0; margin-top: 1px; }
    .alert-danger { background: rgba(185,28,28,0.07); border: 1px solid rgba(185,28,28,0.25); color: var(--danger); }
    .alert-success { background: rgba(22,101,52,0.07); border: 1px solid rgba(22,101,52,0.25); color: var(--success); }
    .alert-warning { background: rgba(184,84,42,0.07); border: 1px solid rgba(184,84,42,0.25); color: var(--highlight); }
    .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-text { font-size: 0.75rem; color: var(--muted-fg); font-weight: 500; white-space: nowrap; }
    .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 11px 20px;
        background: var(--card);
        border: 1.5px solid var(--border);
        border-radius: var(--r-sm);
        font-family: 'IBM Plex Sans', sans-serif;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--fg);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        text-decoration: none;
    }
    .google-btn:hover { border-color: var(--highlight); background: var(--secondary); }
    .google-btn img { width: 18px; height: 18px; }
    .otp-inputs { display: flex; gap: 10px; justify-content: center; margin: 8px 0; }
    .otp-box {
        width: 52px; height: 58px;
        text-align: center;
        font-size: 1.5rem;
        font-weight: 700;
        border: 1.5px solid var(--border);
        border-radius: var(--r-sm);
        background: var(--card);
        color: var(--fg);
        outline: none;
        transition: border-color 0.18s, box-shadow 0.18s;
    }
    .otp-box:focus { border-color: var(--highlight); box-shadow: 0 0 0 3px rgba(184,84,42,0.10); }
    .timer-text { text-align: center; font-size: 0.82rem; color: var(--muted-fg); margin-top: 12px; }
    .timer-text span { color: var(--highlight); font-weight: 700; }
    .btn-resend {
        background: none;
        border: none;
        color: var(--highlight);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
        text-decoration: underline;
    }
    .btn-resend:disabled { color: var(--muted-fg); cursor: not-allowed; text-decoration: none; }
    .password-field { position: relative; }
    .password-toggle {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--muted-fg);
        cursor: pointer;
        padding: 0;
        font-size: 0.9rem;
    }
    .password-toggle:hover { color: var(--highlight); }
    .strength-bar { height: 3px; border-radius: 3px; margin-top: 6px; background: var(--border); overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 3px; transition: width 0.3s, background 0.3s; width: 0; }
    .error-msg { font-size: 0.72rem; color: var(--danger); margin-top: 5px; display: none; }
    @media (max-width: 500px) {
        .auth-card-top, .auth-body { padding-left: 24px; padding-right: 24px; }
        .form-row { grid-template-columns: 1fr; }
    }
</style>
</head>
<body>
<div class="auth-card">
    <div class="auth-card-top">
        <div class="auth-logo">
            <img src="/public/spellbook.png" alt="BOOKSAW">
            <span class="auth-logo-text">BOOKSAW</span>
        </div>
        <h1 class="auth-title">Check your email.</h1>
        <p class="auth-subtitle">We've sent a 6-digit verification code. Enter it below to continue.</p>
    </div>
    <div class="auth-body">

        <% if (locals.errmessage && errmessage) { %>
            <div class="alert alert-danger"><i class="fas fa-circle-exclamation"></i><span><%= errmessage %></span></div>
        <% } %>
        <% if (locals.successMessage && successMessage) { %>
            <div class="alert alert-success"><i class="fas fa-circle-check"></i><span><%= successMessage %></span></div>
        <% } %>

        <span id="loginErrorMessage" style="display:none"><%= locals.errmessage ? errmessage : '' %></span>
        <span id="loginSuccessMessage" style="display:none"><%= locals.successMessage ? successMessage : '' %></span>

        <form id="otpForm" action="/verifyOtp" method="post">
            <div class="form-group" style="text-align:center">
                <label class="form-label" style="text-align:center;width:100%">6-digit code</label>
                <div class="otp-inputs">
                    <input class="otp-box" type="text" maxlength="1" id="o1" inputmode="numeric" autocomplete="one-time-code">
                    <input class="otp-box" type="text" maxlength="1" id="o2" inputmode="numeric">
                    <input class="otp-box" type="text" maxlength="1" id="o3" inputmode="numeric">
                    <input class="otp-box" type="text" maxlength="1" id="o4" inputmode="numeric">
                    <input class="otp-box" type="text" maxlength="1" id="o5" inputmode="numeric">
                    <input class="otp-box" type="text" maxlength="1" id="o6" inputmode="numeric">
                </div>
                <input type="hidden" id="otp" name="otp">
            </div>
            <div class="timer-text" id="timerDisplay">
                Resend code in <span id="timerCount">60</span>s
            </div>
            <button type="submit" class="btn-submit" id="otp-verify-btn" style="margin-top:20px">
                <i class="fas fa-shield-halved"></i> Verify Code
            </button>
        </form>

        <div style="text-align:center;margin-top:18px">
            <button class="btn-resend" id="resendButton" onclick="resendOTP()" disabled>
                Resend code
            </button>
        </div>
    </div>
</div>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // OTP box logic
    const boxes = document.querySelectorAll('.otp-box');
    boxes.forEach((box, idx) => {
        box.addEventListener('input', () => {
            box.value = box.value.replace(/[^0-9]/g,'');
            if (box.value && idx < boxes.length - 1) boxes[idx+1].focus();
            updateHidden();
        });
        box.addEventListener('keydown', e => {
            if (e.key === 'Backspace' && !box.value && idx > 0) boxes[idx-1].focus();
        });
        box.addEventListener('paste', e => {
            e.preventDefault();
            const paste = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
            [...paste].slice(0,6).forEach((ch,i)=>{ if(boxes[i]) boxes[i].value = ch; });
            updateHidden();
            if (boxes[Math.min(paste.length, 5)]) boxes[Math.min(paste.length,5)].focus();
        });
    });

    function updateHidden() {
        document.getElementById('otp').value = [...boxes].map(b=>b.value).join('');
    }

    // Timer
    let seconds = 60;
    const timerEl = document.getElementById('timerCount');
    const timerWrap = document.getElementById('timerDisplay');
    const resendBtn = document.getElementById('resendButton');
    let timer = setInterval(() => {
        if (--seconds <= 0) {
            clearInterval(timer);
            timerWrap.style.display = 'none';
            resendBtn.disabled = false;
        } else { timerEl.textContent = seconds; }
    }, 1000);

    function resendOTP() {
        resendBtn.disabled = true;
        seconds = 60;
        timerEl.textContent = seconds;
        timerWrap.style.display = 'block';
        timer = setInterval(() => {
            if (--seconds <= 0) {
                clearInterval(timer);
                timerWrap.style.display = 'none';
                resendBtn.disabled = false;
            } else { timerEl.textContent = seconds; }
        }, 1000);
        fetch('/getOtp', { method:'GET', headers:{'Content-Type':'application/json'} })
          .then(r=>{ if(!r.ok) throw new Error('Failed'); toastr.success('OTP resent!'); })
          .catch(()=>toastr.error('Could not resend OTP.'));
    }

    document.getElementById('otpForm').addEventListener('submit', e => {
        updateHidden();
        const code = document.getElementById('otp').value;
        if (code.length < 6) { e.preventDefault(); toastr.warning('Please enter all 6 digits.'); }
    });

    const errEl = document.getElementById('loginErrorMessage');
    if (errEl && errEl.innerText.trim()) {
        Swal.fire({ icon:'error', title:'Invalid OTP', text: errEl.innerText.trim(), confirmButtonColor:'#2d2820' });
    }
</script>
</body>
</html>