</div>

<!-- Aceternity Loader One (Global Preloader) -->
<div id="preloader-active">
  <div class="bk-loader-one">
    <div class="bk-loader-one-visual">
      <div class="bk-loader-ring-outer"></div>
      <div class="bk-loader-ring-inner"></div>
      <div class="bk-loader-core"></div>
    </div>
    <div class="bk-loader-label">
      <span>BOOKSAW</span>
      <span class="bk-loader-dots">
        <span class="bk-loader-dot"></span>
        <span class="bk-loader-dot"></span>
        <span class="bk-loader-dot"></span>
      </span>
    </div>
  </div>
</div>

<style>
  /* ── ACETERNITY LOADER ONE (PRELOADER & GLOBAL LOADER) ── */
  #preloader-active,
  #bk-global-loader {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(250, 248, 244, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  #preloader-active.loaded,
  #bk-global-loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .bk-loader-one {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .bk-loader-one-visual {
    position: relative;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Outer orbital glowing gradient ring */
  .bk-loader-ring-outer {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(from 0deg, transparent 20%, rgba(184,84,42,0.1) 50%, #b8542a 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #fff calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #fff calc(100% - 3px));
    animation: bkSpin 1.1s linear infinite;
    filter: drop-shadow(0 0 8px rgba(184,84,42,0.4));
  }
  /* Inner counter-rotating dashed ring */
  .bk-loader-ring-inner {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    border: 2px dashed rgba(45, 40, 32, 0.35);
    border-top-color: #b8542a;
    animation: bkSpinReverse 1.8s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
  }
  /* Center core pulsing glowing dot */
  .bk-loader-core {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #b8542a;
    box-shadow: 0 0 16px rgba(184,84,42,0.7), 0 0 24px rgba(184,84,42,0.3);
    animation: bkPulse 1.4s ease-in-out infinite;
  }
  .bk-loader-label {
    font-family: 'Libre Baskerville', serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: #2d2820;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bk-loader-dots {
    display: inline-flex;
    gap: 3px;
    margin-left: 2px;
  }
  .bk-loader-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #b8542a;
    animation: bkDotPulse 1.2s infinite ease-in-out;
  }
  .bk-loader-dot:nth-child(2) { animation-delay: 0.2s; }
  .bk-loader-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes bkSpin {
    100% { transform: rotate(360deg); }
  }
  @keyframes bkSpinReverse {
    100% { transform: rotate(-360deg); }
  }
  @keyframes bkPulse {
    0%, 100% { transform: scale(0.85); opacity: 0.7; }
    50% { transform: scale(1.15); opacity: 1; filter: drop-shadow(0 0 12px #b8542a); }
  }
  @keyframes bkDotPulse {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
    40% { transform: scale(1.1); opacity: 1; }
  }
</style>

<script>
  // Drawer
  function openDrawer()  { document.getElementById('bk-drawer').classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeDrawer() { document.getElementById('bk-drawer').classList.remove('open'); document.body.style.overflow = ''; }

  // Cart auth check
  async function checkCartAuth(event) {
    if (event) event.preventDefault();
    try {
      const res = await fetch('/cart', { method:'GET', headers:{'Content-Type':'application/json'} });
      if (res.status === 401) {
        const data = await res.json().catch(function() { return {}; });
        toastr.error(data.message || 'Please sign in to access your cart!');
      } else if (res.ok) {
        window.location.href = '/cart';
      } else {
        toastr.warning('Something went wrong. Try again later.');
      }
    } catch (err) {
      toastr.error('Network error. Check your connection.');
    }
  }

  // ── Universal Real-time Cart Badge Increment ────────────
  window.bkAddedProducts = window.bkAddedProducts || new Set();
  try { sessionStorage.removeItem('bk_cart_items'); } catch(e) {}

  window.updateCartBadge = function(productId, data) {
    try { sessionStorage.removeItem('bk_cart_items'); } catch(e) {}

    // Determine whether this item is new
    var isNew;
    if (data && typeof data.isNew === 'boolean') {
      isNew = data.isNew;
    } else {
      isNew = !window.bkAddedProducts.has(productId);
    }

    if (productId) {
      window.bkAddedProducts.add(productId);
    }

    // Immediately update badges in real-time
    var badges = document.querySelectorAll('#cart-count, #cart-count-mobile');
    badges.forEach(function(el) {
      if (data && typeof data.uniqueCount === 'number') {
        el.textContent = data.uniqueCount;
      } else if (isNew) {
        var current = parseInt(String(el.textContent || '').trim(), 10);
        if (isNaN(current)) current = 0;
        el.textContent = String(current + 1);
      }

      // Trigger punchy pop animation
      el.classList.remove('bk-badge-pop');
      void el.offsetWidth; // Force reflow
      el.classList.add('bk-badge-pop');
      setTimeout(function() { el.classList.remove('bk-badge-pop'); }, 400);
    });

    // Background sync with database if uniqueCount was not provided by API
    if (!data || typeof data.uniqueCount !== 'number') {
      fetch('/cart')
        .then(function(res) { return res.ok ? res.text() : null; })
        .then(function(html) {
          if (!html) return;
          var match = html.match(/id="cart-count"[^>]*>\s*(\d+)\s*<\/span>/);
          if (match && match[1] !== undefined) {
            var dbCount = parseInt(match[1], 10);
            if (!isNaN(dbCount)) {
              var liveBadges = document.querySelectorAll('#cart-count, #cart-count-mobile');
              liveBadges.forEach(function(el) { el.textContent = dbCount; });
            }
          }
        })
        .catch(function() {});
    }

    return isNew;
  };

  // ── Global Preloader Dismissal ────────────────────────────
  (function() {
    function hidePreloader() {
      var p = document.getElementById('preloader-active');
      if (p) {
        p.classList.add('loaded');
        setTimeout(function() {
          if (p.parentNode) p.style.display = 'none';
        }, 400);
      }
    }
    if (document.readyState === 'complete') {
      setTimeout(hidePreloader, 200);
    } else {
      window.addEventListener('load', function() { setTimeout(hidePreloader, 250); });
      document.addEventListener('DOMContentLoaded', function() { setTimeout(hidePreloader, 600); });
    }
  })();
</script>
