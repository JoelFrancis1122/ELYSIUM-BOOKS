<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>BOOKSAW — Discover Your Next Great Read</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="Shop the finest collection of books at BOOKSAW. Discover bestsellers, new releases, and curated collections.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="BOOKSAW — Discover Your Next Great Read">
    <meta property="og:type" content="website">
    <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ============================================================
           BOOKSAW HOME — WARM LITERARY DESIGN SYSTEM
           Palette derived from reference design tokens:
           --canvas     : #f5f0e8  (oklch 0.955 0.012 85)
           --bg         : #faf8f4  (oklch 0.98 0.006 90)
           --fg         : #2d2820  (oklch 0.22 0.01 75)
           --highlight  : #b8542a  (oklch 0.59 0.13 33) — warm terracotta
           --muted-fg   : #7a6f60  (oklch 0.52 0.012 75)
           --border     : #ddd8ce  (oklch 0.86 0.012 85)
           --secondary  : #edeae2  (oklch 0.92 0.012 85)
           Font: IBM Plex Sans / Libre Baskerville
        ============================================================ */

        :root {
            --canvas:    #f5f0e8;
            --bg:        #faf8f4;
            --fg:        #2d2820;
            --highlight: #b8542a;
            --hi-light:  #d4673a;
            --muted-fg:  #7a6f60;
            --border:    #ddd8ce;
            --secondary: #edeae2;
            --card:      #ffffff;
            --sage:      #6b8f71;
            --amber:     #c9922a;

            --shadow-sm: 0 2px 8px rgba(45,40,32,0.06);
            --shadow-md: 0 8px 24px rgba(45,40,32,0.09);
            --shadow-lg: 0 18px 55px rgba(45,40,32,0.10);
            --shadow-cover: 0 12px 18px rgba(45,40,32,0.20);

            --r-sm: 10px;
            --r-md: 16px;
            --r-lg: 22px;
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'IBM Plex Sans', sans-serif;
            background: var(--canvas);
            color: var(--fg);
            overflow-x: hidden;
            letter-spacing: 0;
        }

        /* ── HERO ──────────────────────────────────────────────── */
        .bk-hero {
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            padding: 80px 0 72px;
            position: relative;
            overflow: hidden;
        }

        /* Subtle warm grain texture overlay */
        .bk-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 700px 500px at 85% 50%, rgba(184,84,42,0.06) 0%, transparent 70%),
                radial-gradient(ellipse 400px 350px at 15% 80%, rgba(107,143,113,0.07) 0%, transparent 60%);
            pointer-events: none;
        }

        .bk-hero-inner {
            position: relative;
            z-index: 1;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 48px;
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 72px;
            align-items: center;
        }

        /* Left copy */
        .bk-hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--highlight);
            margin-bottom: 22px;
        }

        .bk-hero-eyebrow::before {
            content: '';
            display: block;
            width: 28px;
            height: 2px;
            background: var(--highlight);
            border-radius: 2px;
        }

        .bk-hero-heading {
            font-family: 'Libre Baskerville', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.6rem);
            font-weight: 700;
            line-height: 1.18;
            color: var(--fg);
            margin-bottom: 22px;
        }

        .bk-hero-heading em {
            font-style: italic;
            color: var(--highlight);
        }

        .bk-hero-sub {
            font-size: 1.05rem;
            color: var(--muted-fg);
            line-height: 1.75;
            max-width: 480px;
            margin-bottom: 40px;
            font-weight: 300;
        }

        .bk-hero-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: var(--fg);
            color: var(--bg);
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 13px 26px;
            border-radius: 6px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
            letter-spacing: 0.3px;
        }

        .btn-primary:hover {
            background: var(--highlight);
            color: #fff;
            transform: translateY(-2px);
            text-decoration: none;
        }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: transparent;
            color: var(--fg);
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 12px 24px;
            border-radius: 6px;
            border: 1.5px solid var(--border);
            text-decoration: none;
            cursor: pointer;
            transition: border-color 0.2s, color 0.2s, background 0.2s;
        }

        .btn-ghost:hover {
            border-color: var(--highlight);
            color: var(--highlight);
            background: rgba(184,84,42,0.04);
            text-decoration: none;
        }

        /* Hero stats */
        .bk-hero-stats {
            display: flex;
            gap: 36px;
            margin-top: 52px;
            padding-top: 36px;
            border-top: 1px solid var(--border);
        }

        .bk-stat-num {
            font-family: 'Libre Baskerville', serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--fg);
            line-height: 1;
        }

        .bk-stat-label {
            font-size: 0.73rem;
            color: var(--muted-fg);
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin-top: 5px;
        }

        .bk-stat-sep {
            width: 1px;
            background: var(--border);
            height: 36px;
            margin-top: 4px;
        }

        /* Right: quote card */
        .bk-hero-right {}

        .bk-quote-shell {
            background: var(--canvas);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 36px 36px 30px;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .bk-quote-shell::before {
            content: '\201C';
            position: absolute;
            top: -8px;
            left: 22px;
            font-family: 'Libre Baskerville', serif;
            font-size: 7rem;
            color: var(--highlight);
            opacity: 0.12;
            line-height: 1;
            pointer-events: none;
        }

        .bk-quote-tag {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--highlight);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bk-quote-tag::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .bk-quote-slides {
            position: relative;
            min-height: 160px;
        }

        .bk-quote-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.7s ease, transform 0.7s ease;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .bk-quote-slide.active {
            opacity: 1;
            transform: translateY(0);
        }

        .bk-quote-text {
            font-family: 'Libre Baskerville', serif;
            font-size: 1.08rem;
            font-style: italic;
            color: var(--fg);
            line-height: 1.75;
            margin-bottom: 18px;
        }

        .bk-quote-author {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--highlight);
            letter-spacing: 0.5px;
        }

        .bk-quote-author::before { content: '— '; }

        .bk-quote-dots {
            display: flex;
            gap: 7px;
            margin-top: 24px;
        }

        .bk-quote-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--border);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
        }

        .bk-quote-dot.active {
            background: var(--highlight);
            width: 18px;
            border-radius: 3px;
        }

        /* Reading week mini-calendar strip */
        .bk-calendar-strip {
            margin-top: 24px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        .bk-cal-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: var(--muted-fg);
            margin-bottom: 14px;
        }

        .bk-cal-days {
            display: flex;
            gap: 4px;
        }

        .bk-cal-day {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 10px 2px;
            border-radius: 999px;
            font-size: 10px;
            color: var(--muted-fg);
            cursor: default;
        }

        .bk-cal-day strong {
            font-size: 12px;
            font-weight: 600;
            color: var(--fg);
        }

        .bk-cal-day:first-child {
            color: var(--highlight);
        }

        .bk-cal-day:first-child strong {
            color: var(--highlight);
        }

        .bk-cal-day-active {
            background: var(--bg);
            box-shadow: var(--shadow-sm);
            color: var(--fg);
        }

        .bk-cal-day-active strong { color: var(--fg); }

        /* ── DIVIDER STRIP ─────────────────────────────────────── */
        .bk-divider-strip {
            background: var(--secondary);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 18px 0;
        }

        .bk-divider-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .bk-trust-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .bk-trust-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--bg);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--highlight);
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .bk-trust-text {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--fg);
        }

        .bk-trust-sub {
            font-size: 0.72rem;
            color: var(--muted-fg);
            margin-top: 1px;
        }

        /* ── MAIN ──────────────────────────────────────────────── */
        .bk-main {
            max-width: 1280px;
            margin: 0 auto;
            padding: 60px 48px 100px;
        }

        /* Section header */
        .bk-section-hd {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .bk-section-label {
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--highlight);
            margin-bottom: 6px;
        }

        .bk-section-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--fg);
            line-height: 1.2;
        }

        .bk-see-all {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--highlight);
            text-decoration: none;
            padding: 7px 16px;
            border: 1.5px solid var(--border);
            border-radius: 999px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .bk-see-all:hover {
            border-color: var(--highlight);
            background: rgba(184,84,42,0.05);
            text-decoration: none;
        }

        /* ── TOOLBAR ────────────────────────────── */
        .bk-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 28px;
            padding: 14px 20px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
        }
        .bk-toolbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .bk-result-count {
            font-size: 0.85rem;
            color: var(--muted-fg);
        }
        .bk-result-count strong { color: var(--fg); font-weight: 700; }
        .bk-toolbar-right { display: flex; align-items: center; gap: 8px; }
        .bk-view-btn {
            width: 34px; height: 34px;
            border-radius: 7px;
            border: 1.5px solid var(--border);
            background: none;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: var(--muted-fg);
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .bk-view-btn:hover, .bk-view-btn.active { border-color: var(--highlight); color: var(--highlight); background: rgba(184,84,42,0.07); }

        /* ── BOOK GRID ────────────────────────────── */
        .bk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 28px 20px;
        }
        .bk-grid.list-view { grid-template-columns: 1fr; }
        .bk-grid.list-view .bk-card {
            flex-direction: row;
            align-items: flex-start;
            gap: 22px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            padding: 18px;
        }
        .bk-grid.list-view .bk-cover-wrap {
            width: 88px;
            flex-shrink: 0;
            aspect-ratio: auto;
            height: 124px;
        }
        .bk-grid.list-view .bk-card-body {
            padding: 0;
            flex: 1;
        }
        .bk-grid.list-view .bk-cover-cta { display: none; }
        .bk-grid.list-view .bk-list-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        /* ── BOOK CARD ───────────────────────────── */
        .bk-card { display: flex; flex-direction: column; }

        /* Cover */
        .bk-cover-wrap {
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            aspect-ratio: 2/3;
            background: var(--secondary);
            /* book spine shadow — left edge slightly darker */
            box-shadow:
                inset 6px 0 12px rgba(45,40,32,0.12),
                4px 6px 20px rgba(45,40,32,0.14);
            transition: transform 380ms cubic-bezier(0.25,0.46,0.45,0.94),
                        box-shadow 380ms cubic-bezier(0.25,0.46,0.45,0.94);
        }
        .bk-card:hover .bk-cover-wrap {
            transform: translateY(-6px) rotate3d(0,1,0,2deg);
            box-shadow:
                inset 6px 0 12px rgba(45,40,32,0.12),
                10px 20px 32px rgba(45,40,32,0.20);
        }
        .bk-cover-wrap img {
            width: 100%; height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Sold-out dim — only for unavailable books, no badge */
        .bk-cover-wrap.soldout img { filter: grayscale(40%) brightness(0.85); }

        /* Slide-up CTA strip — appears from the bottom on hover */
        .bk-cover-cta {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            display: flex;
            transform: translateY(100%);
            transition: transform 320ms cubic-bezier(0.4,0,0.2,1);
        }
        .bk-card:hover .bk-cover-cta { transform: translateY(0); }

        .bk-cta-cart {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 8px;
            background: var(--fg);
            color: rgba(255,255,255,0.92);
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.76rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            border: none;
            cursor: pointer;
            transition: background 0.18s;
        }
        .bk-cta-cart:hover { background: var(--highlight); }

        .bk-cta-wish {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            background: rgba(250,248,244,0.94);
            color: var(--fg);
            font-size: 0.88rem;
            text-decoration: none;
            border: none;
            border-left: 1px solid rgba(45,40,32,0.1);
            cursor: pointer;
            transition: background 0.18s, color 0.18s;
        }
        .bk-cta-wish:hover { background: var(--highlight); color: #fff; }

        /* Sold-out strip */
        .bk-soldout-strip {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 9px;
            background: rgba(45,40,32,0.75);
            text-align: center;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.7);
        }

        /* Card body */
        .bk-card-body { padding: 12px 2px 0; }

        .bk-genre {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--highlight);
            text-decoration: none;
            display: block;
            margin-bottom: 5px;
            opacity: 0.85;
        }
        .bk-genre:hover { opacity: 1; }

        .bk-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 0.87rem;
            font-weight: 700;
            color: var(--fg);
            line-height: 1.45;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 9px;
        }
        .bk-title:hover { color: var(--highlight); }

        .bk-price-row { display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
        .bk-price { font-size: 0.96rem; font-weight: 700; color: var(--fg); }
        .bk-price-old { font-size: 0.77rem; color: var(--muted-fg); text-decoration: line-through; }
        .bk-discount {
            font-size: 0.63rem; font-weight: 700;
            color: var(--highlight);
        }
        .bk-unavail {
            font-size: 0.74rem;
            color: var(--muted-fg);
            font-style: italic;
        }

        /* List view action buttons */
        .bk-list-actions { display: none; }
        .bk-list-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.18s;
            border: 1.5px solid var(--border);
            background: var(--bg);
            color: var(--fg);
        }
        .bk-list-btn:hover { border-color: var(--highlight); color: var(--highlight); }
        .bk-list-btn.primary { background: var(--fg); color: #fff; border-color: var(--fg); }
        .bk-list-btn.primary:hover { background: var(--highlight); border-color: var(--highlight); }

        /* ── PROMO ─────────────────────────────────────────────── */
        .bk-promo {
            margin: 64px 0;
            border-radius: var(--r-lg);
            background: var(--fg);
            padding: 56px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            position: relative;
            overflow: hidden;
        }

        .bk-promo::before {
            content: '';
            position: absolute;
            top: -60%;
            right: -5%;
            width: 480px;
            height: 480px;
            border-radius: 50%;
            background: rgba(184,84,42,0.10);
            pointer-events: none;
        }

        .bk-promo::after {
            content: '\1F4DA';
            position: absolute;
            right: 56px;
            bottom: -8px;
            font-size: 7rem;
            opacity: 0.06;
            line-height: 1;
        }

        .bk-promo-tag {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--highlight);
            margin-bottom: 12px;
        }

        .bk-promo-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--bg);
            line-height: 1.2;
            margin-bottom: 12px;
        }

        .bk-promo-title em {
            font-style: italic;
            color: #e8906a;
        }

        .bk-promo-sub {
            font-size: 0.95rem;
            color: rgba(250,248,244,0.5);
            line-height: 1.6;
        }

        .btn-promo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--highlight);
            color: #fff;
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            padding: 15px 32px;
            border-radius: 6px;
            text-decoration: none;
            white-space: nowrap;
            border: none;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
            flex-shrink: 0;
        }

        .btn-promo:hover {
            background: var(--hi-light);
            transform: translateY(-2px);
            color: #fff;
            text-decoration: none;
        }

        /* ── FEATURE STRIP ─────────────────────────────────────── */
        .bk-features {
            background: var(--bg);
            border-top: 1px solid var(--border);
            padding: 48px 0;
        }

        .bk-features-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 48px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 28px;
        }

        .bk-feature-item {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .bk-feature-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: var(--secondary);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--highlight);
            flex-shrink: 0;
        }

        .bk-feature-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--fg);
            margin-bottom: 4px;
        }

        .bk-feature-sub {
            font-size: 0.78rem;
            color: var(--muted-fg);
            line-height: 1.55;
        }

        /* ── EMPTY STATE ───────────────────────────────────────── */
        .bk-empty {
            text-align: center;
            padding: 80px 20px;
            color: var(--muted-fg);
        }

        .bk-empty-icon { font-size: 3.5rem; margin-bottom: 18px; opacity: 0.35; }
        .bk-empty-title { font-family: 'Libre Baskerville', serif; font-size: 1.3rem; color: var(--fg); margin-bottom: 8px; }



        /* ── RESPONSIVE ────────────────────────────────────────── */
        @media (max-width: 1080px) {
            .bk-hero-inner { grid-template-columns: 1fr; gap: 40px; }
            .bk-hero-right { display: none; }
            .bk-promo { flex-direction: column; text-align: center; }
        }

        @media (max-width: 768px) {
            .bk-hero { padding: 100px 0 60px; }
            .bk-hero-inner, .bk-main, .bk-features-inner, .bk-divider-inner { padding-left: 24px; padding-right: 24px; }
            .bk-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 18px; }
            .bk-promo { padding: 36px 24px; }
            .bk-promo-title { font-size: 1.5rem; }
            .bk-section-hd { flex-direction: column; align-items: flex-start; gap: 12px; }
        }
        @media (max-width: 600px) {
            .bk-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .bk-toolbar { flex-wrap: wrap; }
        }
    </style>
</head>

