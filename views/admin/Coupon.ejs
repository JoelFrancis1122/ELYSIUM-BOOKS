<!DOCTYPE html>
<html lang="en">
<!-- Mirrored from wp.alithemes.com/html/evara/evara-backend/page-categories.html by HTTrack Website Copier/3.x [XR&CO'2014], Sun, 01 Aug 2021 15:33:21 GMT -->

<head>
  <meta charset="utf-8" />
  <title> BOOK-SAW</title>
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="description" content="" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta property="og:title" content="" />
  <meta property="og:type" content="" />
  <meta property="og:url" content="" />
  <meta property="og:image" content="" />
  <!-- Favicon -->
  <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png" />
  <!-- Template CSS -->
  <link href="/public/admin-assets/css/main.css" rel="stylesheet" type="text/css" />
</head>

<body>
  <div class="screen-overlay"></div>
  <%-include('../partials/adminAside')-%>
    <main class="main-wrap">
      <%-include('../partials/adminHeader')-%>
        <section class="content-main">
          <div class="content-header">
            <div>
              <h2 class="content-title card-title">Coupon</h2>
              <p>Give offeres use copons</p>
            </div>

            <% if (locals.messages && messages.success) { %>
              <div class="alert alert-success" id="editSuccessMessage">
                <%= messages.success %>
              </div>
            <% } else if (locals.messages && messages.error) { %>
              <div class="alert alert-danger" id="editErrorMessage">
                <%= messages.error %>
              </div>
            <% } %>
            <% if (locals.errorMessage) { %>
              <div class="alert alert-danger">
                <%= errorMessage %>
              </div>
            <% } %>
          </div>
          <div class="card">
            <div class="card-body">
              <div class="row">
                <div class="col-md-3">
                  <form method="post" action="/admin/addCoupon">

                    <div class="mb-4">
                      <label for="couponName" class="form-label">Coupon Name</label>
                      <input type="text" placeholder="e.g. Summer Sale 2026" name="couponName" class="form-control" id="couponName" required pattern="^[a-zA-Z0-9\s\-]+$" title="Coupon name can contain letters, numbers, spaces, and hyphens."/>                      
                      <div id="couponNameValidation" class="invalid-feedback"></div>
                    </div>
                    
                    <div class="mb-4">
                      <label for="couponCode" class="form-label">Coupon Code</label>
                      <input type="text" placeholder="e.g. SUMMER20" name="couponCode" class="form-control" id="couponCode" required pattern="^[a-zA-Z0-9]+$" title="Coupon code should only contain letters and numbers." style="text-transform:uppercase;"/>
                      <div id="couponCodeValidation" class="invalid-feedback"></div>
                    </div>
                    <div class="mb-4">
                      <label for="minimumPurchase" class="form-label">Minimum Purchase (₹)</label>
                      <input type="number" placeholder="₹0" name="minimumPurchase" class="form-control" id="minimumPurchase" min="1" required/>
                    </div>
                    <div class="mb-4">
                      <label for="discountAmount" class="form-label">Discount %</label>
                      <input type="number" placeholder="0%" name="discountAmount" class="form-control" id="discountAmount" min="1" max="99" required/>
                    </div>
                    <div class="mb-4">
                      <label for="maxDiscount" class="form-label">Max Discount Amount (₹)</label>
                      <input type="number" placeholder="₹0 (0 = no cap)" name="maxDiscount" class="form-control" id="maxDiscount" min="0" required/>
                    </div>

                    <div class="mb-4">
                      <label for="expiration_date" class="form-label">Expiration Date</label>
                      <input type="date" name="expirationDate" class="form-control" id="expiration_date" min="<%= new Date().toISOString().split('T')[0] %>" required>
                      <% if (locals.expiredDate) { %>
                        <div id="expiredDateAlert" class="alert alert-danger" role="alert">
                            The expiration date must be greater than today.
                        </div>
                        <script>
                            document.addEventListener("DOMContentLoaded", function() {
                                const expiredDateAlert = document.getElementById("expiredDateAlert");
                                if (expiredDateAlert) {
                                    setTimeout(() => {
                                        expiredDateAlert.remove();
                                    }, 1000);
                                }
                            });
                        </script>
                      <% } %>
                    </div>

                    <div class="d-grid">
                      <button class="btn btn-primary" type="submit">
                        Create coupon
                      </button>
                    </div>
                  </form>
                </div>
                <div class="col-md-9">
                  <div class="table-responsive">

                    <% if(couponData && couponData.length> 0 ) { %>

                      <table class="table table-hover">
                        <thead>
                          <tr>
                            <th class="text-center">
                              <div class="form-check"></div>
                            </th>
                            <th>No</th>
                            <th>Coupon name</th>
                            <th>Coupon Code</th>
                            <th>Min purchase (₹)</th>
                            <th>Max Discount (₹)</th>
                            <th>Discount %</th>
                            <th>Expiry Date</th>
                            <th>Redemptions</th>
                            <th>Status</th>
                            <th>Action</th>
                            <th>Remove</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% for(let i=0; i < couponData.length; i++) { 
                              const isPastExpiry = couponData[i].expirationDate && (new Date(couponData[i].expirationDate) < new Date());
                              const expiryStr = couponData[i].expirationDate ? new Date(couponData[i].expirationDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';
                          %>
                            <tr id="coupon-row-<%= couponData[i]._id %>">
                              <td class="text-center">
                                <div class="form-check"></div>
                              </td>
                              <td>
                                <%= i + 1 %>
                              </td>
                              <td><b>
                                  <%= couponData[i].couponName %>
                                </b></td>
                              <td><span class="badge bg-light text-dark font-monospace" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                  <%= couponData[i].couponCode %>
                                </span></td>
                              <td><b>
                                  &#8377; <%= couponData[i].minimumPurchase %>
                                </b></td>
                              <td><b>&#8377; <%= couponData[i].maxDiscount || 0 %></b></td>
                              <td><b>
                                  <%= couponData[i].discountAmount %>%
                                </b></td>
                              <td>
                                <span><%= expiryStr %></span>
                                <% if (isPastExpiry) { %>
                                  <br><span class="badge rounded-pill bg-warning text-dark" style="font-size: 0.75rem;">Expired</span>
                                <% } %>
                              </td>
                              <td>
                                <span class="badge rounded-pill bg-secondary">
                                  <%= (couponData[i].redeemedUsers ? couponData[i].redeemedUsers.length : couponData[i].timesUsed) || 0 %>
                                </span>
                              </td>
                              <td id="status-<%= couponData[i]._id %>">
                                <% if (isPastExpiry) { %>
                                  <span class="badge rounded-pill alert-warning">Expired</span>
                                <% } else if (couponData[i].isActive) { %>
                                  <span class="badge rounded-pill alert-success">Active</span>
                                <% } else { %>
                                  <span class="badge rounded-pill alert-danger">Blocked</span>
                                <% } %>
                              </td>
                              <td id="action-<%= couponData[i]._id %>">
                                <% if(couponData[i].isActive) { %>
                                  <a href="#" class="btn btn-sm font-sm btn-light rounded block-btn"
                                    data-couid="<%= couponData[i]._id %>"
                                    style="background-color: rgb(255, 0, 0); transition: background-color 0.3s;">
                                    <b>Block</b>
                                  </a>
                                  <% } else { %>
                                    <a href="#" class="btn btn-sm font-sm btn-light rounded unblock-btn"
                                      data-couid="<%= couponData[i]._id %>"
                                      style="background-color: #088178; transition: background-color 0.3s;">
                                      Unblock
                                    </a>
                                    <% } %>
                              </td>
                              <td>
                                <a href="#" class="btn btn-sm font-sm btn-light delete-coupon-btn"
                                  data-couid="<%= couponData[i]._id %>"
                                  style="background-color: rgb(255, 0, 0); transition: background-color 0.3s;"
                                  onclick="deleteCoupon('<%= couponData[i]._id %>')">
                                  <i class="material-icons md-delete_forever"></i>
                                  <b>Delete</b>
                                </a>
                              </td>
                            </tr>
                            <% } %>
                        </tbody>
                      </table>

                      <% } %>

                  </div>
                </div>
              </div>
            </div>
          </div>

        </section>
        <!-- content-main end// -->
        <footer class="main-footer font-xs">
          <div class="row pb-30 pt-15">
            <div class="col-sm-6">
              <script>
                document.write(new Date().getFullYear());
              </script>
              ©,BOOK-SAW
            </div>
            <div class="col-sm-6">
              <div class="text-sm-end">All rights reserved</div>
            </div>
          </div>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/public/admin-assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="/public/admin-assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="/public/admin-assets/js/vendors/select2.min.js"></script>
    <script src="/public/admin-assets/js/vendors/perfect-scrollbar.js"></script>
    <script src="/public/admin-assets/js/vendors/jquery.fullscreen.min.js"></script>
    <script src="/public/admin-assets/js/main.js" type="text/javascript"></script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const blockButtons = document.querySelectorAll('.block-btn');
        const unblockButtons = document.querySelectorAll('.unblock-btn');

        blockButtons.forEach(button => {
          button.addEventListener('click', function (event) {
            event.preventDefault();
            const couponId = this.getAttribute('data-couid');
            
            Swal.fire({
              title: 'Are you sure?',
              text: "You are about to block this coupon!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#00d9ff',
              cancelButtonColor: '#888',
              confirmButtonText: 'Yes, block it!',
              cancelButtonText: 'No, keep it',
              background: 'rgba(30, 30, 30, 0.7)',
              color: '#fff',
              iconColor: '#f27474',
              backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
              width: '900px',
              padding: '2rem',
              heightAuto: false,
              height: '400px',
              customClass: {
                popup: 'custom-swal-popup premium-modal',
                loader: 'custom-swal-loader',
              }
            }).then((result) => {
              if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                  title: 'Processing...',
                  text: 'Please wait',
                  allowOutsideClick: false,
                  showConfirmButton: false,
                  willOpen: () => {
                    Swal.showLoading();
                  }
                });

                // Make fetch request
                fetch(`/admin/ToggleblockCoupon?Couid=${couponId}`, {
                  method: 'GET',
                  headers: {
                    'Content-Type': 'application/json',
                  }
                })
                .then(response => {
                  if (!response.ok) {
                    throw new Error('Network response was not ok');
                  }
                  return response.json().catch(() => ({}));
                })
                .then(data => {
                  // Update the UI
                  updateCouponStatus(couponId, false);
                  
                  // Show success message
                  Swal.fire({
                    icon: 'success',
                    title: 'Blocked!',
                    text: 'Coupon has been blocked successfully.',
                    timer: 2000,
                    showConfirmButton: false,
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                })
                .catch(error => {
                  console.error('Error:', error);
                  Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.',
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                });
              }
            });
          });
        });

        unblockButtons.forEach(button => {
          button.addEventListener('click', function (event) {
            event.preventDefault();
            const couponId = this.getAttribute('data-couid');
            
            Swal.fire({
              title: 'Are you sure?',
              text: "You are about to unblock this coupon!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#00d9ff',
              cancelButtonColor: '#888',
              confirmButtonText: 'Yes, Unblock it!',
              cancelButtonText: 'No, keep it',
              background: 'rgba(30, 30, 30, 0.7)',
              color: '#fff',
              iconColor: '#f27474',
              backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
              width: '900px',
              padding: '2rem',
              heightAuto: false,
              height: '400px',
              customClass: {
                popup: 'custom-swal-popup premium-modal',
                loader: 'custom-swal-loader',
              }
            }).then((result) => {
              if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                  title: 'Processing...',
                  text: 'Please wait',
                  allowOutsideClick: false,
                  showConfirmButton: false,
                  willOpen: () => {
                    Swal.showLoading();
                  }
                });

                // Make fetch request
                fetch(`/admin/ToggleblockCoupon?Couid=${couponId}`, {
                  method: 'GET',
                  headers: {
                    'Content-Type': 'application/json',
                  }
                })
                .then(response => {
                  if (!response.ok) {
                    throw new Error('Network response was not ok');
                  }
                  return response.json().catch(() => ({}));
                })
                .then(data => {
                  // Update the UI
                  updateCouponStatus(couponId, true);
                  
                  // Show success message
                  Swal.fire({
                    icon: 'success',
                    title: 'Unblocked!',
                    text: 'Coupon has been unblocked successfully.',
                    timer: 2000,
                    showConfirmButton: false,
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                })
                .catch(error => {
                  console.error('Error:', error);
                  Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.',
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                });
              }
            });
          });
        });
      });

      // Function to update the UI dynamically
      function updateCouponStatus(couponId, isActive) {
        const statusCell = document.getElementById(`status-${couponId}`);
        const actionCell = document.getElementById(`action-${couponId}`);
        
        // Update status badge
        if (isActive) {
          statusCell.innerHTML = '<span class="badge rounded-pill alert-success">Active</span>';
        } else {
          statusCell.innerHTML = '<span class="badge rounded-pill alert-danger">Blocked</span>';
        }
        
        // Update action button
        if (isActive) {
          actionCell.innerHTML = `
            <a href="#" class="btn btn-sm font-sm btn-light rounded block-btn"
              data-couid="${couponId}"
              style="background-color: rgb(255, 0, 0); transition: background-color 0.3s;">
              <b>Block</b>
            </a>
          `;
        } else {
          actionCell.innerHTML = `
            <a href="#" class="btn btn-sm font-sm btn-light rounded unblock-btn"
              data-couid="${couponId}"
              style="background-color: #088178; transition: background-color 0.3s;">
              Unblock
            </a>
          `;
        }

        // Re-attach event listeners to the new buttons
        const newButton = actionCell.querySelector('a');
        if (isActive) {
          newButton.addEventListener('click', function(event) {
            event.preventDefault();
            const id = this.getAttribute('data-couid');
            blockCouponHandler(id);
          });
        } else {
          newButton.addEventListener('click', function(event) {
            event.preventDefault();
            const id = this.getAttribute('data-couid');
            unblockCouponHandler(id);
          });
        }
      }

      // Separate handler functions for block/unblock
      function blockCouponHandler(couponId) {
        Swal.fire({
          title: 'Are you sure?',
          text: "You are about to block this coupon!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#00d9ff',
          cancelButtonColor: '#888',
          confirmButtonText: 'Yes, block it!',
          cancelButtonText: 'No, keep it',
          background: 'rgba(30, 30, 30, 0.7)',
          color: '#fff',
          iconColor: '#f27474',
          backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
          width: '900px',
          padding: '2rem',
          heightAuto: false,
          height: '400px',
          customClass: {
            popup: 'custom-swal-popup premium-modal',
            loader: 'custom-swal-loader',
          }
        }).then((result) => {
          if (result.isConfirmed) {
            Swal.fire({
              title: 'Processing...',
              text: 'Please wait',
              allowOutsideClick: false,
              showConfirmButton: false,
              willOpen: () => {
                Swal.showLoading();
              }
            });

            fetch(`/admin/ToggleblockCoupon?Couid=${couponId}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              }
            })
            .then(response => {
              if (!response.ok) throw new Error('Network response was not ok');
              return response.json().catch(() => ({}));
            })
            .then(data => {
              updateCouponStatus(couponId, false);
              Swal.fire({
                icon: 'success',
                title: 'Blocked!',
                text: 'Coupon has been blocked successfully.',
                timer: 2000,
                showConfirmButton: false,
                background: 'rgba(30, 30, 30, 0.7)',
                color: '#fff',
              });
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Please try again.',
                background: 'rgba(30, 30, 30, 0.7)',
                color: '#fff',
              });
            });
          }
        });
      }

      function unblockCouponHandler(couponId) {
        Swal.fire({
          title: 'Are you sure?',
          text: "You are about to unblock this coupon!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#00d9ff',
          cancelButtonColor: '#888',
          confirmButtonText: 'Yes, Unblock it!',
          cancelButtonText: 'No, keep it',
          background: 'rgba(30, 30, 30, 0.7)',
          color: '#fff',
          iconColor: '#f27474',
          backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
          width: '900px',
          padding: '2rem',
          heightAuto: false,
          height: '400px',
          customClass: {
            popup: 'custom-swal-popup premium-modal',
            loader: 'custom-swal-loader',
          }
        }).then((result) => {
          if (result.isConfirmed) {
            Swal.fire({
              title: 'Processing...',
              text: 'Please wait',
              allowOutsideClick: false,
              showConfirmButton: false,
              willOpen: () => {
                Swal.showLoading();
              }
            });

            fetch(`/admin/ToggleblockCoupon?Couid=${couponId}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              }
            })
            .then(response => {
              if (!response.ok) throw new Error('Network response was not ok');
              return response.json().catch(() => ({}));
            })
            .then(data => {
              updateCouponStatus(couponId, true);
              Swal.fire({
                icon: 'success',
                title: 'Unblocked!',
                text: 'Coupon has been unblocked successfully.',
                timer: 2000,
                showConfirmButton: false,
                background: 'rgba(30, 30, 30, 0.7)',
                color: '#fff',
              });
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Please try again.',
                background: 'rgba(30, 30, 30, 0.7)',
                color: '#fff',
              });
            });
          }
        });
      }
    </script>

    <% if(locals.couponExists) { %>
      <script>
        Swal.fire({
          icon: 'warning',
          title: 'coupon already exists!',
          background: 'rgba(30, 30, 30, 0.7)',
          color: '#fff',
          iconColor: '#f27474',
          backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
          width: '900px',
          padding: '2rem',
          heightAuto: false,
          height: '400px',
          customClass: {
            popup: 'custom-swal-popup premium-modal',
            loader: 'custom-swal-loader',
          }
        })
      </script>
    <% } %>

    <!--deletecoupon -->
    <script>
      function deleteCoupon(event) {
        const url = `/admin/couponDelete?id=${event}`;
        fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            toastr.success(data.message);
            setTimeout(() => {
              window.location.reload()
            }, 1000)
          } else {
            toastr.error(data.message);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          toastr.error('An error occurred while deleting the coupon.');
        });
      }
    </script>

    <!-- validateCoupon -->
    <script>
      // Automatically uppercase and remove spaces from coupon code input
      const couponCodeInput = document.getElementById('couponCode');
      if (couponCodeInput) {
        couponCodeInput.addEventListener('input', () => {
          couponCodeInput.value = couponCodeInput.value.replace(/\s/g, '').toUpperCase();
        });
      }
    </script>

</body>
