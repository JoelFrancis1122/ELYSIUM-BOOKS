      <button type="submit"><i class="fas fa-search"></i></button>
    </form>

    <nav class="bk-drawer-nav">
      <a href="/home" onclick="closeDrawer()"><i class="fas fa-house"></i> Home</a>
      <a href="/loadShop" onclick="closeDrawer()"><i class="fas fa-shop"></i> Shop</a>
      <a href="/loadProfile" onclick="closeDrawer()"><i class="fas fa-user"></i> Profile</a>
      <a href="/getWishlist" onclick="closeDrawer()">
