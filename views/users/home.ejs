    <!-- Scripts -->
    <script>
        // ── Add to Cart ─────────────────────────────────────────────
        async function addToCart(productId, evt) {
            const btn = (evt && evt.target) ? evt.target.closest('button') : (window.event && window.event.target ? window.event.target.closest('button') : document.getElementById('add-cart-' + productId));
            const origHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            }

            try {
                const res = await fetch('/addToCart?id=' + productId, { method: 'GET' });
                if (res.status === 401) {
                    toastr.warning('Please sign in to add books to your cart!');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                    return;
                }
                if (!res.ok) {
                    const errData = await res.json().catch(() => ({}));
                    toastr.error(errData.error || 'Could not add to cart.');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    const isNew = window.updateCartBadge ? window.updateCartBadge(productId, data) : true;
                    toastr.success(isNew ? 'Added to cart!' : 'Cart updated!');
                    if (btn) {
                        btn.innerHTML = '<i class="fas fa-check"></i> ' + (isNew ? 'Added' : 'Updated');
                        setTimeout(() => {
                            btn.disabled = false;
                            btn.innerHTML = origHtml;
                        }, 1400);
                    }
                } else {
                    toastr.error(data.error || 'Could not add to cart.');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                }
            } catch (err) {
                toastr.error('Stock limit exceeded.');
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

        // ── Quote Carousel ──────────────────────────────────────────
        const FALLBACK_QUOTES = [
            { content: "A reader lives a thousand lives before he dies. The man who never reads lives only one.", author: "George R.R. Martin" },
            { content: "There is no friend as loyal as a book.", author: "Ernest Hemingway" },
            { content: "Not all those who wander are lost.", author: "J.R.R. Tolkien" },
            { content: "It does not do to dwell on dreams and forget to live.", author: "J.K. Rowling" },
        ];

        async function fetchQuotes() {
            try {
                const ps = FALLBACK_QUOTES.map(() => fetch('https://dummyjson.com/quotes/random'));
                const rs = await Promise.all(ps);
                const out = [];
                for (const r of rs) {
                    if (r.ok) { const d = await r.json(); out.push({ content: d.quote, author: d.author }); }
                }
                return out.length > 0 ? out : FALLBACK_QUOTES;
            } catch { return FALLBACK_QUOTES; }
        }

        async function initQuoteCarousel() {
            const slidesEl = document.getElementById('bk-quote-slides');
            const dotsEl   = document.getElementById('bk-quote-dots');
            if (!slidesEl || !dotsEl) return;
            const quotes = await fetchQuotes();
            let cur = 0, timer;

            quotes.forEach((q, i) => {
                const s = document.createElement('div');
                s.className = 'bk-quote-slide' + (i === 0 ? ' active' : '');
                s.innerHTML = '<p class="bk-quote-text">' + q.content + '</p><div class="bk-quote-author">' + q.author + '</div>';
                slidesEl.appendChild(s);

                const d = document.createElement('button');
                d.className = 'bk-quote-dot' + (i === 0 ? ' active' : '');
                d.addEventListener('click', () => goTo(i));
                dotsEl.appendChild(d);
            });

            function goTo(idx) {
                slidesEl.querySelectorAll('.bk-quote-slide')[cur].classList.remove('active');
                dotsEl.querySelectorAll('.bk-quote-dot')[cur].classList.remove('active');
                cur = idx;
                slidesEl.querySelectorAll('.bk-quote-slide')[cur].classList.add('active');
                dotsEl.querySelectorAll('.bk-quote-dot')[cur].classList.add('active');
            }

            timer = setInterval(() => goTo((cur + 1) % quotes.length), 6000);
            const card = document.getElementById('bk-quote-slides');
            if (card) {
                card.parentElement.addEventListener('mouseenter', () => clearInterval(timer));
                card.parentElement.addEventListener('mouseleave', () => { timer = setInterval(() => goTo((cur + 1) % quotes.length), 6000); });
            }
        }

        // ── Mini Calendar ───────────────────────────────────────────
        function initCalendar() {
            const el = document.getElementById('bk-cal-days');
            if (!el) return;
            const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const today = new Date();
            const todayDay = today.getDay(); // Sunday = 0
            // Show 7 days starting from the beginning of this week (Sun)
            const startOfWeek = new Date(today);
            startOfWeek.setDate(today.getDate() - todayDay);

            for (let i = 0; i < 7; i++) {
                const d = new Date(startOfWeek);
                d.setDate(startOfWeek.getDate() + i);
                const isToday = d.toDateString() === today.toDateString();
                const div = document.createElement('div');
                div.className = 'bk-cal-day' + (isToday ? ' bk-cal-day-active' : '');
                div.innerHTML = '<span>' + days[i].slice(0,3) + '</span><strong>' + d.getDate() + '</strong>';
                el.appendChild(div);
            }
        }

        // ── View toggle ──────────────────────────────
        function setView(mode) {
            const grid = document.getElementById('bk-grid');
            const gridBtn = document.getElementById('grid-view-btn');
            const listBtn = document.getElementById('list-view-btn');
            if (!grid) return;
            if (mode === 'list') {
                grid.classList.add('list-view');
                if (listBtn) listBtn.classList.add('active');
                if (gridBtn) gridBtn.classList.remove('active');
                localStorage.setItem('bk-home-view', 'list');
            } else {
                grid.classList.remove('list-view');
                if (gridBtn) gridBtn.classList.add('active');
                if (listBtn) listBtn.classList.remove('active');
                localStorage.setItem('bk-home-view', 'grid');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initQuoteCarousel();
            initCalendar();
            const saved = localStorage.getItem('bk-home-view');
            if (saved === 'list') setView('list');
        });
    </script>

