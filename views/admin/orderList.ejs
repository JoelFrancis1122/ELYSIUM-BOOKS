<body>
  <div class="screen-overlay"></div>
  <%-include('../partials/adminAside')-%>
    <main class="main-wrap">
      <%-include('../partials/adminHeader')-%>
        <section class="content-main">
          <div class="content-header">
            <div>
              <h2 class="content-title card-title">Order List</h2>
              <p>Lorem ipsum dolor sit amet.</p>
            </div>
          </div>
          <div class="card mb-4">
            <div class="card-body">
              <div class="table-responsive">

                <table id="example" class="display" style="width:1200px;height:600px" >
                  <% if(orders && orders.length > 0) { %>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Total Amount</th>
                            <th>Payment Method</th>
                            <th>Date & Time</th>
                            <th>Payment Status</th>
                            <th>Order Status</th>
                            <th>Change Status</th>
                            <th class="text-end">Order Details</th>
                        </tr>
                    </thead>
                    <tbody>
                      <% for(let i = orders.length - 1; i >= 0; i--) { 
                        const order = orders[i];
                    %>
            
                            <tr id="order-row-<%= order._id %>">
                                <td><%= order.orderId %></td>
                                <td>&#8377;<%= order.totalAmount %></td>
                                <td><%= order.paymentMethod %></td>
                                <td><%= order.orderDate.toLocaleString() %></td>
                                <td>
                                    <span class="badge <%= order.paymentStatus === 'Received' ? 'bg-success-light' : 'bg-warning-light' %> text-dark">
                                        <%= order.paymentStatus %>
                                    </span>
                                </td>
                                <td id="order-status-<%= order._id %>">
                                  <% if (order.paymentStatus !== 'Failed') { %>
                                    <span class="badge <%= order.orderStatus === 'Shipped' ? 'bg-primary-light' : 
                                                          (order.orderStatus === 'Returned' ? 'bg-secondary-light' : 
                                                          (order.orderStatus === 'Cancelled' ? 'bg-danger-light' : 
                                                          (order.orderStatus === 'Delivered' ? 'bg-success-light' : 'bg-warning-light'))) %> text-dark">
                                        <%= order.orderStatus %>
                                    </span>
                                <% } %>
                                </td>
                                <td id="change-status-<%= order._id %>">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-icon dropdown-toggle" type="button"
                                            id="deliveryStatusDropdown_<%= order._id %>" data-bs-toggle="dropdown" aria-expanded="false"
                                            <% if (order.orderStatus === 'Delivered' || order.orderStatus === 'Returned' || order.orderStatus === 'Cancelled'|| order.paymentStatus === "Failed") { %>
                                                disabled
                                            <% } %>
                                            <b>Status</b>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-sm" aria-labelledby="deliveryStatusDropdown_<%= order._id %>">
                                            <li><a class="dropdown-item status-change-link" href="#" data-order-id="<%= order._id %>" data-status="Order Placed" data-route="/admin/adminOrderpending">Order Placed</a></li>
                                            <li><a class="dropdown-item status-change-link" href="#" data-order-id="<%= order._id %>" data-status="Shipped" data-route="/admin/adminOrderShipped">Shipped</a></li>
                                            <li><a class="dropdown-item status-change-link" href="#" data-order-id="<%= order._id %>" data-status="Delivered" data-route="/admin/adminOrderDelivered">Delivered</a></li>
                                            <li><a class="dropdown-item status-change-link" href="#" data-order-id="<%= order._id %>" data-status="Cancelled" data-route="/admin/adminOrderCancelled">Cancelled</a></li>
                                            <li><a class="dropdown-item status-change-link" href="#" data-order-id="<%= order._id %>" data-status="Returned" data-route="/admin/adminOrderReturned">Returned</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="/admin/loadOrderDetails?id=<%=order._id%>" class="btn btn-sm btn-outline-dark">Order Detail</a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                <% } else { %>
                    <h3 style="font-size: 28px; font-weight: bold; color: #000000; text-transform: uppercase; border-bottom: 2px solid #007bff; padding-bottom: 5px;">No orders found</h3>
                <% } %>
                </table>

            </div>
          </div>
          </div>

        </section>
        <footer class="main-footer font-xs">
          <div class="row pb-30 pt-15">
