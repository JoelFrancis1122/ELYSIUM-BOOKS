    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>


    <script>
      let dataTable;
      $(document).ready(function() {
        dataTable = new DataTable('#example', {
          order: false
        });
      });
    </script>


    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // Get all status change links
        const statusChangeLinks = document.querySelectorAll('.status-change-link');
        
        statusChangeLinks.forEach(link => {
          link.addEventListener('click', function (event) {
            event.preventDefault();
            
            const orderId = this.getAttribute('data-order-id');
            const newStatus = this.getAttribute('data-status');
            const route = this.getAttribute('data-route');
            
            // Show confirmation dialog
            Swal.fire({
              title: 'Are you sure?',
              text: `You are about to change this order status to "${newStatus}"`,
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#00d9ff',
              cancelButtonColor: '#888',
              confirmButtonText: 'Yes, change it!',
              cancelButtonText: 'No, cancel',
              background: 'rgba(30, 30, 30, 0.7)',
              color: '#fff',
              iconColor: '#f27474',
              backdrop: `rgba(0,0,0,0.6) left top no-repeat`,
            }).then((result) => {
              if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                  title: 'Processing...',
                  text: 'Please wait',
                  allowOutsideClick: false,
                  showConfirmButton: false,
                  willOpen: () => {
                    Swal.showLoading();
                  }
                });

                // Make fetch request
                fetch(`${route}?id=${orderId}`, {
                  method: 'GET',
                  headers: {
                    'Content-Type': 'application/json',
                  }
                })
                .then(response => {
                  if (!response.ok) {
                    throw new Error('Network response was not ok');
                  }
                  return response.json().catch(() => ({ success: true }));
                })
                .then(data => {
                  // Update the UI
                  updateOrderStatus(orderId, newStatus);
                  
                  // Show success message
                  Swal.fire({
                    icon: 'success',
                    title: 'Updated!',
                    text: `Order status changed to "${newStatus}" successfully.`,
                    timer: 2000,
                    showConfirmButton: false,
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                })
                .catch(error => {
                  console.error('Error:', error);
                  Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.',
                    background: 'rgba(30, 30, 30, 0.7)',
                    color: '#fff',
                  });
                });
              }
            });
          });
        });
      });

      // Function to update order status in the UI
      function updateOrderStatus(orderId, newStatus) {
        const statusCell = document.getElementById(`order-status-${orderId}`);
        const changeStatusCell = document.getElementById(`change-status-${orderId}`);
        
        // Determine badge class based on status
        let badgeClass = 'bg-warning-light';
        if (newStatus === 'Shipped') {
          badgeClass = 'bg-primary-light';
        } else if (newStatus === 'Delivered') {
          badgeClass = 'bg-success-light';
        } else if (newStatus === 'Cancelled') {
          badgeClass = 'bg-danger-light';
        } else if (newStatus === 'Returned') {
          badgeClass = 'bg-secondary-light';
        }
        
        statusCell.innerHTML = `<span class="badge ${badgeClass} text-dark">${newStatus}</span>`;
        
        // Disable dropdown if status is terminal (Delivered, Returned, or Cancelled)
        if (newStatus === 'Delivered' || newStatus === 'Returned' || newStatus === 'Cancelled') {
          const dropdownButton = changeStatusCell.querySelector('button');
          if (dropdownButton) {
            dropdownButton.setAttribute('disabled', 'disabled');
          }
        }
      }
    </script>

</body>

