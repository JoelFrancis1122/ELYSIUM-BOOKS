<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Cart — BOOKSAW</title>
    <meta name="description" content="Your BOOKSAW shopping cart">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
<style>
:root {
  --canvas:#f5f0e8; --bg:#faf8f4; --fg:#2d2820;
  --hi:#b8542a; --muted:#7a6f60;
  --border:#ddd8ce; --sec:#edeae2;
  --r-sm:8px; --r-md:14px; --r-lg:20px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'IBM Plex Sans',sans-serif;background:var(--canvas);color:var(--fg)}

/* BREADCRUMB */
.bk-crumb{background:var(--bg);border-bottom:1px solid var(--border);padding:14px 0}
.bk-crumb-inner{max-width:1200px;margin:0 auto;padding:0 40px;display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--muted)}
.bk-crumb-inner a{color:var(--muted);text-decoration:none;transition:color .2s}
.bk-crumb-inner a:hover{color:var(--hi)}
.bk-crumb-sep{font-size:.68rem;color:var(--border)}
.bk-crumb-cur{color:var(--fg);font-weight:600}

/* PAGE LAYOUT */
.bk-cart-page{max-width:1200px;margin:0 auto;padding:36px 40px 80px;display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}
.bk-cart-page-title{font-family:'Libre Baskerville',serif;font-size:1.5rem;font-weight:700;color:var(--fg);grid-column:1/-1;padding-bottom:10px;border-bottom:2px solid var(--border);margin-bottom:4px;display:flex;align-items:baseline;gap:12px}
.bk-cart-count{font-family:'IBM Plex Sans',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}

/* PANEL */
.bk-panel{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden}
.bk-panel-head{padding:16px 22px;border-bottom:1px solid var(--border);font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg);display:flex;align-items:center;gap:9px}
.bk-panel-head i{color:var(--hi);font-size:.85rem}

/* CART ITEM ROWS */
.bk-cart-item{display:grid;grid-template-columns:80px 1fr auto;gap:18px;align-items:center;padding:18px 22px;border-bottom:1px solid var(--border);transition:background .18s}
.bk-cart-item:last-child{border-bottom:none}
.bk-cart-item:hover{background:rgba(245,240,232,.5)}

.bk-item-cover{width:80px;height:114px;border-radius:6px;object-fit:cover;flex-shrink:0;box-shadow:inset 4px 0 8px rgba(45,40,32,.1),3px 5px 14px rgba(45,40,32,.12)}

.bk-item-meta{min-width:0}
.bk-item-genre{font-size:.65rem;font-weight:600;letter-spacing:1.3px;text-transform:uppercase;color:var(--hi);opacity:.85;margin-bottom:4px}
.bk-item-title{font-family:'Libre Baskerville',serif;font-size:.9rem;font-weight:700;color:var(--fg);text-decoration:none;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:10px;display:block}
.bk-item-title:hover{color:var(--hi)}
.bk-item-price{font-size:.84rem;color:var(--fg);margin-bottom:10px}
.bk-item-price-lbl{color:var(--muted);font-size:.8rem;margin-right:4px}

/* QTY */
.bk-qty{display:inline-flex;align-items:center;border:1.5px solid var(--border);border-radius:var(--r-sm);overflow:hidden;background:var(--canvas)}
.bk-qty-btn{width:32px;height:32px;border:none;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--fg);font-size:.75rem;transition:background .18s,color .18s}
.bk-qty-btn:hover{background:var(--fg);color:#fff}
.bk-qty-val{min-width:32px;text-align:center;font-size:.88rem;font-weight:700;color:var(--fg);padding:0 4px;border-left:1px solid var(--border);border-right:1px solid var(--border);line-height:32px}

/* RIGHT */
.bk-item-right{display:flex;flex-direction:column;align-items:flex-end;gap:12px;flex-shrink:0}
.bk-item-subtotal{font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg)}
.bk-remove-btn{background:none;border:none;cursor:pointer;color:var(--muted);font-size:.78rem;display:flex;align-items:center;gap:5px;padding:5px 8px;border-radius:var(--r-sm);transition:background .18s,color .18s}
.bk-remove-btn:hover{background:rgba(185,28,28,.07);color:#b91c1c}

/* EMPTY */
.bk-cart-empty{text-align:center;padding:60px 30px}
.bk-cart-empty-icon{font-size:3rem;opacity:.2;margin-bottom:14px;color:var(--fg)}
.bk-cart-empty-title{font-family:'Libre Baskerville',serif;font-size:1.1rem;color:var(--fg);margin-bottom:6px}
.bk-cart-empty-sub{font-size:.84rem;color:var(--muted);margin-bottom:22px}

/* FOOTER STRIP */
.bk-cart-footer{padding:14px 22px;background:var(--sec);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:flex-start}

/* BUTTONS */
.bk-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;font-family:'IBM Plex Sans',sans-serif;font-size:.84rem;font-weight:600;border-radius:var(--r-sm);text-decoration:none;cursor:pointer;transition:all .18s;border:1.5px solid transparent;white-space:nowrap}
.bk-btn-dark{background:var(--fg);color:#fff;border-color:var(--fg)}
.bk-btn-dark:hover{background:var(--hi);border-color:var(--hi)}
.bk-btn-outline{background:none;color:var(--fg);border-color:var(--border)}
.bk-btn-outline:hover{border-color:var(--hi);color:var(--hi)}
.bk-btn-full{width:100%;justify-content:center}

/* SUMMARY */
.bk-summary{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;position:sticky;top:88px}
.bk-summary-head{padding:18px 22px;border-bottom:1px solid var(--border);font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg);display:flex;align-items:center;gap:9px}
.bk-summary-head i{color:var(--hi);font-size:.85rem}
.bk-summary-body{padding:20px 22px}
.bk-summary-row{display:flex;align-items:center;justify-content:space-between;font-size:.85rem;padding:9px 0;border-bottom:1px solid var(--border)}
.bk-summary-row:last-of-type{border-bottom:none}
.bk-summary-label{color:var(--muted)}
.bk-summary-val{font-weight:600;color:var(--fg)}
.bk-summary-total{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;background:var(--fg);color:#fff}
.bk-summary-total-label{font-size:.88rem;font-weight:600;opacity:.65}
.bk-summary-total-val{font-family:'Libre Baskerville',serif;font-size:1.3rem;font-weight:700}
.bk-summary-cta{padding:16px 22px;display:flex;flex-direction:column;gap:10px}
.bk-note{font-size:.75rem;color:var(--muted);display:flex;align-items:center;gap:5px;justify-content:center}

/* RESPONSIVE */
@media(max-width:900px){
  .bk-cart-page{grid-template-columns:1fr;padding:22px 20px 60px}
  .bk-summary{position:static}
  .bk-cart-page-title{grid-column:1}
}
@media(max-width:560px){
  .bk-crumb-inner{padding:0 16px}
  .bk-cart-item{grid-template-columns:64px 1fr;}
  .bk-item-right{grid-column:1/-1;flex-direction:row;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding-top:12px}
  .bk-item-cover{width:64px;height:90px}
}
</style>
</head>
<body>
<%- include('../partials/userHeader') %>

<!-- Breadcrumb -->
<div class="bk-crumb">
  <div class="bk-crumb-inner">
    <a href="/home">Home</a>
    <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:.65rem"></i></span>
    <a href="/loadShop">Shop</a>
    <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:.65rem"></i></span>
    <span class="bk-crumb-cur">Cart</span>
  </div>
</div>

<div class="bk-cart-page">
  <h1 class="bk-cart-page-title">
    Your Cart
    <% if(locals.cartData && cartData.product.length > 0) { %>
      <span class="bk-cart-count"><%= cartData.product.length %> item<%= cartData.product.length !== 1 ? 's' : '' %></span>
    <% } %>
  </h1>

  <!-- ITEMS PANEL -->
  <div class="bk-panel">
    <div class="bk-panel-head"><i class="fas fa-shopping-bag"></i> Order Items</div>
    <div id="cart-tbody">
      <% if(locals.cartData && cartData.product.length > 0) { %>
        <% for(let i = 0; i < cartData.product.length; i++) { 
             if(!cartData.product[i] || !cartData.product[i].productId) continue;
             const pObj = cartData.product[i].productId;
             const pId = (pObj._id || pObj.id || pObj).toString();
             const pStock = pObj.stock !== undefined ? pObj.stock : 999;
             const pPrice = Number(pObj.saleprice) || 0;
             const pQty = Number(cartData.product[i].quantity) || 1;
             const pTitle = pObj.Bookname || 'Book';
             const pImg = (pObj.Images && pObj.Images.length > 0) ? '/public/uploads/' + pObj.Images[0] : '/public/spellbook.png';
             const pCat = (pObj.Categories && pObj.Categories.categoryName) ? pObj.Categories.categoryName : 'Book';
        %>
          <div class="bk-cart-item" id="row_<%= pId %>">
            <span id="stock_<%= pId %>" style="display:none"><%= pStock %></span>

            <img class="bk-item-cover"
                 src="<%= pImg %>"
                 alt="<%= pTitle %>">

            <div class="bk-item-meta">
              <div class="bk-item-genre"><%= pCat %></div>
              <a href="/shop-product?id=<%= pId %>" class="bk-item-title"><%= pTitle %></a>
              <div class="bk-item-price">
                <span class="bk-item-price-lbl">Unit</span>
                <strong><span id="saleprice_<%= pId %>">&#8377;<%= pPrice.toFixed(2) %></span></strong>
              </div>
              <div class="bk-qty">
                <button class="bk-qty-btn" onclick="decrease('<%= pId %>')">
                  <i class="fas fa-minus" style="font-size:.7rem"></i>
                </button>
                <span class="bk-qty-val" id="quantity_<%= pId %>"><%= pQty %></span>
                <button class="bk-qty-btn" onclick="increase('<%= pId %>')">
                  <i class="fas fa-plus" style="font-size:.7rem"></i>
                </button>
              </div>
            </div>

            <div class="bk-item-right">
              <span class="bk-item-subtotal" id="subtotal_<%= pId %>">
                &#8377;<%= (pPrice * pQty).toFixed(2) %>
              </span>
              <button class="bk-remove-btn" onclick="removeItem('<%= pId %>')">
                <i class="fas fa-trash"></i> Remove
              </button>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="bk-cart-empty" id="empty-cart-row">
          <div class="bk-cart-empty-icon"><i class="fas fa-basket-shopping"></i></div>
          <div class="bk-cart-empty-title">Your cart is empty</div>
          <p class="bk-cart-empty-sub">Add books from the shop to get started.</p>
          <a href="/loadShop" class="bk-btn bk-btn-dark"><i class="fas fa-compass"></i> Explore Books</a>
        </div>
      <% } %>
    </div>
    <div class="bk-cart-footer">
      <a href="/loadShop" class="bk-btn bk-btn-outline"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
    </div>
  </div>

  <!-- ORDER SUMMARY -->
  <div class="bk-summary">
    <div class="bk-summary-head"><i class="fas fa-receipt"></i> Order Summary</div>
    <div class="bk-summary-body">
      <div class="bk-summary-row">
        <span class="bk-summary-label">Subtotal</span>
        <span class="bk-summary-val" id="summarySubtotal">&#8377;0.00</span>
      </div>
      <div class="bk-summary-row">
        <span class="bk-summary-label">Shipping</span>
        <span class="bk-summary-val" style="color:#16a34a">Free</span>
      </div>
      <div class="bk-summary-row">
        <span class="bk-summary-label">Tax</span>
        <span class="bk-summary-val">—</span>
      </div>
    </div>
    <div class="bk-summary-total">
      <span class="bk-summary-total-label">Total</span>
      <span class="bk-summary-total-val" id="totalPrice">&#8377;0.00</span>
    </div>
    <div class="bk-summary-cta">
      <% if(locals.cartData && cartData.product.length > 0) { %>
        <a href="/loadCheckOut" class="bk-btn bk-btn-dark bk-btn-full">
          <i class="fas fa-lock"></i> Proceed to Checkout
        </a>
      <% } else { %>
        <button class="bk-btn bk-btn-dark bk-btn-full" onclick="showEmptyCartMessage()">
          <i class="fas fa-lock"></i> Proceed to Checkout
        </button>
      <% } %>
      <a href="/loadShop" class="bk-btn bk-btn-outline bk-btn-full"><i class="fas fa-shop"></i> Keep Shopping</a>
      <p class="bk-note"><i class="fas fa-shield-halved"></i> Secure &amp; encrypted checkout</p>
    </div>
  </div>

</div>

<%- include('../partials/userFooter') %>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 1400, extendedTimeOut: 400, showDuration: 150, hideDuration: 180, preventDuplicates: true, newestOnTop: true };

function parseRupee(str) {
  return parseFloat(String(str).replace(/[^0-9.]/g,'')) || 0;
}
function formatRupee(n) {
  return '\u20b9' + parseFloat(n).toFixed(2);
}
function updateTotalPrice() {
  let total = 0;
  document.querySelectorAll('[id^="subtotal_"]').forEach(el => { total += parseRupee(el.textContent); });
  const fmt = formatRupee(total);
  const tp = document.getElementById('totalPrice');
  const ss = document.getElementById('summarySubtotal');
  if(tp) tp.textContent = fmt;
  if(ss) ss.textContent = fmt;
}
function showEmptyCartMessage() { toastr.error('Your cart is empty'); }

function increase(productId) {
  const qEl = document.getElementById('quantity_' + productId);
  const stEl = document.getElementById('stock_' + productId);
  const curQty = parseInt(qEl.textContent) || 1;
  const stock = stEl ? parseInt(stEl.textContent) : 999;
  if(curQty >= stock) { toastr.error('Maximum stock limit reached.'); return; }

  fetch('/updateCart', { 
    method:'POST', 
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ productId, quantity: 1 }) 
  })
  .then(async r => {
    const data = await r.json().catch(() => ({}));
    if(r.ok && data.success !== false) {
      const nextQty = data.newQuantity !== undefined ? data.newQuantity : curQty + 1;
      qEl.textContent = nextQty;
      const sp = parseRupee(document.getElementById('saleprice_' + productId).textContent);
      document.getElementById('subtotal_' + productId).textContent = formatRupee(sp * nextQty);
      updateTotalPrice();
      toastr.success('Quantity updated');
    } else { 
      toastr.error(data.message || 'Failed to update quantity'); 
    }
  }).catch(e => toastr.error('Error: ' + e.message));
}

function decrease(productId) {
  const qEl = document.getElementById('quantity_' + productId);
  const curQty = parseInt(qEl.textContent) || 1;
  if(curQty <= 1) { toastr.warning('Minimum quantity is 1.'); return; }

  fetch('/updateCart', { 
    method:'POST', 
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ productId, quantity: -1 }) 
  })
  .then(async r => {
    const data = await r.json().catch(() => ({}));
    if(r.ok && data.success !== false) {
      const nextQty = data.newQuantity !== undefined ? data.newQuantity : curQty - 1;
      qEl.textContent = nextQty;
      const sp = parseRupee(document.getElementById('saleprice_' + productId).textContent);
      document.getElementById('subtotal_' + productId).textContent = formatRupee(sp * nextQty);
      updateTotalPrice();
      toastr.success('Quantity updated');
    } else { 
      toastr.error(data.message || 'Failed to update quantity'); 
    }
  }).catch(e => toastr.error('Error: ' + e.message));
}

function removeItem(productId) {
  fetch('/removeItem', { 
    method:'POST', 
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ productId }) 
  })
  .then(async r => {
    const data = await r.json().catch(() => ({}));
    if(r.ok && data.success !== false) {
      const row = document.getElementById('row_' + productId);
      if(row) row.remove();
      updateTotalPrice();
      toastr.success('Item removed from cart.');
      const tbody = document.getElementById('cart-tbody');
      if(tbody && !tbody.querySelector('.bk-cart-item')) {
        tbody.innerHTML = '<div class="bk-cart-empty" id="empty-cart-row">' +
          '<div class="bk-cart-empty-icon"><i class="fas fa-basket-shopping"></i></div>' +
          '<div class="bk-cart-empty-title">Your cart is empty</div>' +
          '<p class="bk-cart-empty-sub">Add books from the shop to get started.</p>' +
          '<a href="/loadShop" class="bk-btn bk-btn-dark"><i class="fas fa-compass"></i> Explore Books</a>' +
          '</div>';
        const coBtn = document.querySelector('.bk-summary-cta a[href="/loadCheckOut"]');
        if(coBtn) coBtn.outerHTML = '<button class="bk-btn bk-btn-dark bk-btn-full" onclick="showEmptyCartMessage()"><i class="fas fa-lock"></i> Proceed to Checkout</button>';
      }
    } else { 
      toastr.error(data.message || 'Failed to remove item.'); 
    }
  }).catch(e => toastr.error('Error: ' + e.message));
}

updateTotalPrice();
</script>
</body>
</html>