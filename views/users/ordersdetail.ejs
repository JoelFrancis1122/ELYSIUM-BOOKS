<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
  <meta charset="utf-8">
  <title>Order Details — BOOKSAW</title>
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="description" content="View your order summary and delivery updates on BOOKSAW">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">

  <!-- Google Fonts: Warm Literary Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- CSS Framework & Icons -->
  <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <style>
    /* ============================================================
       BOOKSAW ORDER DETAILS — WARM LITERARY DESIGN SYSTEM
       Harmonized with Home, Shop, Cart, and Checkout
       ============================================================ */
    :root {
      --canvas: #f5f0e8;
      --bg: #faf8f4;
      --fg: #2d2820;
      --hi: #b8542a;
      --hi-light: #d4673a;
      --muted: #7a6f60;
      --border: #ddd8ce;
      --sec: #edeae2;
      --card: #ffffff;
      --green: #16a34a;
      --red: #b91c1c;
      --blue: #2563eb;
      --purple: #7c3aed;
      --r-sm: 8px;
      --r-md: 14px;
      --r-lg: 20px;
      --shadow-sm: 0 2px 8px rgba(45, 40, 32, 0.06);
      --shadow-md: 0 8px 24px rgba(45, 40, 32, 0.08);
      --shadow-cover: 0 10px 18px rgba(45, 40, 32, 0.16);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'IBM Plex Sans', sans-serif;
      background: var(--canvas);
      color: var(--fg);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── BREADCRUMB ── */
    .bk-crumb {
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
    }
    .bk-crumb-inner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 40px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: .82rem;
      color: var(--muted);
    }
    .bk-crumb-inner a {
      color: var(--muted);
      text-decoration: none;
      transition: color .2s;
    }
    .bk-crumb-inner a:hover {
      color: var(--hi);
    }
    .bk-crumb-sep {
      font-size: .65rem;
      color: var(--border);
    }
    .bk-crumb-cur {
      color: var(--fg);
      font-weight: 600;
    }

    /* ── PAGE CONTAINER ── */
    .bk-order-wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding: 34px 40px 80px;
    }

    /* ── ORDER HEADER BANNER ── */
    .bk-order-header {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 26px 32px;
      margin-bottom: 24px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      box-shadow: var(--shadow-sm);
    }
    .bk-order-title-group h1 {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--fg);
      margin-bottom: 8px;
      letter-spacing: -0.3px;
    }
    .bk-order-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      font-size: .84rem;
      color: var(--muted);
    }
    .bk-order-meta i {
      color: var(--hi);
      margin-right: 4px;
    }

    /* Status Pills */
    .bk-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .5px;
      text-transform: uppercase;
    }
    .bk-pill-pend { background: rgba(217, 119, 6, 0.12); color: #d97706; }
    .bk-pill-ship { background: rgba(37, 99, 235, 0.12); color: #2563eb; }
    .bk-pill-del { background: rgba(22, 163, 74, 0.12); color: #16a34a; }
    .bk-pill-can { background: rgba(185, 28, 28, 0.12); color: #b91c1c; }
    .bk-pill-ret { background: rgba(100, 116, 139, 0.14); color: #64748b; }
    .bk-pill-recv { background: rgba(22, 163, 74, 0.12); color: #16a34a; }
    .bk-pill-fail { background: rgba(185, 28, 28, 0.12); color: #b91c1c; }
    .bk-pill-ref { background: rgba(124, 58, 237, 0.12); color: #7c3aed; }

    .bk-order-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* ── TRACKER CARD ── */
    .bk-tracker-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 24px 32px;
      margin-bottom: 26px;
      box-shadow: var(--shadow-sm);
    }
    .bk-tracker-title {
      font-family: 'Libre Baskerville', serif;
      font-size: .95rem;
      font-weight: 700;
      color: var(--fg);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .bk-tracker-title i {
      color: var(--hi);
      font-size: .88rem;
    }

    .bk-tracker-steps {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }
    .bk-tracker-line {
      position: absolute;
      top: 18px;
      left: 40px;
      right: 40px;
      height: 3px;
      background: var(--border);
      z-index: 1;
    }
    .bk-tracker-progress {
      position: absolute;
      top: 18px;
      left: 40px;
      height: 3px;
      background: var(--hi);
      z-index: 2;
      transition: width .4s ease;
    }
    .bk-tracker-step {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100px;
    }
    .bk-tracker-node {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--border);
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .82rem;
      font-weight: 600;
      transition: all .2s;
      margin-bottom: 8px;
    }
    .bk-tracker-step.completed .bk-tracker-node {
      background: var(--hi);
      border-color: var(--hi);
      color: #fff;
    }
    .bk-tracker-step.active .bk-tracker-node {
      background: var(--bg);
      border-color: var(--hi);
      color: var(--hi);
      box-shadow: 0 0 0 4px rgba(184, 84, 42, 0.16);
    }
    .bk-tracker-label {
      font-size: .78rem;
      font-weight: 600;
      color: var(--muted);
      white-space: nowrap;
    }
    .bk-tracker-step.completed .bk-tracker-label,
    .bk-tracker-step.active .bk-tracker-label {
      color: var(--fg);
    }

    /* Cancelled / Returned Tracker Banner */
    .bk-status-banner {
      background: rgba(185, 28, 28, 0.05);
      border: 1px solid rgba(185, 28, 28, 0.2);
      border-radius: var(--r-md);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .bk-status-banner.returned {
      background: rgba(124, 58, 237, 0.05);
      border-color: rgba(124, 58, 237, 0.2);
    }
    .bk-status-banner-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(185, 28, 28, 0.12);
      color: var(--red);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .bk-status-banner.returned .bk-status-banner-icon {
      background: rgba(124, 58, 237, 0.12);
      color: var(--purple);
    }
    .bk-status-banner-text h4 {
      font-family: 'Libre Baskerville', serif;
      font-size: .95rem;
      font-weight: 700;
      color: var(--fg);
      margin-bottom: 4px;
    }
    .bk-status-banner-text p {
      font-size: .82rem;
      color: var(--muted);
      line-height: 1.45;
    }

    /* ── TWO-COLUMN GRID ── */
    .bk-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 28px;
      align-items: start;
    }

    /* ── SECTION CARD ── */
    .bk-section {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      overflow: hidden;
      margin-bottom: 22px;
      box-shadow: var(--shadow-sm);
    }
    .bk-section:last-child {
      margin-bottom: 0;
    }
    .bk-section-head {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .bk-section-title {
      font-family: 'Libre Baskerville', serif;
      font-size: .98rem;
      font-weight: 700;
      color: var(--fg);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .bk-section-title i {
      color: var(--hi);
      font-size: .88rem;
    }
    .bk-section-body {
      padding: 22px 24px;
    }

    /* ── ITEMS LIST ── */
    .bk-item-row {
      display: grid;
      grid-template-columns: 68px 1fr auto;
      gap: 18px;
      align-items: center;
      padding: 18px 0;
      border-bottom: 1px solid var(--border);
    }
    .bk-item-row:first-child {
      padding-top: 0;
    }
    .bk-item-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .bk-item-img {
      width: 68px;
      height: 96px;
      border-radius: 6px;
      object-fit: cover;
      box-shadow: var(--shadow-cover);
      border: 1px solid var(--border);
      background: var(--canvas);
      flex-shrink: 0;
    }
    .bk-item-meta {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .bk-item-title {
      font-family: 'Libre Baskerville', serif;
      font-size: .95rem;
      font-weight: 700;
      color: var(--fg);
      line-height: 1.4;
      text-decoration: none;
      transition: color .18s;
    }
    .bk-item-title:hover {
      color: var(--hi);
    }
    .bk-item-subinfo {
      font-size: .8rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .bk-item-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    .bk-item-subtotal {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--fg);
      white-space: nowrap;
    }

    /* ── TWO-BOX INFO ROW ── */
    .bk-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .bk-info-box {
      background: var(--canvas);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .bk-info-box-title {
      font-size: .76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .6px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .bk-info-box-title i {
      color: var(--hi);
    }
    .bk-info-box-content {
      font-size: .84rem;
      color: var(--fg);
      line-height: 1.6;
    }

    /* ── SUMMARY PANEL (Exact match with Checkout & OrderSuccess) ── */
    .bk-summary {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      overflow: hidden;
      position: sticky;
      top: 88px;
      box-shadow: var(--shadow-sm);
    }
    .bk-summary-head {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      font-family: 'Libre Baskerville', serif;
      font-size: .98rem;
      font-weight: 700;
      color: var(--fg);
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .bk-summary-head i {
      color: var(--hi);
      font-size: .88rem;
    }
    .bk-summary-body {
      padding: 6px 0;
    }
    .bk-sum-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 24px;
      font-size: .85rem;
      border-bottom: 1px solid var(--border);
    }
    .bk-sum-row:last-of-type {
      border-bottom: none;
    }
    .bk-sum-label {
      color: var(--muted);
    }
    .bk-sum-val {
      font-weight: 600;
      color: var(--fg);
    }
    .bk-sum-val.green {
      color: var(--green);
    }

    .bk-sum-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      background: var(--fg);
      color: #fff;
    }
    .bk-sum-total-label {
      font-size: .88rem;
      font-weight: 600;
      opacity: .8;
    }
    .bk-sum-total-val {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.3rem;
      font-weight: 700;
    }

    .bk-summary-cta {
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* ── BUTTONS ── */
    .bk-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 10px 18px;
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: .84rem;
      font-weight: 600;
      border-radius: var(--r-sm);
      text-decoration: none;
      cursor: pointer;
      transition: all .18s;
      border: 1.5px solid transparent;
      white-space: nowrap;
    }
    .bk-btn-dark {
      background: var(--fg);
      color: #fff;
      border-color: var(--fg);
    }
    .bk-btn-dark:hover {
      background: var(--hi);
      border-color: var(--hi);
      color: #fff;
    }
    .bk-btn-outline {
      background: none;
      color: var(--fg);
      border-color: var(--border);
    }
    .bk-btn-outline:hover {
      border-color: var(--hi);
      color: var(--hi);
      background: rgba(184, 84, 42, 0.04);
    }
    .bk-btn-danger {
      background: rgba(185, 28, 28, 0.08);
      color: var(--red);
      border-color: rgba(185, 28, 28, 0.25);
    }
    .bk-btn-danger:hover {
      background: var(--red);
      color: #fff;
      border-color: var(--red);
    }
    .bk-btn-sm {
      padding: 5px 12px;
      font-size: .75rem;
      border-radius: 6px;
    }
    .bk-btn-full {
      width: 100%;
      justify-content: center;
      padding: 12px 18px;
      font-size: .86rem;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 960px) {
      .bk-order-wrap {
        padding: 24px 20px 60px;
      }
      .bk-grid {
        grid-template-columns: 1fr;
      }
      .bk-summary {
        position: static;
      }
      .bk-order-header {
        padding: 20px;
      }
      .bk-order-title-group h1 {
        font-size: 1.35rem;
      }
      .bk-info-grid {
        grid-template-columns: 1fr;
      }
      .bk-tracker-steps {
        overflow-x: auto;
        padding-bottom: 8px;
      }
    }
  </style>
</head>

<body>
  <!-- Shared Header -->
  <%- include('../partials/userHeader') %>

  <!-- Breadcrumb -->
  <div class="bk-crumb">
    <div class="bk-crumb-inner">
      <a href="/home">Home</a>
      <span class="bk-crumb-sep"><i class="fas fa-chevron-right"></i></span>
      <a href="/loadProfile">My Account</a>
      <span class="bk-crumb-sep"><i class="fas fa-chevron-right"></i></span>
      <span class="bk-crumb-cur">Order Details</span>
    </div>
  </div>

  <div class="bk-order-wrap">
    <% if (locals.orders) { %>
      <!-- Order Header Banner -->
      <div class="bk-order-header">
        <div class="bk-order-title-group">
          <h1>Order #<%= orders.orderId %></h1>
          <div class="bk-order-meta">
            <span><i class="far fa-calendar-alt"></i> <%= orders.orderDate ? new Date(orders.orderDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A' %></span>
            <span>&bull;</span>
            <span><i class="fas fa-credit-card"></i> <%= orders.paymentMethod %></span>
            <span>&bull;</span>
            <%
              let sPill = 'bk-pill-pend';
              if (orders.orderStatus === 'Cancelled') sPill = 'bk-pill-can';
              else if (orders.orderStatus === 'Returned') sPill = 'bk-pill-ret';
              else if (orders.orderStatus === 'Delivered') sPill = 'bk-pill-del';
              else if (orders.orderStatus === 'Shipped') sPill = 'bk-pill-ship';
            %>
            <span class="bk-pill <%= sPill %>"><%= orders.orderStatus %></span>

            <%
              let pPill = 'bk-pill-pend';
              if (orders.paymentStatus === 'Received') pPill = 'bk-pill-recv';
              else if (orders.paymentStatus === 'Failed') pPill = 'bk-pill-fail';
              else if (orders.paymentStatus === 'Refund') pPill = 'bk-pill-ref';
            %>
            <span class="bk-pill <%= pPill %>">Payment: <%= orders.paymentStatus %></span>
          </div>
        </div>

        <!-- Top Order Actions -->
        <div class="bk-order-header-actions">
          <% if (orders.orderStatus === "Delivered" || orders.paymentStatus === "Received") { %>
            <a class="bk-btn bk-btn-outline" href="/loadInvoice?id=<%= orders._id %>" target="_blank">
              <i class="fas fa-file-invoice"></i> Tax Invoice
            </a>
          <% } %>

          <% if (orders.orderStatus === "Delivered") { %>
            <button class="bk-btn bk-btn-outline return-whole-order-btn" data-order-id="<%= orders._id %>">
              <i class="fas fa-undo"></i> Return Entire Order
            </button>
          <% } else if (orders.orderStatus !== "Cancelled" && orders.orderStatus !== "Returned") { %>
            <button class="bk-btn bk-btn-danger cancel-whole-order-btn" data-order-id="<%= orders._id %>">
              <i class="fas fa-times"></i> Cancel Entire Order
            </button>
          <% } else if (orders.orderStatus === "Cancelled") { %>
            <span class="bk-pill bk-pill-can" style="font-size: .8rem; padding: 6px 14px;">
              <i class="fas fa-ban"></i> Order Cancelled
            </span>
          <% } else if (orders.orderStatus === "Returned") { %>
            <span class="bk-pill bk-pill-ret" style="font-size: .8rem; padding: 6px 14px;">
              <i class="fas fa-undo"></i> Order Returned
            </span>
          <% } %>
        </div>
      </div>

      <!-- Order Status Progress Tracker -->
      <div class="bk-tracker-card">
        <% if (orders.orderStatus === "Cancelled") { %>
          <div class="bk-status-banner">
            <div class="bk-status-banner-icon"><i class="fas fa-ban"></i></div>
            <div class="bk-status-banner-text">
              <h4>Order Cancelled</h4>
              <p>This order has been cancelled. Any pre-paid amount has been refunded directly to your BOOKSAW Wallet balance.</p>
            </div>
          </div>
        <% } else if (orders.orderStatus === "Returned") { %>
          <div class="bk-status-banner returned">
            <div class="bk-status-banner-icon"><i class="fas fa-undo"></i></div>
            <div class="bk-status-banner-text">
              <h4>Order Returned</h4>
              <p>This order has been returned. The corresponding refund has been credited to your BOOKSAW Wallet.</p>
            </div>
          </div>
        <% } else { 
             const st = orders.orderStatus;
             let pWidth = '0%';
             let isP = true;
             let isS = (st === 'Shipped' || st === 'Delivered');
             let isD = (st === 'Delivered');

             if (st === 'Shipped') {
               pWidth = '50%';
             } else if (st === 'Delivered') {
               pWidth = '100%';
             }
        %>
          <div class="bk-tracker-title">
            <i class="fas fa-shipping-fast"></i> Order Progress Updates
          </div>
          <div class="bk-tracker-steps">
            <div class="bk-tracker-line"></div>
            <div class="bk-tracker-progress" style="width: <%= pWidth %>;"></div>

            <!-- Step 1: Order Placed -->
            <div class="bk-tracker-step <%= isS ? 'completed' : 'active' %>">
              <div class="bk-tracker-node">
                <% if (isS) { %><i class="fas fa-check"></i><% } else { %>1<% } %>
              </div>
              <span class="bk-tracker-label">Order Placed</span>
            </div>

            <!-- Step 2: Shipped -->
            <div class="bk-tracker-step <%= isD ? 'completed' : (st === 'Shipped' ? 'active' : '') %>">
              <div class="bk-tracker-node">
                <% if (isD) { %><i class="fas fa-check"></i><% } else if (st === 'Shipped') { %>2<% } else { %>2<% } %>
              </div>
              <span class="bk-tracker-label">Shipped</span>
            </div>

            <!-- Step 3: Delivered -->
            <div class="bk-tracker-step <%= isD ? 'completed' : '' %>">
              <div class="bk-tracker-node">
                <% if (isD) { %><i class="fas fa-check"></i><% } else { %>3<% } %>
              </div>
              <span class="bk-tracker-label">Delivered</span>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Two-Column Grid -->
      <div class="bk-grid">

        <!-- Left Column: Ordered Items & Details -->
        <div>

          <!-- Purchased Books Card -->
          <div class="bk-section">
            <div class="bk-section-head">
              <div class="bk-section-title">
                <i class="fas fa-book-open"></i> Items in this Order
              </div>
              <span style="font-size:.78rem;font-weight:600;color:var(--muted)">
                <%= orders.product ? orders.product.length : 0 %> item<%= orders.product && orders.product.length !== 1 ? 's' : '' %>
              </span>
            </div>

            <div class="bk-section-body">
              <% if (orders.product && orders.product.length > 0) { %>
                <div class="bk-items-list">
                  <% for (let product of orders.product) { 
                       const pObj = product.productId || {};
                       const bookTitle = pObj.Bookname || 'Book';
                       const bookPrice = Number(product.price) || 0;
                       const itemQty = Number(product.quantity) || 1;
                       const itemTotal = bookPrice * itemQty;
                       const bookImg = (pObj.Images && pObj.Images.length > 0) ? '/public/uploads/' + pObj.Images[0] : '/public/spellbook.png';
                       const bookLink = pObj._id ? '/shop-product?id=' + pObj._id : '#';
                  %>
                    <div class="bk-item-row">
                      <a href="<%= bookLink %>">
                        <img class="bk-item-img" src="<%= bookImg %>" alt="<%= bookTitle %>" onerror="this.src='/public/spellbook.png'">
                      </a>

                      <div class="bk-item-meta">
                        <a href="<%= bookLink %>" class="bk-item-title"><%= bookTitle %></a>
                        <div class="bk-item-subinfo">
                          <span>Unit Price: <strong>&#8377;<%= bookPrice.toFixed(2) %></strong></span>
                          <span>&bull;</span>
                          <span>Qty: <strong><%= itemQty %></strong></span>
                          <% if (product.productStatus === "Cancelled") { %>
                            <span>&bull;</span>
                            <span class="bk-pill bk-pill-can">Cancelled</span>
                          <% } else if (product.productStatus === "Returned") { %>
                            <span>&bull;</span>
                            <span class="bk-pill bk-pill-ret">Returned</span>
                          <% } %>
                        </div>
                      </div>

                      <div class="bk-item-right">
                        <div class="bk-item-subtotal">
                          &#8377;<%= itemTotal.toFixed(2) %>
                        </div>

                        <!-- Single Item Cancellation or Return -->
                        <% if (product.productStatus !== 'Cancelled' && product.productStatus !== 'Returned' && orders.orderStatus !== 'Returned' && orders.orderStatus !== 'Cancelled' && orders.orderStatus !== 'Delivered') { %>
                          <button class="bk-btn bk-btn-danger bk-btn-sm cancel-book-btn" data-product-id="<%= product._id %>">
                            <i class="fas fa-times"></i> Cancel Item
                          </button>
                        <% } else if (orders.orderStatus === "Delivered" && product.productStatus !== "Returned" && product.productStatus !== "Cancelled") { %>
                          <button class="bk-btn bk-btn-outline bk-btn-sm return-book-btn" data-product-id="<%= product._id %>">
                            <i class="fas fa-undo"></i> Return Item
                          </button>
                        <% } %>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <p style="color:var(--muted);font-size:.85rem">No items recorded for this order.</p>
              <% } %>
            </div>
          </div>

          <!-- Shipping and Payment Overview Box -->
          <div class="bk-info-grid">
            <!-- Shipping Address -->
            <div class="bk-info-box">
              <div class="bk-info-box-title">
                <i class="fas fa-map-marker-alt"></i> Shipping Address
              </div>
              <div class="bk-info-box-content">
                <% if (orders.address) { %>
                  <strong><%= orders.address.name || 'Recipient' %></strong><br>
                  <%= orders.address.houseName %><br>
                  <%= [orders.address.city, orders.address.state].filter(Boolean).join(', ') %>
                  <% if (orders.address.pinCode) { %> &mdash; <strong>PIN <%= orders.address.pinCode %></strong><% } %><br>
                  <% if (orders.address.mobile) { %>
                    <span style="color:var(--muted);font-size:.8rem;"><i class="fas fa-phone-alt"></i> <%= orders.address.mobile %></span>
                  <% } %>
                <% } else { %>
                  <span style="color:var(--muted)">Shipping address recorded on file.</span>
                <% } %>
              </div>
            </div>

            <!-- Payment Details -->
            <div class="bk-info-box">
              <div class="bk-info-box-title">
                <i class="fas fa-wallet"></i> Payment Method
              </div>
              <div class="bk-info-box-content">
                <strong><%= orders.paymentMethod || 'Online Payment' %></strong><br>
                <span>Payment Status: </span>
                <span class="bk-pill <%= pPill %>" style="margin-left: 4px;"><%= orders.paymentStatus %></span><br>
                <span style="color:var(--muted);font-size:.78rem;display:inline-block;margin-top:6px;">
                  <i class="fas fa-shield-alt" style="color:var(--green)"></i> Protected by BOOKSAW Buyer Guarantee
                </span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Order Summary & Quick Navigation -->
        <div>
          <div class="bk-summary">
            <div class="bk-summary-head">
              <i class="fas fa-receipt"></i> Payment Summary
            </div>

            <%
              let itemsSubtotal = 0;
              if (orders.product && orders.product.length > 0) {
                for (let p of orders.product) {
                  itemsSubtotal += (Number(p.price) || 0) * (Number(p.quantity) || 1);
                }
              } else if (orders.totalAmount) {
                itemsSubtotal = Number(orders.totalAmount) || 0;
              }
            %>

            <div class="bk-summary-body">
              <div class="bk-sum-row">
                <span class="bk-sum-label">Items Subtotal</span>
                <span class="bk-sum-val">&#8377;<%= itemsSubtotal.toFixed(2) %></span>
              </div>

              <% if (orders.couponDiscount && orders.couponDiscount > 0) { %>
                <div class="bk-sum-row">
                  <span class="bk-sum-label">Coupon Discount <%= orders.couponCode ? '(' + orders.couponCode + ')' : '' %></span>
                  <span class="bk-sum-val green">-&#8377;<%= Number(orders.couponDiscount).toFixed(2) %></span>
                </div>
              <% } %>

              <div class="bk-sum-row">
                <span class="bk-sum-label">Delivery Fee</span>
                <span class="bk-sum-val green">FREE</span>
              </div>
            </div>

            <div class="bk-sum-total">
              <span class="bk-sum-total-label">Grand Total</span>
              <span class="bk-sum-total-val">&#8377;<%= orders.totalAmount ? Number(orders.totalAmount).toFixed(2) : '0.00' %></span>
            </div>

            <div class="bk-summary-cta">
              <a href="/loadProfile" class="bk-btn bk-btn-dark bk-btn-full">
                <i class="fas fa-arrow-left"></i> Back to My Orders
              </a>
              <a href="/loadShop" class="bk-btn bk-btn-outline bk-btn-full">
                <i class="fas fa-compass"></i> Continue Shopping
              </a>
              <% if (orders.orderStatus === "Delivered" || orders.paymentStatus === "Received") { %>
                <a href="/loadInvoice?id=<%= orders._id %>" class="bk-btn bk-btn-outline bk-btn-full" target="_blank" style="border-style:dashed;">
                  <i class="fas fa-file-invoice"></i> Download Tax Invoice
                </a>
              <% } %>
            </div>
          </div>
        </div>

      </div>
    <% } else { %>
      <!-- Not found fallback -->
      <div class="bk-section text-center" style="padding: 60px 20px;">
        <h2 style="font-family:'Libre Baskerville',serif;font-size:1.4rem;margin-bottom:12px;">Order Not Found</h2>
        <p style="color:var(--muted);margin-bottom:20px;">We couldn't locate the order details you requested.</p>
        <a href="/loadProfile" class="bk-btn bk-btn-dark">Go to My Orders</a>
      </div>
    <% } %>
  </div>

  <!-- Shared Footer -->
  <%- include('../partials/userFooter') %>

  <!-- Scripts -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

  <script>
    toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 1500 };

    document.addEventListener('DOMContentLoaded', () => {
      // Cancel individual book
      document.querySelectorAll('.cancel-book-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const productId = button.getAttribute('data-product-id');
          Swal.fire({
            title: 'Cancel this item?',
            text: 'Are you sure you want to cancel this book? If paid, the amount will be refunded to your wallet.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#b91c1c',
            cancelButtonColor: '#7a6f60',
            confirmButtonText: 'Yes, cancel item',
            cancelButtonText: 'Keep item',
            background: '#faf8f4',
            color: '#2d2820'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/bookCancel?id=' + productId;
            }
          });
        });
      });

      // Return individual book
      document.querySelectorAll('.return-book-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const productId = button.getAttribute('data-product-id');
          Swal.fire({
            title: 'Return this item?',
            text: 'Do you want to initiate a return for this book? The refund will be credited to your wallet balance.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#b8542a',
            cancelButtonColor: '#7a6f60',
            confirmButtonText: 'Yes, return item',
            cancelButtonText: 'Keep item',
            background: '#faf8f4',
            color: '#2d2820'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/bookReturn?id=' + productId;
            }
          });
        });
      });

      // Cancel entire order
      const cancelOrderBtn = document.querySelector('.cancel-whole-order-btn');
      if (cancelOrderBtn) {
        cancelOrderBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const orderId = cancelOrderBtn.getAttribute('data-order-id');
          Swal.fire({
            title: 'Cancel Entire Order?',
            text: 'Are you sure you want to cancel this entire order? Any paid amount will be refunded immediately to your wallet.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#b91c1c',
            cancelButtonColor: '#7a6f60',
            confirmButtonText: 'Yes, cancel order',
            cancelButtonText: 'No, keep order',
            background: '#faf8f4',
            color: '#2d2820'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/orderCancel?id=' + orderId;
            }
          });
        });
      }

      // Return entire order
      const returnOrderBtn = document.querySelector('.return-whole-order-btn');
      if (returnOrderBtn) {
        returnOrderBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const orderId = returnOrderBtn.getAttribute('data-order-id');
          Swal.fire({
            title: 'Return Entire Order?',
            text: 'Are you sure you want to return this entire delivered order? The refund will be credited to your wallet balance.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#b8542a',
            cancelButtonColor: '#7a6f60',
            confirmButtonText: 'Yes, return order',
            cancelButtonText: 'Keep order',
            background: '#faf8f4',
            color: '#2d2820'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/orderReturn?id=' + orderId;
            }
          });
        });
      }
    });
  </script>
</body>

</html>