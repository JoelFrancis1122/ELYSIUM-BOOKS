  <div class="bk-drawer-overlay" onclick="closeDrawer()"></div>
  <div class="bk-drawer-panel">
    <div class="bk-drawer-top">
      <a href="/home" class="bk-drawer-logo" onclick="closeDrawer()">
        <img src="/public/main-logo (1).png" alt="BOOKSAW">
      </a>
      <button class="bk-drawer-close" onclick="closeDrawer()"><i class="fas fa-xmark"></i></button>
    </div>

    <form action="/loadShop" class="bk-drawer-search">
