<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <title>Shop — BOOKSAW</title>
    <meta name="description" content="Browse our complete collection of books. Filter by genre, sort by price, and find your next great read.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ── BOOKSAW SHOP — WARM LITERARY DESIGN ── */
        :root {
            --canvas:    #f5f0e8;
            --bg:        #faf8f4;
            --fg:        #2d2820;
            --highlight: #b8542a;
            --hi-light:  #d4673a;
            --muted-fg:  #7a6f60;
            --border:    #ddd8ce;
            --secondary: #edeae2;
            --card:      #ffffff;
            --shadow-sm: 0 2px 8px rgba(45,40,32,0.06);
            --shadow-md: 0 8px 24px rgba(45,40,32,0.09);
            --shadow-cover: 0 10px 18px rgba(45,40,32,0.18);
            --r-sm: 8px; --r-md: 14px; --r-lg: 20px;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: 'IBM Plex Sans', sans-serif;
            background: var(--canvas);
            color: var(--fg);
            margin: 0;
            overflow-x: hidden;
        }

        /* ── BREADCRUMB ─────────────────────────── */
        .bk-crumb {
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            padding: 14px 0;
        }
        .bk-crumb-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 48px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            color: var(--muted-fg);
        }
        .bk-crumb-inner a {
            color: var(--muted-fg);
            text-decoration: none;
            transition: color 0.2s;
        }
        .bk-crumb-inner a:hover { color: var(--highlight); }
        .bk-crumb-sep { color: var(--border); font-size: 0.7rem; }
        .bk-crumb-current { color: var(--fg); font-weight: 600; }

        /* ── SHOP LAYOUT ───────────────────────── */
        .bk-shop {
            max-width: 1280px;
            margin: 0 auto;
            padding: 40px 48px 80px;
            display: grid;
            grid-template-columns: 256px 1fr;
            gap: 32px;
            align-items: start;
        }

        /* ── SIDEBAR ───────────────────────────── */
        .bk-sidebar {
            position: sticky;
            top: 90px;
        }

        .bk-sidebar-card {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .bk-sidebar-head {
            padding: 16px 20px 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .bk-sidebar-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--fg);
        }
        .bk-sidebar-count {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--muted-fg);
            background: var(--secondary);
            border: 1px solid var(--border);
            padding: 2px 8px;
            border-radius: 999px;
        }

        /* Search sidebar */
        .bk-sidebar-search {
            padding: 16px;
        }
        .bk-sidebar-search form {
            display: flex;
            align-items: center;
            background: var(--canvas);
            border: 1.5px solid var(--border);
            border-radius: var(--r-sm);
            overflow: hidden;
            transition: border-color 0.2s;
        }
        .bk-sidebar-search form:focus-within { border-color: var(--highlight); }
        .bk-sidebar-search input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 9px 12px;
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.85rem;
            color: var(--fg);
            outline: none;
        }
        .bk-sidebar-search input::placeholder { color: var(--muted-fg); }
        .bk-sidebar-search button {
            background: none;
            border: none;
            padding: 9px 12px;
            color: var(--muted-fg);
            cursor: pointer;
            font-size: 0.85rem;
            transition: color 0.2s;
        }
        .bk-sidebar-search button:hover { color: var(--highlight); }

        /* Category list */
        .bk-cat-list { padding: 8px 0; }
        .bk-cat-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            font-size: 0.86rem;
            font-weight: 500;
            color: var(--fg);
            text-decoration: none;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            transition: background 0.15s, color 0.15s;
            border-radius: 0;
        }
        .bk-cat-item:hover { background: rgba(184,84,42,0.06); color: var(--highlight); }
        .bk-cat-item.active { background: rgba(184,84,42,0.09); color: var(--highlight); font-weight: 600; }
        .bk-cat-item i { width: 16px; text-align: center; font-size: 0.8rem; color: var(--muted-fg); transition: color 0.15s; }
        .bk-cat-item:hover i, .bk-cat-item.active i { color: var(--highlight); }
        .bk-cat-item .bk-cat-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
            transition: background 0.2s;
        }
        .bk-cat-item:hover .bk-cat-dot,
        .bk-cat-item.active .bk-cat-dot { background: var(--highlight); }

        /* Sort sidebar card */
        .bk-sort-list { padding: 8px 0; }
        .bk-sort-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            font-size: 0.84rem;
            color: var(--fg);
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
        }
        .bk-sort-item:hover { background: rgba(184,84,42,0.06); color: var(--highlight); }
        .bk-sort-item.active { color: var(--highlight); font-weight: 600; background: rgba(184,84,42,0.06); }
        .bk-sort-item i { font-size: 0.75rem; color: var(--muted-fg); width: 14px; text-align: center; }
        .bk-sort-item.active i { color: var(--highlight); }

        /* ── MAIN CONTENT ──────────────────────── */
        .bk-shop-main {}

        /* Toolbar */
        .bk-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 24px;
            padding: 14px 20px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
        }
        .bk-toolbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .bk-result-count {
            font-size: 0.85rem;
            color: var(--muted-fg);
        }
        .bk-result-count strong { color: var(--fg); font-weight: 700; }
        .bk-active-filter {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--highlight);
            background: rgba(184,84,42,0.08);
            border: 1px solid rgba(184,84,42,0.2);
            padding: 3px 10px;
            border-radius: 999px;
        }
        .bk-active-filter a { color: var(--muted-fg); text-decoration: none; margin-left: 4px; }
        .bk-active-filter a:hover { color: var(--fg); }
        .bk-toolbar-right { display: flex; align-items: center; gap: 8px; }
        .bk-view-btn {
            width: 34px; height: 34px;
            border-radius: 7px;
            border: 1.5px solid var(--border);
            background: none;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: var(--muted-fg);
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .bk-view-btn:hover, .bk-view-btn.active { border-color: var(--highlight); color: var(--highlight); background: rgba(184,84,42,0.07); }

        /* ── BOOK GRID ────────────────────────────── */
        .bk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 28px 20px;
        }
        .bk-grid.list-view { grid-template-columns: 1fr; }
        .bk-grid.list-view .bk-card {
            flex-direction: row;
            align-items: flex-start;
            gap: 22px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            padding: 18px;
        }
        .bk-grid.list-view .bk-cover-wrap {
            width: 88px;
            flex-shrink: 0;
            aspect-ratio: auto;
            height: 124px;
        }
        .bk-grid.list-view .bk-card-body {
            padding: 0;
            flex: 1;
        }
        .bk-grid.list-view .bk-cover-cta { display: none; }
        .bk-grid.list-view .bk-list-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        /* ── BOOK CARD ───────────────────────────── */
        .bk-card { display: flex; flex-direction: column; }

        /* Cover */
        .bk-cover-wrap {
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            aspect-ratio: 2/3;
            background: var(--secondary);
            /* book spine shadow — left edge slightly darker */
            box-shadow:
                inset 6px 0 12px rgba(45,40,32,0.12),
                4px 6px 20px rgba(45,40,32,0.14);
            transition: transform 380ms cubic-bezier(0.25,0.46,0.45,0.94),
                        box-shadow 380ms cubic-bezier(0.25,0.46,0.45,0.94);
        }
        .bk-card:hover .bk-cover-wrap {
            transform: translateY(-6px) rotate3d(0,1,0,2deg);
            box-shadow:
                inset 6px 0 12px rgba(45,40,32,0.12),
                10px 20px 32px rgba(45,40,32,0.20);
        }
        .bk-cover-wrap img {
            width: 100%; height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Sold-out dim — only for unavailable books, no badge */
        .bk-cover-wrap.soldout img { filter: grayscale(40%) brightness(0.85); }

        /* Slide-up CTA strip — appears from the bottom on hover */
        .bk-cover-cta {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            display: flex;
            transform: translateY(100%);
            transition: transform 320ms cubic-bezier(0.4,0,0.2,1);
        }
        .bk-card:hover .bk-cover-cta { transform: translateY(0); }

        .bk-cta-cart {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 8px;
            background: var(--fg);
            color: rgba(255,255,255,0.92);
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.76rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            border: none;
            cursor: pointer;
            transition: background 0.18s;
        }
        .bk-cta-cart:hover { background: var(--highlight); }

        .bk-cta-wish {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            background: rgba(250,248,244,0.94);
            color: var(--fg);
            font-size: 0.88rem;
            text-decoration: none;
            border: none;
            border-left: 1px solid rgba(45,40,32,0.1);
            cursor: pointer;
            transition: background 0.18s, color 0.18s;
        }
        .bk-cta-wish:hover { background: var(--highlight); color: #fff; }

        /* Sold-out strip */
        .bk-soldout-strip {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 9px;
            background: rgba(45,40,32,0.75);
            text-align: center;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.7);
        }

        /* Card body */
        .bk-card-body { padding: 12px 2px 0; }

        .bk-genre {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--highlight);
            text-decoration: none;
            display: block;
            margin-bottom: 5px;
            opacity: 0.85;
        }
        .bk-genre:hover { opacity: 1; }

        .bk-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 0.87rem;
            font-weight: 700;
            color: var(--fg);
            line-height: 1.45;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 9px;
        }
        .bk-title:hover { color: var(--highlight); }

        .bk-price-row { display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
        .bk-price { font-size: 0.96rem; font-weight: 700; color: var(--fg); }
        .bk-price-old { font-size: 0.77rem; color: var(--muted-fg); text-decoration: line-through; }
        .bk-discount {
            font-size: 0.63rem; font-weight: 700;
            color: var(--highlight);
            /* No background box — just plain text saves */ 
        }
        .bk-unavail {
            font-size: 0.74rem;
            color: var(--muted-fg);
            font-style: italic;
        }

        /* List view action buttons */
        .bk-list-actions { display: none; }
        .bk-list-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.18s;
            border: 1.5px solid var(--border);
            background: var(--bg);
            color: var(--fg);
        }
        .bk-list-btn:hover { border-color: var(--highlight); color: var(--highlight); }
        .bk-list-btn.primary { background: var(--fg); color: #fff; border-color: var(--fg); }
        .bk-list-btn.primary:hover { background: var(--highlight); border-color: var(--highlight); }

        /* Empty state */
        .bk-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 80px 20px;
        }
        .bk-empty-icon { font-size: 3.5rem; opacity: 0.3; margin-bottom: 16px; }
        .bk-empty-title {
            font-family: 'Libre Baskerville', serif;
            font-size: 1.35rem;
            color: var(--fg);
            margin-bottom: 8px;
        }
        .bk-empty-sub { font-size: 0.9rem; color: var(--muted-fg); margin-bottom: 24px; }
        .bk-empty a {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 11px 24px;
            background: var(--fg); color: #fff;
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.88rem; font-weight: 600;
            border-radius: 7px; text-decoration: none;
            transition: background 0.2s;
        }
        .bk-empty a:hover { background: var(--highlight); }

        /* ── PAGINATION ────────────────────────── */
        .bk-pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 40px;
        }
        .bk-page-btn {
            min-width: 38px; height: 38px;
            border-radius: 8px;
            border: 1.5px solid var(--border);
            background: var(--bg);
            color: var(--fg);
            font-family: 'IBM Plex Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 500;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            padding: 0 10px;
        }
        .bk-page-btn:hover { border-color: var(--highlight); color: var(--highlight); background: rgba(184,84,42,0.06); }
        .bk-page-btn.active { background: var(--fg); color: #fff; border-color: var(--fg); }
        .bk-page-btn:disabled, .bk-page-btn.disabled { opacity: 0.4; pointer-events: none; }



        /* ── RESPONSIVE ────────────────────────── */
        @media (max-width: 1024px) {
            .bk-shop { grid-template-columns: 1fr; padding: 24px 24px 60px; }
            .bk-sidebar { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
            .bk-sidebar-card:last-child { grid-column: 1 / -1; }
        }
        @media (max-width: 600px) {
            .bk-shop { padding: 16px 16px 60px; gap: 16px; }
            .bk-crumb-inner { padding: 0 16px; }
            .bk-sidebar { grid-template-columns: 1fr; }
            .bk-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .bk-toolbar { flex-wrap: wrap; }
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader') %>

    <!-- Breadcrumb -->
    <div class="bk-crumb">
        <div class="bk-crumb-inner">
            <a href="/home">Home</a>
            <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:0.65rem"></i></span>
            <span class="bk-crumb-current">Shop</span>
            <% if (typeof category !== 'undefined' && category) { %>
                <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:0.65rem"></i></span>
                <span class="bk-crumb-current"><%= decodeURIComponent(category) %></span>
            <% } %>
            <% if (typeof search !== 'undefined' && search) { %>
                <span class="bk-crumb-sep"><i class="fas fa-chevron-right" style="font-size:0.65rem"></i></span>
                <span class="bk-crumb-current">"<%= search %>"</span>
            <% } %>
        </div>
    </div>

    <!-- Shop Layout -->
    <div class="bk-shop">

        <!-- ════ SIDEBAR ════ -->
        <aside class="bk-sidebar">

            <!-- Search -->
            <div class="bk-sidebar-card">
                <div class="bk-sidebar-head">
                    <span class="bk-sidebar-title">Search</span>
                </div>
                <div class="bk-sidebar-search">
                    <form id="searchForm" action="/loadShop">
                        <input type="hidden" id="selectedCategory" name="category" value="<%= (typeof category !== 'undefined' && category) ? category : '' %>">
                        <input type="text" name="query" placeholder="Books, authors…"
                            value="<%= (typeof search !== 'undefined' && search) ? search : '' %>">
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </form>
                </div>
            </div>

            <!-- Categories -->
            <div class="bk-sidebar-card">
                <div class="bk-sidebar-head">
                    <span class="bk-sidebar-title">Genres</span>
                    <% if (typeof categories !== 'undefined' && categories) { %>
                        <span class="bk-sidebar-count"><%= categories.length %></span>
                    <% } %>
                </div>
                <div class="bk-cat-list">
                    <button class="bk-cat-item <% if(!(typeof category !== 'undefined' && category)) { %>active<% } %>"
                        onclick="filterCategory('')">
                        <span class="bk-cat-dot"></span> All Books
                    </button>
                    <% if (typeof categories !== 'undefined' && categories) { %>
                        <% for(let i = 0; i < categories.length; i++) { %>
                            <button class="bk-cat-item <%= (typeof category !== 'undefined' && decodeURIComponent(category) === categories[i].categoryName) ? 'active' : '' %>"
                                id="category<%= i %>"
                                onclick="filterCategory('<%= encodeURIComponent(categories[i].categoryName) %>')">
                                <span class="bk-cat-dot"></span>
                                <%= categories[i].categoryName %>
                            </button>
                        <% } %>
                    <% } %>
                </div>
            </div>

            <!-- Sort -->
            <div class="bk-sidebar-card">
                <div class="bk-sidebar-head">
                    <span class="bk-sidebar-title">Sort By</span>
                </div>
                <div class="bk-sort-list">
                    <% const curFilter = (typeof filter !== 'undefined') ? filter : ''; %>
                    <% const curSearch = (typeof search !== 'undefined' && search) ? search : ''; %>
                    <% const curCat = (typeof category !== 'undefined' && category) ? category : ''; %>
                    <a href="/loadShop?query=<%= curSearch %>&category=<%= curCat %>" class="bk-sort-item <%= !curFilter ? 'active' : '' %>">
                        <i class="fas fa-star"></i> Featured
                    </a>
                    <a href="/loadShop?query=<%= curSearch %>&category=<%= curCat %>&filter=low-high" class="bk-sort-item <%= curFilter === 'low-high' ? 'active' : '' %>">
                        <i class="fas fa-arrow-up-short-wide"></i> Price: Low to High
                    </a>
                    <a href="/loadShop?query=<%= curSearch %>&category=<%= curCat %>&filter=high-low" class="bk-sort-item <%= curFilter === 'high-low' ? 'active' : '' %>">
                        <i class="fas fa-arrow-down-short-wide"></i> Price: High to Low
                    </a>
                </div>
            </div>
        </aside>

        <!-- ════ MAIN ════ -->
        <div class="bk-shop-main">

            <!-- Toolbar -->
            <div class="bk-toolbar">
                <div class="bk-toolbar-left">
                    <% if (typeof product !== 'undefined' && product) { %>
                        <span class="bk-result-count">
                            <strong><%= product.length %></strong> book<%= product.length !== 1 ? 's' : '' %> found
                        </span>
                    <% } %>
                    <% if (typeof category !== 'undefined' && category) { %>
                        <span class="bk-active-filter">
                            <i class="fas fa-tag" style="font-size:0.65rem"></i>
                            <%= decodeURIComponent(category) %>
                            <a href="/loadShop?query=<%= (typeof search !== 'undefined' && search) ? search : '' %>"><i class="fas fa-xmark"></i></a>
                        </span>
                    <% } %>
                    <% if (typeof search !== 'undefined' && search) { %>
                        <span class="bk-active-filter">
                            <i class="fas fa-search" style="font-size:0.65rem"></i>
                            "<%= search %>"
                            <a href="/loadShop?category=<%= (typeof category !== 'undefined' && category) ? category : '' %>"><i class="fas fa-xmark"></i></a>
                        </span>
                    <% } %>
                </div>
                <div class="bk-toolbar-right">
                    <button class="bk-view-btn active" id="grid-view-btn" onclick="setView('grid')" title="Grid view">
                        <i class="fas fa-grip"></i>
                    </button>
                    <button class="bk-view-btn" id="list-view-btn" onclick="setView('list')" title="List view">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>

            <!-- Book Grid -->
            <% if (typeof product !== 'undefined' && product && product.length > 0) { %>
                <div class="bk-grid" id="bk-grid">
                    <% for(let i = 0; i < product.length; i++) { %>
                        <div class="bk-card" id="bk-card-<%= product[i]._id %>">

                            <!-- Cover -->
                            <div class="bk-cover-wrap<%= product[i].stock === 0 ? ' soldout' : '' %>">
                                <a href="/shop-product?id=<%= product[i]._id %>">
                                    <img
                                        src="/public/uploads/<%= product[i].Images[0] %>"
                                        alt="<%= product[i].Bookname %>"
                                        loading="lazy"
                                    >
                                </a>

                                <% if (product[i].stock > 0) { %>
                                    <!-- Slide-up cart strip -->
                                    <div class="bk-cover-cta">
                                        <button class="bk-cta-cart"
                                            onclick="addToCart('<%= product[i]._id %>')"
                                            id="add-cart-<%= product[i]._id %>">
                                            <i class="fas fa-shopping-bag"></i> Add to Cart
                                        </button>
                                        <a href="/wishlist?id=<%= product[i]._id %>"
                                           class="bk-cta-wish"
                                           id="wish-<%= product[i]._id %>"
                                           title="Save to wishlist">
                                            <i class="fas fa-bookmark"></i>
                                        </a>
                                    </div>
                                <% } else { %>
                                    <div class="bk-soldout-strip">Out of Stock</div>
                                <% } %>
                            </div>

                            <!-- Info -->
                            <div class="bk-card-body">
                                <a href="/loadShop?category=<%= encodeURIComponent(product[i].Categories.categoryName) %>" class="bk-genre">
                                    <%= product[i].Categories.categoryName %>
                                </a>
                                <a href="/shop-product?id=<%= product[i]._id %>" class="bk-title">
                                    <%= product[i].Bookname %>
                                </a>
                                <% if (product[i].stock === 0) { %>
                                    <span class="bk-unavail">Not available</span>
                                <% } else { %>
                                    <div class="bk-price-row">
                                        <span class="bk-price">&#8377;<%= product[i].saleprice %></span>
                                        <% if (product[i].Regularprice && product[i].Regularprice > product[i].saleprice) { %>
                                            <span class="bk-price-old">&#8377;<%= product[i].Regularprice %></span>
                                            <span class="bk-discount">−<%= Math.round(((product[i].Regularprice - product[i].saleprice) / product[i].Regularprice) * 100) %>%</span>
                                        <% } %>
                                    </div>
                                <% } %>
                                <!-- List-view only actions -->
                                <div class="bk-list-actions">
                                    <% if (product[i].stock > 0) { %>
                                        <button class="bk-list-btn primary" onclick="addToCart('<%= product[i]._id %>')">
                                            <i class="fas fa-shopping-bag"></i> Add to Cart
                                        </button>
                                    <% } %>
                                    <a href="/wishlist?id=<%= product[i]._id %>" class="bk-list-btn">
                                        <i class="fas fa-bookmark"></i> Save
                                    </a>
                                    <a href="/shop-product?id=<%= product[i]._id %>" class="bk-list-btn">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="bk-grid">
                    <div class="bk-empty">
                        <div class="bk-empty-icon">📭</div>
                        <div class="bk-empty-title">No books found</div>
                        <p class="bk-empty-sub">
                            <% if (typeof search !== 'undefined' && search) { %>
                                No results for "<%= search %>". Try a different search or browse all books.
                            <% } else if (typeof category !== 'undefined' && category) { %>
                                No books in "<%= decodeURIComponent(category) %>" yet.
                            <% } else { %>
                                Our shelves are being restocked. Check back soon!
                            <% } %>
                        </p>
                        <a href="/loadShop"><i class="fas fa-compass"></i> Browse All Books</a>
                    </div>
                </div>
            <% } %>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <nav class="bk-pagination" aria-label="Shop pages">
                    <% if (currentPage > 1) { %>
                        <a href="/loadShop?page=<%= currentPage - 1 %>&query=<%= (typeof search !== 'undefined' && search) ? search : '' %>&category=<%= (typeof category !== 'undefined' && category) ? category : '' %>&filter=<%= (typeof filter !== 'undefined' && filter) ? filter : '' %>"
                           class="bk-page-btn" id="prev-page-btn">
                            <i class="fas fa-chevron-left" style="font-size:0.75rem"></i>
                        </a>
                    <% } else { %>
                        <span class="bk-page-btn disabled"><i class="fas fa-chevron-left" style="font-size:0.75rem"></i></span>
                    <% } %>

                    <% for (let p = 1; p <= totalPages; p++) { %>
                        <a href="/loadShop?page=<%= p %>&query=<%= (typeof search !== 'undefined' && search) ? search : '' %>&category=<%= (typeof category !== 'undefined' && category) ? category : '' %>&filter=<%= (typeof filter !== 'undefined' && filter) ? filter : '' %>"
                           class="bk-page-btn <%= currentPage === p ? 'active' : '' %>"
                           id="page-btn-<%= p %>">
                            <%= p %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/loadShop?page=<%= currentPage + 1 %>&query=<%= (typeof search !== 'undefined' && search) ? search : '' %>&category=<%= (typeof category !== 'undefined' && category) ? category : '' %>&filter=<%= (typeof filter !== 'undefined' && filter) ? filter : '' %>"
                           class="bk-page-btn" id="next-page-btn">
                            <i class="fas fa-chevron-right" style="font-size:0.75rem"></i>
                        </a>
                    <% } else { %>
                        <span class="bk-page-btn disabled"><i class="fas fa-chevron-right" style="font-size:0.75rem"></i></span>
                    <% } %>
                </nav>
            <% } %>
        </div>
    </div>

    <%- include('../partials/userFooter') %>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/public/assets/js/vendor/modernizr-3.6.0.min.js"></script>
    <script src="/public/assets/js/vendor/jquery-migrate-3.3.0.min.js"></script>
    <script src="/public/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="/public/assets/js/plugins/wow.js"></script>
    <script src="/public/assets/js/plugins/scrollup.js"></script>
    <script src="/public/assets/js/plugins/jquery.theia.sticky.js"></script>
    <script src="/public/assets/js/maind134.js?v=3.4"></script>
    <script src="/public/assets/js/shopd134.js?v=3.4"></script>

    <script>
        // ── Add to Cart ──────────────────────────────
        async function addToCart(productId, evt) {
            const btn = (evt && evt.target) ? evt.target.closest('button') : (window.event && window.event.target ? window.event.target.closest('button') : null);
            const origHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            }

            try {
                const res = await fetch('/addToCart?id=' + productId, { method: 'GET' });
                if (res.status === 401) {
                    toastr.warning('Please sign in to add books to your cart!');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                    return;
                }
                if (!res.ok) {
                    const errData = await res.json().catch(() => ({}));
                    toastr.error(errData.error || 'Could not add to cart.');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    const isNew = window.updateCartBadge ? window.updateCartBadge(productId, data) : true;
                    toastr.success(isNew ? 'Added to cart!' : 'Cart updated!');
                    if (btn) {
                        btn.innerHTML = '<i class="fas fa-check"></i> ' + (isNew ? 'Added' : 'Updated');
                        setTimeout(() => {
                            btn.disabled = false;
                            btn.innerHTML = origHtml;
                        }, 1400);
                    }
                } else {
                    toastr.error(data.error || 'Could not add to cart.');
                    if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
                }
            } catch (err) {
                toastr.error('Stock limit exceeded.');
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

        // ── Filter by category ───────────────────────
        function filterCategory(cat) {
            const q = document.querySelector('input[name="query"]') ? document.querySelector('input[name="query"]').value : '';
            let url = '/loadShop';
            const params = [];
            if (cat) params.push('category=' + cat);
            if (q) params.push('query=' + encodeURIComponent(q));
            if (params.length) url += '?' + params.join('&');
            window.location.href = url;
        }

        // ── View toggle ──────────────────────────────
        function setView(mode) {
            const grid = document.getElementById('bk-grid');
            const gridBtn = document.getElementById('grid-view-btn');
            const listBtn = document.getElementById('list-view-btn');
            if (!grid) return;
            if (mode === 'list') {
                grid.classList.add('list-view');
                listBtn.classList.add('active');
                gridBtn.classList.remove('active');
                localStorage.setItem('bk-shop-view', 'list');
            } else {
                grid.classList.remove('list-view');
                gridBtn.classList.add('active');
                listBtn.classList.remove('active');
                localStorage.setItem('bk-shop-view', 'grid');
            }
        }

        // Restore saved view
        document.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('bk-shop-view');
            if (saved === 'list') setView('list');
        });
    </script>
</body>
</html>