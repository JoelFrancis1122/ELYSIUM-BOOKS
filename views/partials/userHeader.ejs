<style>
  /* ── BOOKSAW HEADER — WARM LITERARY SYSTEM ──────────────────────── */
  :root {
    --hdr-canvas:    #f5f0e8;
    --hdr-bg:        #faf8f4;
    --hdr-fg:        #2d2820;
    --hdr-highlight: #b8542a;
    --hdr-muted:     #7a6f60;
    --hdr-border:    #ddd8ce;
    --hdr-secondary: #edeae2;
  }

  /* ── Announcement bar ───────────────────────── */
  .bk-announce {
    background: var(--hdr-fg);
    color: rgba(255,255,255,0.72);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.3px;
    padding: 9px 0;
    text-align: center;
  }
  .bk-announce a {
    color: #e8906a;
    font-weight: 600;
    text-decoration: none;
    margin-left: 6px;
  }
  .bk-announce a:hover { text-decoration: underline; }
  .bk-announce-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .bk-announce-left {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 0.73rem;
    color: rgba(255,255,255,0.45);
  }
  .bk-announce-left i { color: rgba(255,255,255,0.35); font-size: 0.75rem; }

  /* ── Main header ────────────────────────────── */
  .bk-header {
    background: var(--hdr-bg);
    border-bottom: 1px solid var(--hdr-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 12px rgba(45,40,32,0.06);
  }
  .bk-header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    height: 68px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  /* Logo */
  .bk-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .bk-logo img { height: 32px; }
  .bk-logo-text {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--hdr-fg);
    letter-spacing: 0.3px;
  }

  /* Nav */
  .bk-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 12px;
  }
  .bk-nav a {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--hdr-muted);
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 6px;
    transition: background 0.18s, color 0.18s;
    white-space: nowrap;
  }
  .bk-nav a:hover,
  .bk-nav a.active {
    background: rgba(184,84,42,0.07);
    color: var(--hdr-highlight);
  }

  /* Spacer */
  .bk-header-spacer { flex: 1; }

  /* Search */
  .bk-search-form {
    display: flex;
    align-items: center;
    background: var(--hdr-canvas);
    border: 1.5px solid var(--hdr-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 280px;
    flex-shrink: 0;
  }
  .bk-search-form:focus-within {
    border-color: var(--hdr-highlight);
    box-shadow: 0 0 0 3px rgba(184,84,42,0.08);
  }
  .bk-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--hdr-fg);
    padding: 9px 14px;
    outline: none;
  }
  .bk-search-input::placeholder { color: var(--hdr-muted); }
  .bk-search-btn {
    background: none;
    border: none;
    padding: 9px 12px;
    color: var(--hdr-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: color 0.2s;
    font-size: 0.85rem;
  }
  .bk-search-btn:hover { color: var(--hdr-highlight); }

  /* Icon actions */
  .bk-header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .bk-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: var(--hdr-muted);
    text-decoration: none;
    border: none;
    background: none;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    font-size: 1rem;
  }
  .bk-icon-btn:hover {
    background: rgba(184,84,42,0.08);
    color: var(--hdr-highlight);
  }
  .bk-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 17px;
    height: 17px;
    background: var(--hdr-highlight);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
    border: 1.5px solid var(--hdr-bg);
    transform-origin: center center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  @keyframes bkBadgePop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.45); }
    75%  { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .bk-badge-pop {
    animation: bkBadgePop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards !important;
  }

  /* User dropdown */
  .bk-user-menu {
    position: relative;
  }
  .bk-user-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.18s;
    border: none;
    background: none;
    color: var(--hdr-fg);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .bk-user-trigger:hover { background: rgba(184,84,42,0.08); }
  .bk-user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--hdr-fg);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
    font-family: 'Libre Baskerville', serif;
  }
  .bk-user-caret { font-size: 0.6rem; color: var(--hdr-muted); transition: transform 0.2s; }
  .bk-user-menu:hover .bk-user-caret { transform: rotate(180deg); }

  .bk-user-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: var(--hdr-bg);
    border: 1px solid var(--hdr-border);
    border-radius: 12px;
    min-width: 180px;
    box-shadow: 0 8px 32px rgba(45,40,32,0.12);
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.18s, transform 0.18s;
  }
  .bk-user-menu:hover .bk-user-dropdown,
  .bk-user-menu:focus-within .bk-user-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .bk-user-dropdown-header {
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--hdr-border);
  }
  .bk-user-dropdown-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--hdr-fg);
  }
  .bk-user-dropdown-sub {
    font-size: 0.71rem;
    color: var(--hdr-muted);
    margin-top: 2px;
  }
  .bk-user-dropdown a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.84rem;
    color: var(--hdr-fg);
    text-decoration: none;
    transition: background 0.15s;
  }
  .bk-user-dropdown a:hover { background: var(--hdr-canvas); }
  .bk-user-dropdown a i {
    width: 16px;
    font-size: 0.82rem;
    color: var(--hdr-muted);
    text-align: center;
  }
  .bk-user-dropdown a.bk-logout {
    color: #b91c1c;
    border-top: 1px solid var(--hdr-border);
    margin-top: 4px;
  }
  .bk-user-dropdown a.bk-logout i { color: #b91c1c; }
  .bk-user-dropdown a.bk-logout:hover { background: rgba(185,28,28,0.05); }

  /* Login link */
  .bk-login-link {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    background: var(--hdr-fg);
    color: #fff !important;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.83rem;
    font-weight: 600;
    border-radius: 7px;
    text-decoration: none;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .bk-login-link:hover { background: var(--hdr-highlight); }

  /* Hamburger */
  .bk-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: none;
    border: 1.5px solid var(--hdr-border);
    cursor: pointer;
    padding: 8px;
    transition: border-color 0.2s;
  }
  .bk-burger:hover { border-color: var(--hdr-highlight); }
  .bk-burger span {
    display: block;
    height: 1.5px;
    background: var(--hdr-fg);
    border-radius: 2px;
    transition: all 0.25s;
  }

  /* Mobile drawer */
  .bk-drawer {
    position: fixed;
    inset: 0;
    z-index: 99998;
    pointer-events: none;
  }
  .bk-drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(45,40,32,0.35);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .bk-drawer-panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    background: var(--hdr-bg);
    border-right: 1px solid var(--hdr-border);
    box-shadow: 8px 0 32px rgba(45,40,32,0.12);
    transform: translateX(-100%);
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .bk-drawer.open { pointer-events: auto; }
  .bk-drawer.open .bk-drawer-overlay { opacity: 1; }
  .bk-drawer.open .bk-drawer-panel { transform: translateX(0); }

  .bk-drawer-top {
    padding: 20px 20px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hdr-border);
  }
  .bk-drawer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .bk-drawer-logo img { height: 26px; }
  .bk-drawer-logo span {
    font-family: 'Libre Baskerville', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--hdr-fg);
  }
  .bk-drawer-close {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--hdr-border);
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hdr-muted);
    font-size: 0.8rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .bk-drawer-close:hover { border-color: var(--hdr-fg); color: var(--hdr-fg); }

  .bk-drawer-search {
    margin: 14px 16px;
    display: flex;
    align-items: center;
    background: var(--hdr-canvas);
    border: 1.5px solid var(--hdr-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .bk-drawer-search:focus-within { border-color: var(--hdr-highlight); }
  .bk-drawer-search input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 9px 12px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--hdr-fg);
    outline: none;
  }
  .bk-drawer-search button {
    background: none;
    border: none;
    padding: 9px 11px;
    color: var(--hdr-muted);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .bk-drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 8px 8px;
  }
  .bk-drawer-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 12px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--hdr-fg);
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
  }
  .bk-drawer-nav a:hover { background: rgba(184,84,42,0.07); color: var(--hdr-highlight); }
  .bk-drawer-nav a i { width: 18px; text-align: center; color: var(--hdr-muted); font-size: 0.9rem; }
  .bk-drawer-nav a:hover i { color: var(--hdr-highlight); }
  .bk-drawer-divider {
    height: 1px;
    background: var(--hdr-border);
    margin: 8px 12px;
  }

  .bk-drawer-foot {
    padding: 16px;
    border-top: 1px solid var(--hdr-border);
  }
  .bk-drawer-foot a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 11px;
    background: var(--hdr-fg);
    color: #fff;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .bk-drawer-foot a:hover { background: var(--hdr-highlight); }

  /* Responsive */
  @media (max-width: 1080px) {
    .bk-nav { display: none; }
    .bk-search-form { width: 220px; }
  }
  @media (max-width: 768px) {
    .bk-announce-left { display: none; }
    .bk-announce-inner { justify-content: center; padding: 0 20px; }
    .bk-header-inner { padding: 0 20px; gap: 10px; }
    .bk-search-form { display: none; }
    .bk-burger { display: flex; }
    .bk-announce { display: none; }
  }
</style>



<!-- Main header -->
<header class="bk-header" id="bk-site-header">
  <div class="bk-header-inner">

    <!-- Logo -->
    <a href="/home" class="bk-logo">
      <img src="/public/main-logo (1).png" alt="BOOKSAW">
    </a>

    <!-- Desktop nav -->
    <nav class="bk-nav">
      <a href="/home">Home</a>
      <a href="/loadShop">Shop</a>
      <a href="/loadProfile">Profile</a>
    </nav>

    <div class="bk-header-spacer"></div>

    <!-- Search -->
    <form action="/loadShop" class="bk-search-form">
      <input
        type="text"
        name="query"
        class="bk-search-input"
        placeholder="Search books, authors..."
        value="<% if(locals.search){ %><%= search %><% } %>"
        autocomplete="off"
        id="hdr-search-input"
      >
      <button type="submit" class="bk-search-btn" aria-label="Search">
        <i class="fas fa-search"></i>
      </button>
    </form>

    <!-- Icon actions -->
    <div class="bk-header-actions">

      <!-- Wishlist -->
      <a href="/getWishlist" class="bk-icon-btn" title="Wishlist" id="wishlist-icon-btn">
        <i class="fas fa-heart"></i>
        <span class="bk-badge" id="wishlist-count">
          <%= locals.wishlistLength ? wishlistLength : 0 %>
        </span>
      </a>

      <!-- Cart -->
      <button type="button" class="bk-icon-btn" title="Cart" onclick="checkCartAuth(event)" id="cart-icon-btn">
        <i class="fas fa-shopping-bag"></i>
        <span class="bk-badge" id="cart-count">
          <%= locals.cartLength ? cartLength : 0 %>
        </span>
      </button>

      <!-- User -->
      <% if(locals.name){ %>
        <div class="bk-user-menu" tabindex="0">
          <button class="bk-user-trigger" id="bk-user-trigger">
            <div class="bk-user-avatar"><%= name.charAt(0).toUpperCase() %></div>
            <span class="d-none d-lg-inline"><%= name.split(' ')[0] %></span>
            <i class="fas fa-chevron-down bk-user-caret"></i>
          </button>
          <div class="bk-user-dropdown">
            <div class="bk-user-dropdown-header">
              <div class="bk-user-dropdown-name"><%= name %></div>
              <div class="bk-user-dropdown-sub">My account</div>
            </div>
            <a href="/loadProfile"><i class="fas fa-user"></i> Profile</a>
            <a href="/loadProfile#orders"><i class="fas fa-box"></i> My Orders</a>
            <a href="/getWishlist"><i class="fas fa-heart"></i> Wishlist</a>
            <a href="/logout" class="bk-logout"><i class="fas fa-arrow-right-from-bracket"></i> Sign out</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="bk-login-link" id="hdr-login-btn">
          <i class="fas fa-arrow-right-to-bracket"></i> Sign In
        </a>
      <% } %>

      <!-- Hamburger (mobile) -->
      <button class="bk-burger" id="bk-burger" aria-label="Menu" onclick="openDrawer()">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>
  </div>
</header>

<!-- Mobile drawer -->
