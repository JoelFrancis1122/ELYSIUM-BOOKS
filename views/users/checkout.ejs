<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Checkout — BOOKSAW</title>
  <meta name="description" content="Complete your BOOKSAW order securely.">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/assets/css/maind134.css?v=3.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<style>
:root{--canvas:#f5f0e8;--bg:#faf8f4;--fg:#2d2820;--hi:#b8542a;--muted:#7a6f60;--border:#ddd8ce;--sec:#edeae2;--r-sm:8px;--r-md:14px;--r-lg:20px;--green:#16a34a;--red:#b91c1c}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'IBM Plex Sans',sans-serif;background:var(--canvas);color:var(--fg)}

/* BREADCRUMB */
.bk-crumb{background:var(--bg);border-bottom:1px solid var(--border);padding:14px 0}
.bk-crumb-inner{max-width:1200px;margin:0 auto;padding:0 40px;display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--muted)}
.bk-crumb-inner a{color:var(--muted);text-decoration:none;transition:color .2s}.bk-crumb-inner a:hover{color:var(--hi)}
.bk-crumb-sep{font-size:.65rem;color:var(--border)}.bk-crumb-cur{color:var(--fg);font-weight:600}

/* STEPS BAR */
.bk-steps{background:var(--bg);border-bottom:1px solid var(--border);padding:0 40px}
.bk-steps-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center}
.bk-step{display:flex;align-items:center;gap:7px;padding:14px 20px;font-size:.78rem;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;transition:all .2s;text-decoration:none}
.bk-step.done{color:var(--green);border-color:var(--green)}
.bk-step.active{color:var(--hi);border-color:var(--hi)}
.bk-step i{font-size:.72rem}
.bk-step-sep{color:var(--border);font-size:.65rem;margin:0 4px}

/* LAYOUT */
.bk-checkout{max-width:1200px;margin:0 auto;padding:36px 40px 80px;display:grid;grid-template-columns:1fr 380px;gap:28px;align-items:start}

/* SECTION CARD */
.bk-section{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;margin-bottom:20px}
.bk-section:last-child{margin-bottom:0}
.bk-section-head{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px}
.bk-section-title{font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg);display:flex;align-items:center;gap:9px}
.bk-section-title i{color:var(--hi);font-size:.85rem}
.bk-section-body{padding:22px}

/* ADDRESS CARDS */
.bk-addr-list{display:flex;flex-direction:column;gap:12px}
.bk-addr-card{border:1.5px solid var(--border);border-radius:var(--r-md);padding:16px 18px;cursor:pointer;transition:border-color .2s,box-shadow .2s;position:relative}
.bk-addr-card:hover{border-color:var(--hi);box-shadow:0 3px 12px rgba(184,84,42,.08)}
.bk-addr-card.selected{border-color:var(--hi);background:rgba(184,84,42,.03)}
.bk-addr-card input[type=radio]{position:absolute;top:16px;right:16px;accent-color:var(--hi);width:16px;height:16px;cursor:pointer}
.bk-addr-num{font-size:.65rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--hi);margin-bottom:5px}
.bk-addr-name{font-family:'Libre Baskerville',serif;font-size:.88rem;font-weight:700;color:var(--fg);margin-bottom:3px}
.bk-addr-phone{font-size:.78rem;color:var(--muted);margin-bottom:7px;display:flex;align-items:center;gap:5px}
.bk-addr-text{font-size:.81rem;color:var(--fg);line-height:1.65}
.bk-addr-actions{display:flex;gap:8px;margin-top:12px;padding-top:11px;border-top:1px solid var(--border)}

/* ORDER ITEMS */
.bk-item-row{display:grid;grid-template-columns:60px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--border)}
.bk-item-row:last-child{border-bottom:none}
.bk-item-img{width:60px;height:86px;border-radius:6px;object-fit:cover;box-shadow:2px 3px 10px rgba(45,40,32,.12)}
.bk-item-name{font-family:'Libre Baskerville',serif;font-size:.83rem;font-weight:700;color:var(--fg);margin-bottom:4px;line-height:1.4}
.bk-item-unit{font-size:.77rem;color:var(--muted)}
.bk-item-subtotal{font-family:'Libre Baskerville',serif;font-size:.9rem;font-weight:700;color:var(--fg);text-align:right;white-space:nowrap}
.bk-item-del{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:none;background:none;cursor:pointer;color:var(--muted);font-size:.78rem;transition:background .18s,color .18s;margin-top:6px}
.bk-item-del:hover{background:rgba(185,28,28,.07);color:var(--red)}

/* QTY */
.bk-qty{display:inline-flex;align-items:center;border:1.5px solid var(--border);border-radius:var(--r-sm);overflow:hidden;background:var(--canvas)}
.bk-qty-btn{width:28px;height:28px;border:none;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--fg);font-size:.7rem;transition:background .18s}
.bk-qty-btn:hover{background:var(--fg);color:#fff}
.bk-qty-val{min-width:28px;text-align:center;font-size:.83rem;font-weight:700;color:var(--fg);border-left:1px solid var(--border);border-right:1px solid var(--border);line-height:28px;padding:0 4px}

/* PAYMENT OPTIONS */
.bk-pay-opts{display:flex;flex-direction:column;gap:10px}
.bk-pay-opt{border:1.5px solid var(--border);border-radius:var(--r-md);padding:14px 18px;cursor:pointer;transition:border-color .2s,background .2s;display:flex;align-items:center;gap:12px;position:relative}
.bk-pay-opt:hover{border-color:var(--hi);background:rgba(184,84,42,.03)}
.bk-pay-opt.selected{border-color:var(--hi);background:rgba(184,84,42,.04)}
.bk-pay-opt input[type=radio]{accent-color:var(--hi);width:15px;height:15px;flex-shrink:0;cursor:pointer}
.bk-pay-opt-label{font-size:.85rem;font-weight:600;color:var(--fg);flex:1}
.bk-pay-opt-badge{font-size:.68rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:2px 8px;border-radius:999px;background:rgba(22,163,74,.1);color:#16a34a}
.bk-pay-opt-icon{font-size:.95rem;color:var(--muted)}
.bk-cod-note{font-size:.76rem;color:var(--red);margin-top:6px;display:none;align-items:center;gap:5px;padding:7px 12px;background:rgba(185,28,28,.06);border-radius:var(--r-sm)}

/* COUPON */
.bk-coupon-row{display:flex;gap:10px;align-items:center}
.bk-coupon-row .bk-input{flex:1}
.bk-coupon-applied{background:rgba(22,163,74,.06);border:1px solid rgba(22,163,74,.2);border-radius:var(--r-md);padding:14px 16px;margin-top:14px;display:none}
.bk-coupon-applied-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.bk-coupon-applied-name{font-size:.82rem;font-weight:700;color:var(--green)}
.bk-coupon-row-item{display:flex;justify-content:space-between;font-size:.8rem;padding:3px 0;color:var(--muted)}
.bk-coupon-row-item strong{color:var(--fg)}
.bk-coupon-row-item.discount strong{color:var(--green)}

/* FORM */
.bk-field-group{margin-bottom:14px}
.bk-label{display:block;font-size:.73rem;font-weight:600;letter-spacing:.4px;color:var(--muted);margin-bottom:5px;text-transform:uppercase}
.bk-input{width:100%;background:var(--canvas);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 13px;font-family:'IBM Plex Sans',sans-serif;font-size:.85rem;color:var(--fg);outline:none;transition:border-color .2s,box-shadow .2s}
.bk-input:focus{border-color:var(--hi);box-shadow:0 0 0 3px rgba(184,84,42,.07)}
.bk-input::placeholder{color:var(--muted)}

/* BUTTONS */
.bk-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;font-family:'IBM Plex Sans',sans-serif;font-size:.84rem;font-weight:600;border-radius:var(--r-sm);text-decoration:none;cursor:pointer;transition:all .18s;border:1.5px solid transparent;white-space:nowrap}
.bk-btn-dark{background:var(--fg);color:#fff;border-color:var(--fg)}.bk-btn-dark:hover{background:var(--hi);border-color:var(--hi)}
.bk-btn-outline{background:none;color:var(--fg);border-color:var(--border)}.bk-btn-outline:hover{border-color:var(--hi);color:var(--hi)}
.bk-btn-ghost{background:none;border:none;cursor:pointer;color:var(--red);font-size:.78rem;display:flex;align-items:center;gap:5px;padding:3px 8px;border-radius:var(--r-sm);font-family:'IBM Plex Sans',sans-serif}.bk-btn-ghost:hover{background:rgba(185,28,28,.07)}
.bk-btn-full{width:100%;justify-content:center;padding:13px 20px;font-size:.9rem}

/* ORDER SUMMARY PANEL */
.bk-summary{background:var(--bg);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;position:sticky;top:88px}
.bk-summary-head{padding:18px 22px;border-bottom:1px solid var(--border);font-family:'Libre Baskerville',serif;font-size:.95rem;font-weight:700;color:var(--fg);display:flex;align-items:center;gap:9px}
.bk-summary-head i{color:var(--hi);font-size:.85rem}
.bk-summary-body{padding:4px 0}
.bk-sum-row{display:flex;align-items:center;justify-content:space-between;padding:10px 22px;font-size:.83rem;border-bottom:1px solid var(--border)}
.bk-sum-row:last-of-type{border-bottom:none}
.bk-sum-label{color:var(--muted)}.bk-sum-val{font-weight:600;color:var(--fg)}
.bk-sum-total{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;background:var(--fg);color:#fff}
.bk-sum-total-label{font-size:.85rem;font-weight:600;opacity:.65}
.bk-sum-total-val{font-family:'Libre Baskerville',serif;font-size:1.3rem;font-weight:700}
.bk-summary-cta{padding:16px 22px;display:flex;flex-direction:column;gap:10px}
.bk-secure-note{font-size:.74rem;color:var(--muted);display:flex;align-items:center;gap:5px;justify-content:center}

/* TRUST STRIP */
.bk-trust{display:flex;gap:14px;padding:0 22px 16px;flex-wrap:wrap}
.bk-trust-item{display:flex;align-items:center;gap:6px;font-size:.74rem;color:var(--muted)}
.bk-trust-item i{color:var(--hi);font-size:.78rem}

/* EMPTY */
.bk-empty{text-align:center;padding:48px 20px}
.bk-empty-icon{font-size:2.8rem;opacity:.2;margin-bottom:12px}
.bk-empty-title{font-family:'Libre Baskerville',serif;font-size:1rem;color:var(--fg);margin-bottom:5px}
.bk-empty-sub{font-size:.82rem;color:var(--muted);margin-bottom:18px}

/* RESPONSIVE */
@media(max-width:940px){
  .bk-checkout{grid-template-columns:1fr;padding:22px 20px 60px}
  .bk-summary{position:static}
}
@media(max-width:520px){
  .bk-crumb-inner,.bk-steps{padding:0 16px}
  .bk-step{padding:12px 10px;font-size:.72rem}
}
</style>
</head>
<body>
<%- include('../partials/userHeader') %>

<!-- Breadcrumb -->
<div class="bk-crumb">
  <div class="bk-crumb-inner">
    <a href="/home">Home</a>
    <span class="bk-crumb-sep"><i class="fas fa-chevron-right"></i></span>
    <a href="/loadCart">Cart</a>
    <span class="bk-crumb-sep"><i class="fas fa-chevron-right"></i></span>
    <span class="bk-crumb-cur">Checkout</span>
  </div>
</div>

<!-- Steps -->
<div class="bk-steps">
  <div class="bk-steps-inner">
    <a href="/loadCart" class="bk-step done"><i class="fas fa-check-circle"></i> Cart</a>
    <i class="fas fa-chevron-right bk-step-sep"></i>
    <span class="bk-step active"><i class="fas fa-credit-card"></i> Checkout</span>
    <i class="fas fa-chevron-right bk-step-sep"></i>
    <span class="bk-step"><i class="fas fa-box-open"></i> Confirmation</span>
  </div>
</div>

<div class="bk-checkout">

  <!-- ── LEFT: Address + Payment ── -->
  <div class="bk-left">

    <!-- DELIVERY ADDRESS -->
    <div class="bk-section">
      <div class="bk-section-head">
        <div class="bk-section-title"><i class="fas fa-map-pin"></i> Delivery Address</div>
        <% if (typeof addresses !== 'undefined' && addresses && addresses.length < 2) { %>
          <a href="/loadAddAddress" class="bk-btn bk-btn-outline" style="padding:6px 14px;font-size:.78rem"><i class="fas fa-plus"></i> Add New</a>
        <% } %>
      </div>
      <div class="bk-section-body">
        <form action="/selectAddress" method="post" id="addressForm">
          <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) { %>
            <div class="bk-addr-list">
              <% addresses.forEach((address, index) => { %>
                <div class="bk-addr-card <%= addresses.length === 1 ? 'selected' : '' %>" id="addr-card-<%= address._id %>" onclick="selectAddr('<%= address._id %>')">
                  <input type="radio" name="selectedAddress" id="address_radio_<%= address._id %>" value="<%= address._id %>" <%= addresses.length === 1 ? 'checked' : '' %> style="position:absolute;top:16px;right:16px">
                  <div class="bk-addr-num">Address <%= index + 1 %></div>
                  <div class="bk-addr-name"><%= address.name %></div>
                  <div class="bk-addr-phone"><i class="fas fa-phone-alt" style="font-size:.7rem"></i> <%= address.mobile %></div>
                  <div class="bk-addr-text"><%= address.houseName %><br><%= address.city %>, <%= address.state %><br><strong>PIN <%= address.pinCode %></strong></div>
                  <div class="bk-addr-actions">
                    <a href="/loadEditAddress?id=<%= address._id %>" class="bk-btn bk-btn-outline" style="padding:5px 12px;font-size:.76rem"><i class="fas fa-edit"></i> Edit</a>
                    <button type="button" class="bk-btn-ghost" onclick="event.stopPropagation();removeAddress('<%= address._id %>')"><i class="fas fa-trash"></i> Remove</button>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="bk-empty">
              <div class="bk-empty-icon"><i class="fas fa-map-marker-alt"></i></div>
              <div class="bk-empty-title">No delivery address</div>
              <p class="bk-empty-sub">Add an address to proceed with checkout.</p>
              <a href="/loadAddAddress" class="bk-btn bk-btn-dark"><i class="fas fa-plus"></i> Add Address</a>
            </div>
          <% } %>
        </form>
      </div>
    </div>

    <!-- COUPON -->
    <div class="bk-section">
      <div class="bk-section-head">
        <div class="bk-section-title"><i class="fas fa-tags"></i> Coupon Code</div>
      </div>
      <div class="bk-section-body">
        <div class="bk-coupon-row">
          <input type="text" class="bk-input" id="couponCode" placeholder="Enter coupon code…" style="text-transform:uppercase">
          <button class="bk-btn bk-btn-dark" id="applyCouponBtn" onclick="applyCoupon()"><i class="fas fa-check"></i> Apply</button>
        </div>
        <div class="bk-coupon-applied" id="couponAppliedBox">
          <div class="bk-coupon-applied-head">
            <span class="bk-coupon-applied-name" id="couponAppliedName"></span>
            <button class="bk-btn-ghost" id="removeCouponBtn"><i class="fas fa-times"></i> Remove</button>
          </div>
          <div class="bk-coupon-row-item"><span>Subtotal</span><strong id="couponOrigTotal"></strong></div>
          <div class="bk-coupon-row-item discount"><span>Discount</span><strong id="couponSaving"></strong></div>
          <div class="bk-coupon-row-item"><span>New Total</span><strong id="couponNewTotal"></strong></div>
        </div>
        <div id="couponNamePlaceholder"></div>
      </div>
    </div>

    <!-- PAYMENT -->
    <div class="bk-section">
      <div class="bk-section-head">
        <div class="bk-section-title"><i class="fas fa-lock"></i> Payment Method</div>
      </div>
      <div class="bk-section-body">
        <div class="bk-pay-opts">
          <label class="bk-pay-opt" for="pay-razorpay" onclick="selectPay(this)">
            <input type="radio" name="payment_option" value="Razorpay" id="pay-razorpay">
            <i class="fas fa-bolt bk-pay-opt-icon" style="color:#3395ff"></i>
            <span class="bk-pay-opt-label">Razorpay<br><small style="font-weight:400;color:var(--muted)">Cards, UPI, Net Banking</small></span>
            <span class="bk-pay-opt-badge">Instant</span>
          </label>
          <label class="bk-pay-opt" for="pay-wallet" onclick="selectPay(this)">
            <input type="radio" name="payment_option" value="Wallet" id="pay-wallet">
            <i class="fas fa-wallet bk-pay-opt-icon" style="color:var(--hi)"></i>
            <span class="bk-pay-opt-label">BOOKSAW Wallet<br><small style="font-weight:400;color:var(--muted)">Use your wallet balance</small></span>
          </label>
          <label class="bk-pay-opt" for="pay-cod" onclick="selectPay(this)">
            <input type="radio" name="payment_option" value="Cash on delivery" id="pay-cod" id="exampleRadios5">
            <i class="fas fa-money-bill-wave bk-pay-opt-icon" style="color:var(--green)"></i>
            <span class="bk-pay-opt-label">Cash on Delivery<br><small style="font-weight:400;color:var(--muted)">Pay when your order arrives</small></span>
          </label>
        </div>
        <div class="bk-cod-note" id="codMessage"><i class="fas fa-info-circle"></i> COD is not available for orders above ₹1000.</div>
      </div>
    </div>
  </div>

  <!-- ── RIGHT: Order Summary ── -->
  <div class="bk-summary">
    <div class="bk-summary-head"><i class="fas fa-receipt"></i> Order Summary</div>
    <div class="bk-summary-body">
      <% if (locals.cartData && cartData.product && cartData.product.length > 0) { %>
        <% let total = 0; %>
        <div style="padding:16px 22px">
          <% for (let i = 0; i < cartData.product.length; i++) { %>
            <% const prod = cartData.product[i]; %>
            <div class="bk-item-row" id="cartItem-<%= prod.productId._id %>">
              <img class="bk-item-img" src="/public/uploads/<%= prod.productId.Images[0] %>" alt="<%= prod.productId.Bookname %>">
              <div>
                <div class="bk-item-name"><%= prod.productId.Bookname %></div>
                <div class="bk-item-unit">&#8377;<%= prod.productId.saleprice %> each</div>
                <div class="bk-qty" style="margin-top:8px">
                  <button type="button" class="bk-qty-btn" onclick="decrease('<%= prod.productId._id %>')"><i class="fas fa-minus" style="font-size:.65rem"></i></button>
                  <span class="bk-qty-val" id="quantity_<%= prod.productId._id %>"><%= prod.quantity %></span>
                  <button type="button" class="bk-qty-btn" onclick="increase('<%= prod.productId._id %>')"><i class="fas fa-plus" style="font-size:.65rem"></i></button>
                </div>
                <span id="saleprice_<%= prod.productId._id %>" style="display:none"><%= prod.productId.saleprice.toFixed(2) %></span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
                <span class="bk-item-subtotal" id="subtotal_<%= prod.productId._id %>">&#8377;<%= (prod.productId.saleprice * prod.quantity).toFixed(2) %></span>
                <button type="button" class="bk-item-del" onclick="deleteProduct('<%= prod.productId._id %>')" title="Remove"><i class="fas fa-trash"></i></button>
              </div>
            </div>
            <% total += prod.productId.saleprice * prod.quantity; %>
          <% } %>
        </div>
      <% } else if (locals.product) { %>
        <div style="padding:16px 22px">
          <div class="bk-item-row" id="cartItem-<%= product._id %>">
            <img class="bk-item-img" src="/public/uploads/<%= product.Images && product.Images[0] ? product.Images[0] : '' %>" alt="<%= product.Bookname %>">
            <div>
              <div class="bk-item-name"><%= product.Bookname %></div>
              <div class="bk-item-unit">&#8377;<%= product.saleprice %> each</div>
              <div class="bk-qty" style="margin-top:8px">
                <span class="bk-qty-val">1</span>
              </div>
              <span id="saleprice_<%= product._id %>" style="display:none"><%= product.saleprice.toFixed(2) %></span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
              <span class="bk-item-subtotal" id="subtotal_<%= product._id %>">&#8377;<%= product.saleprice.toFixed(2) %></span>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="bk-empty" style="padding:36px 20px">
          <div class="bk-empty-icon"><i class="fas fa-basket-shopping"></i></div>
          <div class="bk-empty-title">Cart is empty</div>
          <p class="bk-empty-sub">Add books before checking out.</p>
          <a href="/loadShop" class="bk-btn bk-btn-dark"><i class="fas fa-compass"></i> Shop</a>
        </div>
      <% } %>
    </div>

    <% 
      let checkoutTotal = 0;
      if (locals.cartData && cartData.product && cartData.product.length > 0) {
        cartData.product.forEach(p => { checkoutTotal += p.productId.saleprice * p.quantity; });
      } else if (locals.product) {
        checkoutTotal = product.saleprice;
      }
    %>
    <!-- Totals -->
    <div style="padding:0 22px 14px;border-top:1px solid var(--border)">
      <div class="bk-sum-row"><span class="bk-sum-label">Subtotal</span><span class="bk-sum-val" id="summarySubtotal">&#8377;<%= checkoutTotal.toFixed(2) %></span></div>
      <div class="bk-sum-row"><span class="bk-sum-label">Shipping</span><span class="bk-sum-val" style="color:var(--green)">Free</span></div>
      <div class="bk-sum-row" id="discountRow" style="display:none"><span class="bk-sum-label">Coupon discount</span><span class="bk-sum-val" style="color:var(--green)" id="discountVal"></span></div>
    </div>
    <div class="bk-sum-total">
      <span class="bk-sum-total-label">Total</span>
      <span class="bk-sum-total-val" id="GrandTotal">&#8377;<%= checkoutTotal.toFixed(2) %></span>
    </div>
    <div class="bk-summary-cta">
      <button onclick="placeOrder()" id="placeOrderBtn" class="bk-btn bk-btn-dark bk-btn-full">
        <i class="fas fa-lock"></i> Place Order
      </button>
      <a href="/loadCart" class="bk-btn bk-btn-outline bk-btn-full"><i class="fas fa-arrow-left"></i> Back to Cart</a>
      <p class="bk-secure-note"><i class="fas fa-shield-halved"></i> Secure &amp; encrypted checkout</p>
    </div>
    <div class="bk-trust">
      <div class="bk-trust-item"><i class="fas fa-rotate-left"></i> Easy Returns</div>
      <div class="bk-trust-item"><i class="fas fa-truck"></i> Free Shipping</div>
      <div class="bk-trust-item"><i class="fas fa-headset"></i> 24/7 Support</div>
    </div>
  </div>

</div><!-- /bk-checkout -->

<%- include('../partials/userFooter') %>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
/* ── HELPERS ── */
function parseRupee(s){ return parseFloat(String(s).replace(/[^0-9.]/g,''))||0; }
function fmtRupee(n){ return '\u20b9'+parseFloat(n).toFixed(2); }

function updateTotalPrice(){
  let total=0;
  document.querySelectorAll('[id^="subtotal_"]').forEach(el=>{ total+=parseRupee(el.textContent); });
  const gt=document.getElementById('GrandTotal');
  const ss=document.getElementById('summarySubtotal');
  if(gt) gt.textContent=fmtRupee(total);
  if(ss) ss.textContent=fmtRupee(total);
  checkCODAvailability();
}

/* ── ADDRESS SELECTION ── */
function selectAddr(id){
  document.querySelectorAll('.bk-addr-card').forEach(c=>c.classList.remove('selected'));
  const card=document.getElementById('addr-card-'+id);
  if(card) card.classList.add('selected');
  const radio=document.getElementById('address_radio_'+id);
  if(radio) radio.checked=true;
}

/* ── PAYMENT SELECTION ── */
function selectPay(label){
  document.querySelectorAll('.bk-pay-opt').forEach(l=>l.classList.remove('selected'));
  label.classList.add('selected');
}

/* ── QTY ── */
function increase(productId){
  const qEl=document.getElementById('quantity_'+productId);
  const cur=parseInt(qEl.textContent) || 1;
  fetch('/updateCart',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,quantity:1})})
  .then(async r=>{
    const data = await r.json().catch(()=>({}));
    if(r.ok && data.success !== false){
      const nextQty = data.newQuantity !== undefined ? data.newQuantity : cur+1;
      qEl.textContent=nextQty;
      const sp=parseRupee(document.getElementById('saleprice_'+productId).textContent);
      document.getElementById('subtotal_'+productId).textContent=fmtRupee(sp*nextQty);
      updateTotalPrice();
    } else {
      toastr.error(data.message || 'Failed to update quantity');
    }
  }).catch(e=>toastr.error('Error: '+e.message));
}
function decrease(productId){
  const qEl=document.getElementById('quantity_'+productId);
  const cur=parseInt(qEl.textContent) || 1;
  if(cur<=1){toastr.warning('Minimum quantity is 1.');return;}
  fetch('/updateCart',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,quantity:-1})})
  .then(async r=>{
    const data = await r.json().catch(()=>({}));
    if(r.ok && data.success !== false){
      const nextQty = data.newQuantity !== undefined ? data.newQuantity : cur-1;
      qEl.textContent=nextQty;
      const sp=parseRupee(document.getElementById('saleprice_'+productId).textContent);
      document.getElementById('subtotal_'+productId).textContent=fmtRupee(sp*nextQty);
      updateTotalPrice();
    } else {
      toastr.error(data.message || 'Failed to update quantity');
    }
  }).catch(e=>toastr.error('Error: '+e.message));
}

/* ── DELETE FROM CART ── */
async function deleteProduct(productId){
  try{
    const r=await fetch('/removeItem',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId})});
    const data=await r.json().catch(()=>({}));
    if(r.ok && data.success !== false){ const row=document.getElementById('cartItem-'+productId); if(row)row.remove(); updateTotalPrice(); toastr.success('Item removed.'); }
    else toastr.error(data.message || 'Failed to remove item.');
  }catch(e){toastr.error('Error: '+e.message);}
}

/* ── REMOVE ADDRESS ── */
function removeAddress(addressId){
  const el=document.getElementById('addr-card-'+addressId);
  if(el)el.remove();
  fetch('/removeAddress',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({addressId})})
  .catch(e=>console.error(e));
}

/* ── COD CHECK ── */
function checkCODAvailability(){
  const total=parseRupee(document.getElementById('GrandTotal').textContent);
  const codMsg=document.getElementById('codMessage');
  const codRadio=document.getElementById('pay-cod');
  if(total>=1000){
    if(codRadio)codRadio.disabled=true;
    if(codMsg)codMsg.style.display='flex';
  }else{
    if(codRadio)codRadio.disabled=false;
    if(codMsg)codMsg.style.display='none';
  }
}

/* ── COUPON ── */
let _couponCode='';
async function applyCoupon(){
  const couponCode=document.getElementById('couponCode').value.trim();
  if(!couponCode){toastr.warning('Enter a coupon code.');return;}
  const grandTotalEl=document.getElementById('GrandTotal');
  const selectedAmount=parseRupee(grandTotalEl.textContent);
  try{
    const r=await fetch('/applyCoupon',{method:'post',headers:{'Content-Type':'application/json'},body:JSON.stringify({couponCode,selectedAmount})});
    if(!r.ok)throw new Error('Failed.');
    const data=await r.json();
    if(data.used){toastr.error(data.message);return;}
    if(data.success){
      toastr.success(data.message);
      _couponCode=couponCode;
      const orig=selectedAmount;
      const saving=parseFloat(data.discountAmount) || 0;
      const newTotal=Math.max(0, orig - saving);
      grandTotalEl.textContent=fmtRupee(newTotal);
      document.getElementById('couponCode').readOnly=true;
      /* styled breakdown box */
      const discPct = data.discountPercent ? ' ('+data.discountPercent+'% off)' : '';
      document.getElementById('couponAppliedName').textContent=(data.couponName || couponCode)+discPct;
      document.getElementById('couponOrigTotal').textContent=fmtRupee(orig);
      document.getElementById('couponSaving').textContent='-'+fmtRupee(saving);
      document.getElementById('couponNewTotal').textContent=fmtRupee(newTotal);
      document.getElementById('couponAppliedBox').style.display='block';
      /* summary discount row */
      document.getElementById('discountVal').textContent='-'+fmtRupee(saving);
      document.getElementById('discountRow').style.display='flex';
    }else{toastr.error(data.message);}
  }catch(e){console.error(e);toastr.error('Error applying coupon.');}
}

document.addEventListener('DOMContentLoaded',()=>{
  const removeBtn=document.getElementById('removeCouponBtn');
  if(removeBtn)removeBtn.addEventListener('click', async ()=>{
    const code=_couponCode||document.getElementById('couponCode').value;
    try {
      await fetch('/removeCoupon',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({couponCode:code})});
    } catch(e){}
    location.reload();
  });
  checkCODAvailability();
});

/* ── PLACE ORDER ── */
function placeOrder(){
  const couponCode=_couponCode || '';
  const payRadio=document.querySelector('input[name="payment_option"]:checked');
  if(!payRadio){toastr.info('Please select a payment method.');return;}
  const addrRadio=document.querySelector('input[name="selectedAddress"]:checked');
  if(!addrRadio){toastr.info('Please select a delivery address.');return;}
  const payMethod=payRadio.value;
  const selectedAddress=addrRadio.value;
  const totalAmount=parseRupee(document.getElementById('GrandTotal').textContent);
  const orderData={paymentMethod:payMethod,paymentStatus:'Failed',amount:totalAmount,address:selectedAddress,couponCode};

  if(payMethod==='Razorpay'){
    let orderId='';
    fetch('/onlinepay',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(orderData)})
    .then(r=>r.json()).then(data=>{
      orderId=data.order.orderId;
      const opts={
        key:'rzp_test_bdVGrcCwlFiIwl',amount:data.order2.amount,currency:'INR',
        name:'BOOKSAW',description:'Book Purchase',image:'/public/spellbook.png',
        order_id:data.order2.id,
        handler:function(resp){
          if(resp.razorpay_payment_id){
            orderData.paymentStatus='Received';
            fetch('/saveOrder?id='+orderId,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({orderId})})
            .then(()=>{ Swal.fire({icon:'success',title:'Payment successful!',showConfirmButton:false,timer:2000}).then(()=>window.location.href='/orderSuccess'); })
            .catch(()=>Swal.fire({icon:'error',title:'Error saving order'}));
          }else{Swal.fire({icon:'error',title:'Payment failed!'});}
          clearCart();
        },
        prefill:{name:'Customer',email:'customer@booksaw.com',contact:'9999999999'},
        theme:{color:'#2d2820'}
      };
      new Razorpay(opts).open();
    }).catch(()=>Swal.fire({icon:'error',title:'Oops!',text:'Something went wrong.'}));
  } else {
    fetch('/placeorder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(orderData)})
    .then(r=>r.json()).then(data=>{
      if(data.message==='Insufficient wallet balance'){
        Swal.fire({icon:'error',title:'Oops!',text:'Insufficient wallet balance!'});
      }else{
        Swal.fire({icon:'success',title:'Order Placed!',showConfirmButton:false,timer:2000}).then(()=>window.location.href='/orderSuccess');
        clearCart();
      }
    }).catch(()=>Swal.fire({icon:'error',title:'Oops!',text:'Something went wrong.'}));
  }
}

function clearCart(){
  fetch('/clearCart',{method:'delete',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}).catch(e=>console.error(e));
}
</script>
</body>
</html>