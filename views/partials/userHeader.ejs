<style>
  /* ── CLEAN TOASTR NOTIFICATION ENGINE ──────────────────── */
  #bk-toast-container {
    position: fixed !important;
    top: 24px !important;
    right: 24px !important;
    z-index: 9999999 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    max-width: 380px !important;
    width: calc(100vw - 36px) !important;
    pointer-events: none !important;
  }
  .bk-toast {
    pointer-events: auto !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    background: #ffffff !important;
    color: #2d2820 !important;
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 0.88rem !important;
    font-weight: 500 !important;
    line-height: 1.4 !important;
    padding: 13px 16px !important;
    border-radius: 10px !important;
    border: 1px solid #e7e2d9 !important;
    box-shadow: 0 10px 28px -4px rgba(45, 40, 32, 0.16), 0 3px 8px -2px rgba(45, 40, 32, 0.06) !important;
    position: relative !important;
    overflow: hidden !important;
    cursor: pointer !important;
    user-select: none !important;
    animation: bkToastIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
    transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.22s ease, max-height 0.25s ease, margin 0.25s ease, padding 0.25s ease !important;
  }
  .bk-toast:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 14px 34px -4px rgba(45, 40, 32, 0.20), 0 4px 10px -2px rgba(45, 40, 32, 0.08) !important;
  }
  .bk-toast.bk-toast-hiding {
    opacity: 0 !important;
    transform: translateX(40px) scale(0.94) !important;
    max-height: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-bottom: -10px !important;
    border-color: transparent !important;
  }

  /* Status Left Accent Borders */
  .bk-toast-success { border-left: 4px solid #16a34a !important; }
  .bk-toast-error   { border-left: 4px solid #dc2626 !important; }
  .bk-toast-warning { border-left: 4px solid #d97706 !important; }
  .bk-toast-info    { border-left: 4px solid #2563eb !important; }

  /* Icon Badges */
  .bk-toast-icon {
    width: 32px !important;
    height: 32px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }
  .bk-toast-icon-success { background: #dcfce7 !important; color: #16a34a !important; }
  .bk-toast-icon-error   { background: #fee2e2 !important; color: #dc2626 !important; }
  .bk-toast-icon-warning { background: #fef3c7 !important; color: #d97706 !important; }
  .bk-toast-icon-info    { background: #dbeafe !important; color: #2563eb !important; }
  .bk-toast-icon svg {
    width: 17px !important;
    height: 17px !important;
    display: block !important;
  }

  /* Content */
  .bk-toast-content {
    flex: 1 !important;
    min-width: 0 !important;
  }
  .bk-toast-title {
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    color: #1a1612 !important;
    margin-bottom: 2px !important;
  }
  .bk-toast-msg {
    color: #2d2820 !important;
    font-size: 0.86rem !important;
    font-weight: 500 !important;
    line-height: 1.35 !important;
    word-break: break-word !important;
  }

  /* Close Button */
  .bk-toast-close {
    background: transparent !important;
    border: none !important;
    color: #9c9284 !important;
    font-size: 1.25rem !important;
    line-height: 1 !important;
    padding: 2px 6px !important;
    border-radius: 4px !important;
    cursor: pointer !important;
    margin-left: auto !important;
    flex-shrink: 0 !important;
    transition: color 0.15s ease, background-color 0.15s ease !important;
  }
  .bk-toast-close:hover {
    color: #2d2820 !important;
    background-color: #f5f0e8 !important;
  }

  /* Progress Bar */
  .bk-toast-bar {
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    height: 3px !important;
    width: 100% !important;
    transform-origin: left !important;
    animation: bkToastProgress linear forwards !important;
  }
  .bk-toast-success .bk-toast-bar { background: #16a34a !important; }
  .bk-toast-error   .bk-toast-bar { background: #dc2626 !important; }
  .bk-toast-warning .bk-toast-bar { background: #d97706 !important; }
  .bk-toast-info    .bk-toast-bar { background: #2563eb !important; }

  @keyframes bkToastIn {
    0% {
      opacity: 0;
      transform: translateX(36px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes bkToastProgress {
    0%   { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }

  /* Fallback reset for legacy jQuery toastr if invoked */
  #toast-container {
    top: 76px !important;
    right: 20px !important;
    z-index: 999999 !important;
  }
  #toast-container > div {
    opacity: 0.98 !important;
    border-radius: 8px !important;
    box-shadow: 0 8px 24px rgba(45,40,32,0.14) !important;
  }
</style>
<script>
  (function() {
    var ICONS = {
      success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
      error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
      warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
      info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
    };

    var activeToasts = [];

    function getContainer() {
      var c = document.getElementById('bk-toast-container');
      if (!c) {
        c = document.createElement('div');
        c.id = 'bk-toast-container';
        (document.body || document.documentElement).appendChild(c);
      }
      return c;
    }

    var cleanToastr = {
      options: {
        closeButton: true,
        progressBar: true,
        preventDuplicates: true,
        newestOnTop: true,
        timeOut: 2800,
        extendedTimeOut: 1000
      },
      show: function(type, message, title, opt) {
        if (!message) return null;
        var opts = Object.assign({}, this.options, opt);
        var container = getContainer();

        // Prevent duplicate messages on screen
        if (opts.preventDuplicates) {
          for (var i = 0; i < activeToasts.length; i++) {
            if (activeToasts[i].message === message) {
              return activeToasts[i].el;
            }
          }
        }

        // Clean duration: default 2800ms, minimum 2400ms so it never vanishes in a flash
        var duration = Math.max(2400, parseInt(opts.timeOut, 10) || 2800);

        var toast = document.createElement('div');
        toast.className = 'bk-toast bk-toast-' + type;

        var iconHtml = '<div class="bk-toast-icon bk-toast-icon-' + type + '">' + (ICONS[type] || ICONS.info) + '</div>';
        var titleHtml = title ? '<div class="bk-toast-title">' + title + '</div>' : '';
        var msgHtml = '<div class="bk-toast-msg">' + message + '</div>';
        var contentHtml = '<div class="bk-toast-content">' + titleHtml + msgHtml + '</div>';
        var closeHtml = opts.closeButton ? '<button type="button" class="bk-toast-close" aria-label="Close">&times;</button>' : '';
        var barHtml = opts.progressBar ? '<div class="bk-toast-bar" style="animation-duration:' + duration + 'ms;"></div>' : '';

        toast.innerHTML = iconHtml + contentHtml + closeHtml + barHtml;

        var item = {
          message: message,
          el: toast,
          timer: null,
          dismissed: false
        };

        function dismiss() {
          if (item.dismissed) return;
          item.dismissed = true;
          clearTimeout(item.timer);
          toast.classList.add('bk-toast-hiding');
          setTimeout(function() {
            if (toast.parentNode) toast.parentNode.removeChild(toast);
            activeToasts = activeToasts.filter(function(t) { return t !== item; });
          }, 240);
        }

        // Manual close button
        var closeBtn = toast.querySelector('.bk-toast-close');
        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            dismiss();
          });
        }

        // Tap/click toast to dismiss
        toast.addEventListener('click', function() {
          dismiss();
        });

        // Start auto-dismiss timer
        item.timer = setTimeout(dismiss, duration);

        // Hover pause
        toast.addEventListener('mouseenter', function() {
          clearTimeout(item.timer);
          var bar = toast.querySelector('.bk-toast-bar');
          if (bar) bar.style.animationPlayState = 'paused';
        });

        toast.addEventListener('mouseleave', function() {
          var bar = toast.querySelector('.bk-toast-bar');
          if (bar) bar.style.animationPlayState = 'running';
          item.timer = setTimeout(dismiss, opts.extendedTimeOut || 1000);
        });

        if (opts.newestOnTop && container.firstChild) {
          container.insertBefore(toast, container.firstChild);
        } else {
          container.appendChild(toast);
        }

        activeToasts.push(item);
        return toast;
      },
      success: function(m, t, o) { return this.show('success', m, t, o); },
      error: function(m, t, o) { return this.show('error', m, t, o); },
      warning: function(m, t, o) { return this.show('warning', m, t, o); },
      info: function(m, t, o) { return this.show('info', m, t, o); },
      clear: function() {
        activeToasts.forEach(function(t) {
          if (t.el && t.el.parentNode) t.el.parentNode.removeChild(t.el);
        });
        activeToasts = [];
      },
      remove: function() { this.clear(); }
    };

    // Protect window.toastr so later script tags cannot break or overwrite it
    try {
      Object.defineProperty(window, 'toastr', {
        get: function() { return cleanToastr; },
        set: function(val) {
          if (val && typeof val === 'object' && val.options) {
            Object.assign(cleanToastr.options, val.options);
          }
        },
        configurable: true
      });
    } catch (e) {
      window.toastr = cleanToastr;
    }
  })();
</script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
